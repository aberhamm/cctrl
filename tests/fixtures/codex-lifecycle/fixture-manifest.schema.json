{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cctrl.example/schemas/codex-lifecycle-fixture-manifest-v1.json",
  "title": "cctrl Codex lifecycle fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixtures"],
  "properties": {
    "schema_version": { "const": 1 },
    "fixtures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "cli_version",
          "app_version",
          "source",
          "capture_method",
          "observed_at",
          "scenario",
          "field_status",
          "sanitization",
          "refresh_rule"
        ],
        "properties": {
          "path": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "cli_version": { "type": "string", "minLength": 1 },
          "app_version": { "type": "string", "minLength": 1 },
          "source": {
            "enum": [
              "app-server",
              "hooks",
              "sqlite",
              "rollout",
              "cctrl-metadata",
              "writer-lock",
              "process-argv",
              "probe-protocol",
              "contract-matrix"
            ]
          },
          "capture_method": { "type": "string", "minLength": 1 },
          "observed_at": { "type": "string", "format": "date-time" },
          "scenario": { "type": "string", "minLength": 1 },
          "field_status": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "enum": ["observed", "derived", "unsupported"] }
          },
          "sanitization": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "pattern": "^<[A-Z0-9_]+>$" }
          },
          "refresh_rule": { "type": "string", "minLength": 1 },
          "cleanup": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
