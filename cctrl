_session_update_metadata_field() {
    # Legacy inputs retain their compatibility promotion path. Every schema-v2
    # update is expressed as an event so the lock covers read/reduce/write.
    local session_name="$1" field="$2" value="$3"
    local file version promoted stable_id record_key event_file event_id now sequence source_instance result
    file="$(_session_metadata_file "$session_name")"
    [[ -f "$file" ]] || return 1
    version="$(jq -r '.schema_version // empty' "$file" 2>/dev/null || true)"
    if [[ "$field" == "conversation_id" || "$field" == "provider_task_id" ]]; then
        stable_id="$value"
        if [[ "$file" == "$SESSION_METADATA_DIR"/task-*.json ]]; then
            local existing_id
            existing_id="$(jq -r '.provider_task_id // empty' "$file" 2>/dev/null || true)"
            [[ -z "$existing_id" || "$existing_id" == "$stable_id" ]] || return 1
        fi
    else
        stable_id="$(jq -r '.provider_task_id // .conversation_id // empty' "$file" 2>/dev/null || true)"
    fi
    if [[ "$version" != "$TASK_RECORD_SCHEMA_VERSION" || ( "$file" == "$SESSION_METADATA_DIR"/launch-*.json && -n "$stable_id" ) ]]; then
        promoted="$(_task_record_promote_legacy "$file" "$stable_id")" || return 1
        file="$promoted"
    fi
    record_key="${file##*/}"; record_key="${record_key%.json}"
    event_file="$(mktemp "$SESSION_METADATA_DIR/.task-event.XXXXXX")" || return 1
    event_id="$(openssl rand -hex 16 2>/dev/null || uuidgen 2>/dev/null | tr -d '-' | tr '[:upper:]' '[:lower:]')"
    now="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    source_instance="$session_name:$field"
    sequence="$(_task_registry_next_sequence "$file" "cctrl-metadata" "$source_instance")" || { rm -f "$event_file"; return 1; }
    jq -n --arg id "$event_id" --arg provider "$(jq -r '.provider' "$file")" \
        --arg task "$(jq -r '.provider_task_id' "$file")" --arg host "$(jq -r '.host_id' "$file")" \
        --arg instance "$source_instance" --arg observed "$now" --arg field "$field" --arg value "$value" --argjson sequence "$sequence" '
        {version:1,event_id:$id,event_type:"observe",provider:$provider,provider_task_id:$task,
         host_id:$host,source:"cctrl-metadata",source_instance_id:$instance,
         source_sequence:$sequence,source_cursor:null,expected_record_digest:null,observed_at:$observed,
         payload:{authority_class:"authoritative",set:{($field):(if $value == "" then null else $value end)}}}
    ' > "$event_file" || { rm -f "$event_file"; return 1; }
    result="$(_task_registry_apply_event "$record_key" "$event_file")" || { rm -f "$event_file"; return 1; }
    rm -f "$event_file"
    [[ "$(jq -r '.status' <<< "$result")" == "applied" ]]
}

_task_record_transition() {
    local session_name="$1" runtime="$2" owner="$3" state="$4" restore="$5" source="$6" authority="$7" reason="$8"
    local file stable_id promoted now record_key event_file event_id expected sequence result
    file="$(_session_metadata_file "$session_name")"
    [[ -f "$file" ]] || return 1
    stable_id="$(jq -r '.provider_task_id // .conversation_id // empty' "$file" 2>/dev/null || true)"
    if [[ "$(jq -r '.schema_version // empty' "$file" 2>/dev/null || true)" != "$TASK_RECORD_SCHEMA_VERSION" ]]; then
        [[ -n "$stable_id" ]] || return 1
        promoted="$(_task_record_promote_legacy "$file" "$stable_id")" || return 1
        file="$promoted"
    fi
    record_key="${file##*/}"; record_key="${record_key%.json}"
    event_file="$(mktemp "$SESSION_METADATA_DIR/.task-event.XXXXXX")" || return 1
    now="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    expected="$(_task_registry_record_digest "$file")" || { rm -f "$event_file"; return 1; }
    event_id="$(openssl rand -hex 16 2>/dev/null || uuidgen 2>/dev/null | tr -d '-' | tr '[:upper:]' '[:lower:]')"
    sequence="$(_task_registry_next_sequence "$file" "$source" "$session_name")" || { rm -f "$event_file"; return 1; }
    jq -n --arg id "$event_id" --arg provider "$(jq -r '.provider' "$file")" \
        --arg task "$(jq -r '.provider_task_id' "$file")" --arg host "$(jq -r '.host_id' "$file")" \
        --arg source "$source" --arg instance "$session_name" --arg observed "$now" \
        --arg expected "$expected" --arg runtime "$runtime" --arg owner "$owner" --arg state "$state" \
        --arg restore "$restore" --arg authority "$authority" --arg reason "$reason" --argjson sequence "$sequence" '
        {version:1,event_id:$id,event_type:"reconcile",provider:$provider,provider_task_id:$task,
         host_id:$host,source:$source,source_instance_id:$instance,source_sequence:$sequence,
         source_cursor:null,expected_record_digest:$expected,observed_at:$observed,
         payload:{authority_class:$authority,control_owner:$owner,execution_runtime:$runtime,
                  lifecycle_state:$state,restore_strategy:(if $restore == "" then null else $restore end),
                  reason:$reason,set:{control_surface:(if $runtime == "tmux" then "tmux" elif $runtime == "app-server" then "app" else "unknown" end)}}}
    ' > "$event_file" || { rm -f "$event_file"; return 1; }
    result="$(_task_registry_apply_event "$record_key" "$event_file")" || { rm -f "$event_file"; return 1; }
    rm -f "$event_file"
    [[ "$(jq -r '.status' <<< "$result")" == "applied" ]]
}

_session_repo_name() {
    local cwd="${1:-}"
    cwd="${cwd/#\~/$HOME}"
    if [[ -n "$cwd" ]]; then
        cwd="${cwd%/}"
        local shortcut
        shortcut="$(_shortcut_for_dir "$cwd" 2>/dev/null || true)"
        if [[ -n "$shortcut" ]]; then
            _session_pretty_repo_label "$shortcut"
        else
            _session_pretty_repo_label "${cwd##*/}"
        fi
    fi
}

_session_pretty_repo_label() {
    local slug="$1"
    case "$slug" in
        obsidian|obsidian-vault) printf '%s' 'Obsidian' ;;
        scraper|django-c|django-celery-scraper) printf '%s' 'Scraper' ;;
        comet|comet-automation) printf '%s' 'Comet' ;;
        homelab) printf '%s' 'Homelab' ;;
        rentkompass) printf '%s' 'Rentkompass' ;;
        agenthub|agent-hub) printf '%s' 'Agent Hub' ;;
        voice-assistant|voice-studio) printf '%s' 'Voice Assistant' ;;
        portal|unstructured-data-portal) printf '%s' 'Portal' ;;
        cctrl) printf '%s' 'cctrl' ;;
        *)
            printf '%s' "$slug" | awk -F- '{
                for (i = 1; i <= NF; i++) {
                    if ($i == "") continue
                    $i = toupper(substr($i, 1, 1)) substr($i, 2)
                }
                print $0
            }' OFS=" "
            ;;
    esac
}

_session_clean_purpose_label() {
    local purpose="${1:-}"
    purpose="${purpose//\[Codex restore\]/}"
    purpose="${purpose//\[codex restore\]/}"
    printf '%s' "$purpose" | awk '{$1=$1; print}'
}

_session_app_display_name() {
    local session_name="$1" purpose="${2:-}" cwd="${3:-}"
    local repo
    purpose="$(_session_clean_purpose_label "$purpose")"
    repo="$(_session_repo_name "$cwd")"
    if [[ -n "$repo" && -n "$purpose" && "$purpose" == "$repo: "* ]]; then
        printf '%s (%s)' "$purpose" "$session_name"
    elif [[ -n "$repo" && -n "$purpose" ]]; then
        printf '%s: %s (%s)' "$repo" "$purpose" "$session_name"
    elif [[ -n "$repo" ]]; then
        printf '%s (%s)' "$repo" "$session_name"
    elif [[ -n "$purpose" ]]; then
        printf '%s (%s)' "$purpose" "$session_name"
    else
        printf '%s' "$session_name"
    fi
}

_session_write_metadata() {
    local session_name="$1" cwd="$2" target_kind="$3" target="$4" display_label="$5" purpose="$6" initial_prompt="$7" launch_command="$8" peer="${9:-}" agent="${10:-}" conversation_id="${11:-}" transcript_path="${12:-}"
    mkdir -p "$SESSION_METADATA_DIR" || return 1
    local tmp created_at host_label host_id provider lifecycle_state provider_task_id launch_id output_file
    mkdir -p "$SESSION_METADATA_DIR" || return 1
    tmp="$(mktemp "$SESSION_METADATA_DIR/.task-write.XXXXXX")" || return 1
    created_at="$(date -u +"%Y-%m-%dT%H:%M:%SZ")"
    host_label="${CCTRL_HOST_PREFIX:-local}"
    # Persist the agent runtime so display/registry read it back rather than
    # re-sniffing the pane argv (see _agent_from_cmd). Normalize to the canonical
    # vocabulary; an unrecognized or empty value stores null so the reader falls
    # back to the sniff instead of shadowing it with a falsy-but-present string.
    if [[ -n "$agent" ]]; then
        agent="$(_normalize_agent "$agent" 2>/dev/null || printf '')"
    fi
    provider="${agent:-unknown}"
    host_id="$(_cctrl_host_id)" || { rm -f "$tmp"; return 1; }
    provider_task_id="$conversation_id"
    launch_id=""
    lifecycle_state="active"
    if [[ -n "$provider_task_id" ]]; then
        output_file="$(_task_record_file "$provider" "$host_id" "$provider_task_id")" || { rm -f "$tmp"; return 1; }
    else
        lifecycle_state="provisional"
        launch_id="$(uuidgen 2>/dev/null | tr '[:upper:]' '[:lower:]' || true)"
        [[ "$launch_id" =~ ^[0-9a-f-]{36}$ ]] || launch_id="$(openssl rand -hex 16 2>/dev/null || true)"
        [[ -n "$launch_id" ]] || { rm -f "$tmp"; return 1; }
        output_file="$SESSION_METADATA_DIR/launch-$launch_id.json"
    fi
    jq -n \
        --argjson schema_version "$TASK_RECORD_SCHEMA_VERSION" \
        --arg name "$session_name" \
        --arg created_at "$created_at" \
        --arg cwd "$cwd" \
        --arg target_kind "$target_kind" \
        --arg target "$target" \
        --arg display_label "$display_label" \
        --arg purpose "$purpose" \
        --arg initial_prompt "$initial_prompt" \
        --arg launch_command "$launch_command" \
        --arg peer "$peer" \
        --arg agent "$agent" \
        --arg host "$host_label" \
        --arg host_id "$host_id" \
        --arg provider "$provider" \
        --arg origin "cctrl" \
        --arg conversation_id "$conversation_id" \
        --arg transcript_path "$transcript_path" \
        --arg lifecycle_state "$lifecycle_state" \
        --arg launch_id "$launch_id" \
        '{
            schema_version: $schema_version,
            provider: $provider,
            provider_task_id: (if $conversation_id == "" then null else $conversation_id end),
            origin: $origin,
            host_id: $host_id,
            registered_by_cctrl: true,
            launched_by_cctrl: true,
            execution_runtime: "tmux",
            control_owner: "cctrl",
            lifecycle_state: $lifecycle_state,
            restore_strategy: "tmux",
            last_observed_at: $created_at,
            lineage: {
                forked_from_id: null,
                parent_thread_id: null,
                derived_root_id: null,
                derived_root_basis: null
            },
            ownership_evidence: [{
                source: "cctrl-launch",
                source_instance: $name,
                source_cursor: null,
                authority_class: "authoritative",
                observed_owner: "cctrl",
                observed_runtime: "tmux",
                observed_state: $lifecycle_state,
                observed_at: $created_at,
                reason: "cctrl launched the terminal writer"
            }],
            provisional_launch_id: (if $launch_id == "" then null else $launch_id end),
            name: $name,
            created_at: $created_at,
            cwd: $cwd,
            target_kind: $target_kind,
            target: $target,
            display_label: $display_label,
            purpose: (if $purpose == "" then null else $purpose end),
            initial_prompt: (if $initial_prompt == "" then null else $initial_prompt end),
            peer: (if $peer == "" then null else $peer end),
            agent: (if $agent == "" then null else $agent end),
            launch_command: $launch_command,
            host: $host,
            conversation_id: (if $conversation_id == "" then null else $conversation_id end),
            transcript_path: (if $transcript_path == "" then null else $transcript_path end),
            control_surface: "tmux",
            tmux_session: $name,
            pane_id: null,
            pane_pid: null,
            pane_started: null,
            wrapper_pid: null,
            cctrl_managed: true
        }' > "$tmp" || { rm -f "$tmp"; return 1; }
    _task_record_normalize_json "$tmp" >/dev/null 2>&1 || { rm -f "$tmp"; return 1; }
    if [[ -n "$provider_task_id" ]]; then
        # Canonical schema-v2 creation and merge both cross the registry event
        # boundary; provisional launch records remain identity-less staging.
        _task_record_promote_legacy "$tmp" "$provider_task_id" >/dev/null || { rm -f "$tmp"; return 1; }
    else
        mv "$tmp" "$output_file"
    fi
    _session_record_index_update "$session_name" "$output_file" 2>/dev/null || true
}

_prompt_tty_available() {
    { : < /dev/tty; } 2>/dev/null && { : > /dev/tty; } 2>/dev/null
}

_prompt_session_purpose() {
    local default_purpose="$1" answer
    case "${CCTRL_PURPOSE_PROMPT:-auto}" in
        never)
            printf '%s' "$default_purpose"
            return 0
            ;;
        always)
            ;;
        *)
            if ! _prompt_tty_available; then
                printf '%s' "$default_purpose"
                return 0
            fi
            ;;
    esac

    if ! _prompt_tty_available; then
        printf '%s' "$default_purpose"
        return 0
    fi

    if [[ -n "$default_purpose" ]]; then
        printf 'Session purpose? [%s]\n> ' "$default_purpose" > /dev/tty
    else
        printf 'Session purpose? [optional]\n> ' > /dev/tty
    fi
    IFS= read -r answer < /dev/tty || answer=""
    printf '%s' "${answer:-$default_purpose}"
}

_pick_safe_session_index() {
    # Pick the lowest session name that has NO live tmux session, given a base.
    #
    # An index is "taken" ONLY if `tmux has-session` reports it live — a live
    # session is never overwritten. A stale metadata record for a DEAD session
    # does not reserve the index, so freed indices are reused (no --N sprawl);
    # any leftover metadata at a reused index is refreshed by the caller.
    #
    # Tries the bare base first, then base--2, base--3, ... Prints the chosen
    # name and returns 0. Prints nothing and returns 1 if no free slot exists
    # within a sane bound, so the caller can refuse rather than collide.
    local base_name="$1"
    if ! tmux has-session -t "$base_name" 2>/dev/null; then
        printf '%s\n' "$base_name"
        return 0
    fi
    local n=2
    while (( n <= 999 )); do
        if ! tmux has-session -t "${base_name}--${n}" 2>/dev/null; then
            printf '%s\n' "${base_name}--${n}"
            return 0
        fi
        ((n++))
    done
    return 1
}

# ── Local resource health (start guardrail + fleet line) ───────────────
# Best-effort, macOS-first, POSIX-ish. Every accessor prints nothing when the
# platform tool is missing so callers just skip that dimension. Numbers are
# integers (percent / MB) except load, which is a bare average.

_res_mem_free_pct() {
    # Integer "free memory percentage". On macOS this is exactly what the fleet
    # monitor keys off of: memory_pressure's "System-wide memory free
    # percentage" (accounts for compression/purgeable, so it reads far higher
    # than a naive free/total). Falls back to vm_stat math if memory_pressure is
    # unavailable; Linux uses MemAvailable. Empty if undeterminable.
    if [[ -n "${CCTRL_FAKE_MEM_FREE_PCT:-}" ]]; then
        printf '%d' "$CCTRL_FAKE_MEM_FREE_PCT"; return 0
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
        local pct
        pct="$(memory_pressure 2>/dev/null \
            | sed -n 's/.*free percentage: \([0-9][0-9]*\)%.*/\1/p' | tail -1)"
        if [[ "$pct" =~ ^[0-9]+$ ]]; then
            printf '%d' "$pct"
            return 0
        fi
        local total vm pgsize free inactive spec
        total="$(sysctl -n hw.memsize 2>/dev/null)" || return 0
        [[ -n "$total" && "$total" -gt 0 ]] || return 0
        vm="$(vm_stat 2>/dev/null)" || return 0
        [[ -n "$vm" ]] || return 0
        pgsize="$(printf '%s' "$vm" | sed -n 's/.*page size of \([0-9]*\) bytes.*/\1/p')"
        [[ -n "$pgsize" ]] || pgsize=4096
        free="$(printf '%s\n' "$vm" | awk '/Pages free/{gsub(/[^0-9]/,"",$3); print $3}')"
        inactive="$(printf '%s\n' "$vm" | awk '/Pages inactive/{gsub(/[^0-9]/,"",$3); print $3}')"
        spec="$(printf '%s\n' "$vm" | awk '/Pages speculative/{gsub(/[^0-9]/,"",$3); print $3}')"
        [[ -n "$free" ]] || return 0
        printf '%d' $(( ( ${free:-0} + ${inactive:-0} + ${spec:-0} ) * pgsize * 100 / total ))
        return 0
    fi
    if [[ -r /proc/meminfo ]]; then
        local total avail
        total="$(awk '/^MemTotal:/{print $2}' /proc/meminfo)"
        avail="$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)"
        [[ -n "$total" && -n "$avail" && "$total" -gt 0 ]] || return 0
        printf '%d' $(( avail * 100 / total ))
    fi
}

_res_swap_used_mb() {
    # Integer MB of swap currently in use. Empty if undeterminable.
    if [[ -n "${CCTRL_FAKE_SWAP_MB:-}" ]]; then
        printf '%d' "$CCTRL_FAKE_SWAP_MB"; return 0
    fi
    if [[ "$(uname -s)" == "Darwin" ]]; then
        # vm.swapusage: "total = 2048.00M  used = 512.00M  free = 1536.00M"
        sysctl -n vm.swapusage 2>/dev/null \
            | sed -n 's/.*used = \([0-9]*\)\..*M.*/\1/p'
        return 0
    fi
    if [[ -r /proc/meminfo ]]; then
        local st sf
        st="$(awk '/^SwapTotal:/{print $2}' /proc/meminfo)"
        sf="$(awk '/^SwapFree:/{print $2}' /proc/meminfo)"
        [[ -n "$st" && -n "$sf" ]] || return 0
        printf '%d' $(( (st - sf) / 1024 ))
    fi
}

_res_load1() {
    # 1-minute load average as a bare number. Empty if undeterminable.
    if [[ "$(uname -s)" == "Darwin" ]]; then
        # vm.loadavg: "{ 1.23 1.45 1.67 }"
        sysctl -n vm.loadavg 2>/dev/null | awk '{print $2}'
        return 0
    fi
    [[ -r /proc/loadavg ]] && awk '{print $1}' /proc/loadavg
}

_active_session_count() {
    # Count of live cctrl-managed tmux sessions on THIS machine.
    local n
    n="$(_session_list --json 2>/dev/null | jq '[.[] | select(.managed)] | length' 2>/dev/null)"
    [[ "$n" =~ ^[0-9]+$ ]] && printf '%d' "$n" || printf '0'
}

_res_health_line() {
    # One-line at-a-glance summary for `cctrl fleet` / guardrail context.
    local mf sw ld sc
    mf="$(_res_mem_free_pct)"; sw="$(_res_swap_used_mb)"
    ld="$(_res_load1)"; sc="$(_active_session_count)"
    # An unavailable probe prints an explicit 'n/a' rather than a bare '?', so
    # "this platform can't measure it" never reads as "the value is unknown/bad".
    # The unit suffix travels with the number and is dropped alongside it.
    local mf_d sw_d
    [[ -n "$mf" ]] && mf_d="${mf}%" || mf_d="n/a"
    [[ -n "$sw" ]] && sw_d="${sw}MB" || sw_d="n/a"
    printf 'mem %s free · swap %s used · load %s · %s sessions' \
        "$mf_d" "$sw_d" "${ld:-n/a}" "${sc:-n/a}"
}

_launch_resource_guardrail() {
    # Before adding another heavy session, warn (and require confirmation or
    # --force) ONLY when the box is genuinely low on memory. We deliberately do
    # NOT gate on session count: idle/parked keeps (e.g. ~8 dormant obsidian
    # sessions) cost almost nothing, so a raw count wrongly blocks launches
    # while memory is fine. The memory metric is the same one the fleet monitor
    # reads (macOS memory_pressure "free percentage"). Session count is shown as
    # context only. Thresholds overridable for testing. Bypass with --force or
    # CCTRL_FORCE=1.
    local force="$1"
    [[ "$force" == "true" || "${CCTRL_FORCE:-}" == "1" ]] && return 0

    local mem_min="${CCTRL_MEM_FREE_MIN_PCT:-15}"     # hard floor: refuse below this
    local mem_soft="${CCTRL_MEM_FREE_SOFT_PCT:-20}"   # low-ish band ...
    local swap_hi="${CCTRL_SWAP_USED_HI_MB:-8192}"    # ... + heavy swap = pressure
    local mem_free sess_count swap_used
    mem_free="$(_res_mem_free_pct)"
    sess_count="$(_active_session_count)"
    swap_used="$(_res_swap_used_mb)"

    # Undeterminable memory reading: don't block (best-effort, never a hard stop
    # on a platform we can't measure).
    [[ "$mem_free" =~ ^[0-9]+$ ]] || return 0

    local -a reasons=()
    if [[ "$mem_free" -lt "$mem_min" ]]; then
        reasons+=("free memory ${mem_free}% is below ${mem_min}%")
    elif [[ "$mem_free" -lt "$mem_soft" && "$swap_used" =~ ^[0-9]+$ && "$swap_used" -ge "$swap_hi" ]]; then
        reasons+=("free memory ${mem_free}% low and swap filling (${swap_used}MB used)")
    fi
    [[ ${#reasons[@]} -eq 0 ]] && return 0

    echo -e "${YELLOW}⚠  Resource guardrail:${RESET} another session may thrash this machine." >&2
    local r
    for r in "${reasons[@]}"; do
        echo -e "${YELLOW}   • ${r}${RESET}" >&2
    done
    echo -e "${DIM}   $(_res_health_line)${RESET}" >&2

    # No TTY (autonomous driver): refuse without --force rather than silently
    # piling on. Interactive: let the human decide.
    if [[ ! -t 0 || ! -t 1 ]]; then
        echo -e "${RED}Refusing to launch under pressure without --force (no TTY to confirm).${RESET}" >&2
        return 1
    fi
    local answer
    printf '%s' "Launch anyway? [y/N] " >&2
    IFS= read -r answer || return 1
    case "$(printf '%s' "${answer:-n}" | tr '[:upper:]' '[:lower:]')" in
        y|yes) return 0 ;;
        *) echo -e "${DIM}Aborted.${RESET}" >&2; return 1 ;;
    esac
}

_launch_detached() {
    # Launch a cctrl session in a detached tmux session (survives SSH
    # disconnect). Invoked by `cctrl start -d`. No GUI — just tmux.
    #
    # An explicit target is REQUIRED. Defaulting to $HOME would drop a
    # full-access agent into a folder with ~/.ssh, ~/.aws, browser data, etc.
    # Session management lives under `cctrl session`.

    local target="" target_kind=""   # kind: dir | shortcut
    local purpose="" purpose_set=false initial_prompt="" peer_identity="" peer_name=""
    local profile="" detach_agent="" agent_explicit=false
    local shortcut_canonical=""
    local force=false
    local resume_id=""
    local no_health_check=false
    local health_check_timeout=30
    local passthrough_count=0
    local passthrough=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--detach)
                shift ;;
            --force|-f)
                # Skip the resource guardrail (low free memory / high session
                # count). Consumed here so it never reaches the agent CLI.
                force=true
                shift ;;
            --)
                shift
                [[ $# -gt 0 ]] && initial_prompt="$*"
                passthrough+=("--" "$@")
                passthrough_count=$((passthrough_count + 1 + $#))
                break
                ;;
            --purpose)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}--purpose needs a value${RESET}" >&2
                    return 1
                fi
                purpose="$2"
                purpose_set=true
                shift 2
                ;;
            --message|--prompt|-m)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}$1 needs a value${RESET}" >&2
                    return 1
                fi
                initial_prompt="$2"
                passthrough+=("$1" "$2")
                passthrough_count=$((passthrough_count + 2))
                shift 2
                ;;
            --agent)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}--agent needs a value${RESET}" >&2
                    return 1
                fi
                detach_agent="$2"
                agent_explicit=true
                passthrough+=("$1" "$2")
                passthrough_count=$((passthrough_count + 2))
                shift 2
                ;;
            --profile)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}--profile needs a value${RESET}" >&2
                    return 1
                fi
                profile="$2"
                passthrough+=("$1" "$2")
                passthrough_count=$((passthrough_count + 2))
                shift 2
                ;;
            --name|-n)
                # A friendly session name/label is metadata only — it must NOT
                # reach claude as --name. The launch forces the tmux session id
                # (TMUX--...) as claude's --name (leading with the purpose when
                # one exists), so a friendly -n becomes the human description
                # shown in `cctrl session ls`, unless --purpose already set one
                # (explicit --purpose always wins, regardless of arg order).
                #
                # Exception: a value that already looks like a tmux session id
                # (TMUX--...) is a realign/relaunch artifact (see _session_realign),
                # not a human label — the tmux name is re-derived from the target
                # and the display name is forced downstream, so ignore it here
                # rather than poisoning the purpose with an id.
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}$1 needs a value${RESET}" >&2
                    return 1
                fi
                if [[ "$2" != TMUX--* && "$purpose_set" != true ]]; then
                    purpose="$2"; purpose_set=true
                fi
                shift 2
                ;;
            --model|--permission-mode|--sandbox|-s|--ask-for-approval|-a|--remote|--remote-auth-token-env)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}$1 needs a value${RESET}" >&2
                    return 1
                fi
                passthrough+=("$1" "$2")
                passthrough_count=$((passthrough_count + 2))
                shift 2
                ;;
            --peer)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}--peer needs a peer name${RESET}" >&2
                    return 1
                fi
                peer_identity="$2"
                shift 2
                ;;
            --no-health-check)
                no_health_check=true
                shift
                ;;
            --health-check-timeout)
                if [[ $# -lt 2 ]]; then
                    echo -e "${RED}--health-check-timeout needs a value${RESET}" >&2
                    return 1
                fi
                health_check_timeout="$2"
                shift 2
                ;;
            --foreground|--no-tmux|--tmux)
                shift
                ;;
            --resume|-r)
                passthrough+=("$1")
                passthrough_count=$((passthrough_count + 1))
                if [[ $# -gt 1 && "$2" != -* && "$2" != @* ]]; then
                    resume_id="$2"
                    passthrough+=("$2")
                    passthrough_count=$((passthrough_count + 1))
                    shift
                fi
                shift
                ;;
            @*)
                if [[ -n "$target" ]]; then
                    passthrough+=("$1")
                    passthrough_count=$((passthrough_count + 1))
                else
                    target="${1#@}"
                    target_kind="shortcut"
                fi
                shift
                ;;
            -*)
                passthrough+=("$1")
                passthrough_count=$((passthrough_count + 1))
                shift
                ;;
            *)
                if [[ -n "$target" ]]; then
                    passthrough+=("$1")
                    passthrough_count=$((passthrough_count + 1))
                else
                    target="$1"
                    target_kind="dir"
                fi
                shift
                ;;
        esac
    done

    if ! command -v tmux &>/dev/null; then
        echo -e "${RED}tmux not found.${RESET} Install with: brew install tmux" >&2
        return 1
    fi

    if [[ -z "$target" ]]; then
        echo -e "${RED}cctrl start -d requires a target.${RESET}" >&2
        echo "Usage: cctrl start -d <dir | @shortcut> [extra args]" >&2
        echo -e "${DIM}A detached session needs an explicit dir or shortcut — defaulting${RESET}" >&2
        echo -e "${DIM}to \$HOME would drop a full-access agent into ~/.ssh, ~/.aws, etc.${RESET}" >&2
        return 1
    fi

    # Bail out before doing any work if the machine is genuinely low on memory
    # (2026-07-04 incident: too many heavy sessions exhausted RAM, filled swap
    # and wedged the fleet). Gates on free memory only, not session count.
    # --force / CCTRL_FORCE=1 overrides.
    _launch_resource_guardrail "$force" || return 1

    if [[ "$target_kind" == "shortcut" ]]; then
        shortcut_canonical="$(_shortcut_lookup_key "$target")"
        if [[ -z "$shortcut_canonical" ]]; then
            echo -e "${RED}Shortcut not found: @$target${RESET}" >&2
            echo -e "${DIM}List with: cctrl @${RESET}" >&2
            return 1
        fi
        local shortcut_profile="" shortcut_agent=""
        { IFS= read -r shortcut_profile; IFS= read -r shortcut_agent; } < <(jq -r --arg k "$shortcut_canonical" '
            .[$k] | (.profile // ""), (.agent // "")
        ' "$SHORTCUTS_FILE")
        [[ -z "$profile" && -n "$shortcut_profile" ]] && profile="$shortcut_profile"
        if [[ "$agent_explicit" != "true" && -n "$shortcut_agent" ]]; then
            detach_agent="$shortcut_agent"
        fi
    fi
    local agent_profile="$profile"
    [[ -n "$agent_profile" ]] || agent_profile="$(_active_profile)"
    detach_agent="$(_resolve_agent_or_prompt "$detach_agent" "Choose agent runtime" "$agent_profile")" || return 1
    export CCTRL_AGENT="$detach_agent"
    if [[ -n "$peer_identity" ]]; then
        local effective_profile="$profile" profile_agent pf=""
        [[ -n "$effective_profile" ]] || effective_profile="$(_active_profile)"
        if [[ -n "$effective_profile" ]] && _profile_exists "$effective_profile"; then
            profile_agent="$(_normalize_agent "$detach_agent")" || return 1
            pf="$(_profile_path "$effective_profile")"
            _apply_profile_overlay "$profile_agent" "$pf"
            _peer_refresh_paths
            _session_refresh_paths
        fi
    fi
    if [[ -n "$peer_identity" ]]; then
        local peer_json
        if peer_json="$(_peer_resolve_json "$peer_identity" 2>/dev/null)"; then
            peer_name="$(jq -r '.name' <<< "$peer_json")"
            if _peer_live_identity_conflict_exists "$peer_json" ""; then
                echo -e "${RED}Peer '$peer_name' already has a live tmux session.${RESET}" >&2
                echo -e "${DIM}Close that session before launching another with the same --peer identity.${RESET}" >&2
                return 65
            fi
        else
            if _peer_derived_name_exists "$peer_identity"; then
                echo -e "${RED}Peer '$peer_identity' already has a live tmux session.${RESET}" >&2
                echo -e "${DIM}Close that session before launching another with the same --peer identity.${RESET}" >&2
                return 65
            fi
            _peer_validate_label "name" "$peer_identity" || return 64
            peer_name="$peer_identity"
        fi
    fi

    local cctrl_q extras_q="" env_q="" base_env_q="CCTRL_TMUX_CONTEXT=1" shell_cmd session_name display_label context_name
    local -a child_args=()
    local metadata_cwd="" metadata_target=""
    cctrl_q="$(printf '%q' "$SCRIPT_DIR/cctrl")"
    local env_name env_val
    for env_name in CCTRL_AGENT CCTRL_HOST_PREFIX CCTRL_DEVICE_TAG CCTRL_DATA_DIR CCTRL_SESSION_METADATA_DIR; do
        env_val="${!env_name:-}"
        [[ -n "$env_val" ]] && base_env_q+=" $env_name=$(printf '%q' "$env_val")"
    done
    [[ -n "$peer_name" ]] && base_env_q+=" CCTRL_PEER=$(printf '%q' "$peer_name")"
    if [[ -n "$peer_name" ]]; then
        if [[ "$passthrough_count" -gt 0 ]]; then
            local inserted_peer=false
            for a in "${passthrough[@]}"; do
                if [[ "$inserted_peer" == "false" && "$a" == "--" ]]; then
                    child_args+=("--peer" "$peer_name")
                    inserted_peer=true
                fi
                child_args+=("$a")
            done
            if [[ "$inserted_peer" == "false" ]]; then
                child_args+=("--peer" "$peer_name")
            fi
        else
            child_args+=("--peer" "$peer_name")
        fi
    else
        if [[ "$passthrough_count" -gt 0 ]]; then
            child_args=("${passthrough[@]}")
        fi
    fi
    if [[ "$peer_name" == "" && "$passthrough_count" -eq 0 ]]; then
        :
    else
        for a in "${child_args[@]}"; do
            extras_q+=" $(printf '%q' "$a")"
        done
    fi

    # Detached tmux sessions and agent display names share one visible context
    # slug: TMUX--<host>--<target>.
    if [[ "$target_kind" == "shortcut" ]]; then
        local canonical
        canonical="$shortcut_canonical"
        context_name="$(_tmux_session_slug "$canonical")"
        session_name="$context_name"
        display_label="@$canonical"
        metadata_target="@$canonical"
        metadata_cwd="$(jq -r --arg k "$canonical" '.[$k].dir // ""' "$SHORTCUTS_FILE" 2>/dev/null)"
        metadata_cwd="${metadata_cwd/#\~/$HOME}"
    else
        local dir="$target"
        dir="${dir/#\~/$HOME}"
        if [[ ! -d "$dir" ]]; then
            echo -e "${RED}Directory not found: $dir${RESET}" >&2
            return 1
        fi
        dir="$(cd "$dir" && pwd)"
        metadata_cwd="$dir"
        # Naming-only alias adoption: if this directory matches a configured
        # shortcut, name the session from that shortcut's short alias so a dir
        # launch and an `@<key>` launch of the same repo produce the identical
        # TMUX--<device>--<alias> name — and therefore the identical
        # --remote-control-session-name-prefix (name == prefix, per fa2af76).
        # The cwd, agent, resume and bridge mechanism are unchanged: this launch
        # still runs `cd <dir> && cctrl start --foreground`. On collision the
        # first shortcut by sorted key wins (see _shortcut_for_dir).
        local dir_shortcut
        dir_shortcut="$(_shortcut_for_dir "$dir")"
        if [[ -n "$dir_shortcut" ]]; then
            context_name="$(_tmux_session_slug "$dir_shortcut")"
            session_name="$context_name"
            display_label="@$dir_shortcut"
            metadata_target="@$dir_shortcut"
        else
            context_name="$(_tmux_session_slug "$dir")"
            session_name="$context_name"
            display_label="$dir"
            metadata_target="$dir"
        fi
    fi

    # Never assign a name whose tmux session is currently live — that would
    # clobber the running session (its metadata is overwritten and, if
    # new-session then fails, deleted). Route every detached-name derivation
    # (start -d, @shortcut jump, metadata-name) through one live-aware picker:
    # it reuses freed/dead indices (homelab, homelab--2, ...) but skips any
    # live one, and refuses if no safe slot is available.
    local base_name="$session_name" picked_name
    if ! picked_name="$(_pick_safe_session_index "$base_name")"; then
        echo -e "${RED}Refusing to launch: no free session index for '$base_name' (indices 2-999 all have live tmux sessions).${RESET}" >&2
        return 1
    fi
    session_name="$picked_name"

    local default_purpose final_purpose
    if $purpose_set; then
        final_purpose="$purpose"
    else
        if [[ -n "$initial_prompt" ]]; then
            local repo_label
            if [[ "$metadata_target" == @* ]]; then
                repo_label="${metadata_target#@}"
            else
                repo_label="${metadata_cwd##*/}"
            fi
            default_purpose="$(_generate_auto_purpose "$initial_prompt" "$repo_label")"
        elif [[ "$target_kind" == "shortcut" ]]; then
            default_purpose="$metadata_target"
        else
            default_purpose="${metadata_cwd##*/}"
        fi
        final_purpose="$(_prompt_session_purpose "$default_purpose")"
    fi

    env_q="$base_env_q CCTRL_SESSION_KIND=tmux CCTRL_SESSION_NAME=$(printf '%q' "$session_name")"
    [[ -n "$metadata_target" ]] && env_q+=" CCTRL_SESSION_TARGET=$(printf '%q' "$metadata_target")"
    [[ -n "$final_purpose" ]] && env_q+=" CCTRL_SESSION_PURPOSE=$(printf '%q' "$final_purpose")"
    env_q="${env_q# } "

    local cc_name_q
    cc_name_q="$(printf '%q' "$session_name")"
    if [[ "$target_kind" == "shortcut" ]]; then
        local name_q
        name_q="$(printf '%q' "${metadata_target#@}")"
        shell_cmd="${env_q}$cctrl_q @$name_q --foreground --name $cc_name_q$extras_q"
    else
        local dir_q
        dir_q="$(printf '%q' "$metadata_cwd")"
        shell_cmd="cd $dir_q && ${env_q}$cctrl_q start --foreground --name $cc_name_q$extras_q"
    fi

    if ! _session_write_metadata "$session_name" "$metadata_cwd" "$target_kind" "$metadata_target" "$display_label" "$final_purpose" "$initial_prompt" "$shell_cmd" "$peer_name" "$detach_agent" "$resume_id" "" 2>/dev/null; then
        echo -e "${YELLOW}⚠  Could not write session metadata.${RESET}" >&2
        echo -e "${DIM}   Path: $(_session_metadata_file "$session_name")${RESET}" >&2
        if [[ -n "$peer_name" ]]; then
            echo -e "${RED}Failed to write session metadata for peer '$peer_name'.${RESET}" >&2
            echo -e "${DIM}Metadata path: $(_session_metadata_file "$session_name")${RESET}" >&2
            return 1
        fi
    fi
    if ! tmux new-session -d -s "$session_name" "$shell_cmd"; then
        rm -f "$(_session_metadata_file "$session_name")" 2>/dev/null || true
        return 1
    fi
    tmux set-option -t "$session_name" -q @cctrl_managed 1 2>/dev/null || true
    tmux set-option -t "$session_name" -q @cctrl_agent "$detach_agent" 2>/dev/null || true
    # Bind this registry record to the newly-created tmux pane. A later
    # attestation rejects a recycled session name or a replaced pane.
    _session_capture_tmux_attestation_anchor "$session_name" 2>/dev/null || true

    # Post-spawn health check (plan 056): poll the pane for known blocking
    # prompts and auto-dismiss safe ones. Only for detached spawns (not
    # attach-after) and not when explicitly bypassed. Always returns 0 —
    # results go to session metadata (health_status field).
    # CCTRL_NO_HEALTH_CHECK=1 env var also skips (for tests and scripting).
    if [[ "$no_health_check" != "true" && "${CCTRL_NO_HEALTH_CHECK:-}" != "1" \
          && "${CCTRL_ATTACH_AFTER_START:-}" != "1" ]]; then
        if [[ -f "$SCRIPT_DIR/lib/health-check.sh" ]]; then
            if [[ -z "${_HC_PATTERNS_LOADED:-}" ]]; then
                _HC_SCRIPT_DIR="$SCRIPT_DIR/lib"
                source "$SCRIPT_DIR/lib/health-check.sh"
            fi
            _health_check_run "$session_name" "$detach_agent" "$health_check_timeout"
        fi
    fi

    # Best-effort background poll for conversation_id on fresh launches (plan 051).
    # MUST drop stdio: _remote_exec captures via $(ssh ...) which returns on
    # pipe EOF, not process exit — an inherited stdout keeps it open.
    if [[ -z "$resume_id" ]]; then
        local _poll_timeout="${CCTRL_RESUME_POLL_TIMEOUT:-20}"
        local _poll_interval="${CCTRL_RESUME_POLL_INTERVAL:-2}"
        local _poll_created_at
        _poll_created_at="$(_session_metadata_field "$session_name" created_at)"
        (
            local _elapsed=0 _sid
            while [[ "$_elapsed" -lt "$_poll_timeout" ]]; do
                sleep "$_poll_interval"
                _elapsed=$((_elapsed + _poll_interval))
                _sid="$(_session_id "$session_name" 2>/dev/null)"
                if [[ -n "$_sid" ]]; then
                    local _tpath
                    _tpath="$(_session_transcript_path "$session_name" 2>/dev/null)"
                    # Guard: verify the record still belongs to this launch
                    local _rec_created
                    _rec_created="$(_session_metadata_field "$session_name" created_at 2>/dev/null)"
                    [[ "$_rec_created" == "$_poll_created_at" ]] || break
                    _session_update_metadata_field "$session_name" conversation_id "$_sid" 2>/dev/null
                    [[ -n "$_tpath" ]] && _session_update_metadata_field "$session_name" transcript_path "$_tpath" 2>/dev/null
                    break
                fi
            done
        ) </dev/null >/dev/null 2>&1 &
        disown 2>/dev/null || true
    fi

    if [[ "$detach_agent" == "codex" ]]; then
        local _codex_title _codex_created_at
        _codex_title="$(_session_app_display_name "$session_name" "$final_purpose" "$metadata_cwd")"
        _codex_created_at="$(_session_metadata_field "$session_name" created_at)"
        _session_codex_schedule_display_name_sync "$session_name" "$_codex_title" "$_codex_created_at"
    fi

    # When this launch is driven from a remote `--host <alias>` invocation, the
    # session lives on THIS machine but the user is sitting at their local shell.
    # Carry the `--host <alias>` prefix into the hint commands so they target the
    # right machine; otherwise they'd run locally where the session doesn't exist.
    local hint_prefix="cctrl"
    if [[ -n "${CCTRL_HOST_PREFIX:-}" ]]; then
        hint_prefix="cctrl --host $CCTRL_HOST_PREFIX"
    fi

    echo -e "${GREEN}✓${RESET} detached session started — ${BOLD}$display_label${RESET}"
    echo -e "${DIM}  Attach:  $hint_prefix session attach $session_name${RESET}"
    echo -e "${DIM}  List:    $hint_prefix session ls${RESET}"
    echo -e "${DIM}  Close:   $hint_prefix session close $session_name  (or 'cctrl close' from inside)${RESET}"
    echo -e "${DIM}  Kill:    $hint_prefix session kill $session_name${RESET}"

    # Machine-readable line so a remote launch can attach to the exact session
    # name (including any auto-increment suffix). See _remote_exec.
    if [[ -n "${CCTRL_EMIT_SESSION:-}" ]]; then
        printf 'CCTRL_SESSION=%s\n' "$session_name"
    fi

    local attach_default="no"
    [[ "${CCTRL_ATTACH_AFTER_START:-}" == "1" ]] && attach_default="yes"
    _prompt_attach_session "$session_name" "$attach_default"
}

_prompt_attach_session() {
    local session_name="$1" default="${2:-no}" answer prompt default_answer

    case "${CCTRL_ATTACH_PROMPT:-auto}" in
        never) return 0 ;;
        always) ;;
        *) [[ -t 0 && -t 1 ]] || return 0 ;;
    esac

    if [[ "$default" == "yes" ]]; then
        prompt="Connect to session $session_name now? [Y/n] "
        default_answer="yes"
    else
        prompt="Connect to session $session_name now? [y/N] "
        default_answer="no"
    fi

    printf '%s' "$prompt"
    IFS= read -r answer || return 0
    answer="$(printf '%s' "${answer:-$default_answer}" | tr '[:upper:]' '[:lower:]')"
    case "$answer" in
        y|yes) exec tmux attach-session -t "$session_name" ;;
        *)
            local hint_prefix="cctrl"
            [[ -n "${CCTRL_HOST_PREFIX:-}" ]] && hint_prefix="cctrl --host $CCTRL_HOST_PREFIX"
            echo -e "${DIM}Not connected. Attach later: $hint_prefix session attach $session_name${RESET}"
            ;;
    esac
}

# ── Peer registry ─────────────────────────────────────────────────────

_peer_init() {
    mkdir -p "$(dirname "$PEERS_FILE")"
    [[ -f "$PEERS_FILE" ]] || echo "{}" > "$PEERS_FILE"
}

_peer_now_utc() {
    if [[ -n "${CCTRL_NOW_UTC:-}" ]]; then
        printf '%s\n' "$CCTRL_NOW_UTC"
        return
    fi
    date -u +"%Y-%m-%dT%H:%M:%SZ"
}

_peer_guard_defs() {
    # Canonical addressee-guard predicate, emitted as jq `def`s so every
    # enforcement site (recv, inbox, delivery) shares ONE copy and cannot drift.
    # Injected by concatenating this (single-quoted, so bash never re-expands the
    # `$p` inside) ahead of each program: jq ... "$GUARD"'<program>'.
    #
    # $p is the CURRENT occupant's created_at for the message's `to` name ("" if
    # the occupant carries no stamp). A tmux session name doubles as a mailbox
    # address and freed indices are recycled, so a name can be re-held by a
    # different session; delivering mail queued for the prior occupant to the new
    # one is silent misrouting. Policy — fail OPEN on absence, CLOSED on
    # ambiguity:
    #   deliver  = pre-seed (unknown_peer), or no stamp on either side (name was
    #              always the only identity), or the occupant PROVABLY predates
    #              the message (message.created_at > peer.created_at)
    #   block    = everything else where the occupant carries a stamp: message
    #              newer (replaced), equal-second tie, or an unparseable message
    #              stamp (e.g. a CCTRL_NOW_UTC override). Misroute is worse than a
    #              bounce; a block fails loud and the sender is told.
    # Timestamps are fixed-width ISO-8601 UTC, so lexical compare == chronological.
    cat <<'JQ'
def fixed_ts: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
def deliverable($p):
  (.unknown_peer == true)
  or ($p == null or $p == "")
  or ((.created_at // "") == "")
  or (((.created_at | fixed_ts) and ($p | fixed_ts)) and (.created_at > $p));
def block_reason($p):
  if ((.created_at | fixed_ts) and ($p | fixed_ts) and (.created_at < $p))
  then "addressee-replaced" else "addressee-ambiguous" end;
JQ
}

_peer_validate_label() {
    local kind="$1" value="${2:-}"
    if [[ -z "$value" ]]; then
        echo -e "${RED}Peer $kind cannot be empty.${RESET}" >&2
        return 1
    fi
    if [[ "$value" == "user" ]]; then
        echo -e "${RED}Invalid peer $kind: 'user' is reserved for the human sender.${RESET}" >&2
        return 1
    fi
    if [[ ! "$value" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        echo -e "${RED}Invalid peer $kind: '$value'.${RESET}" >&2
        echo -e "${DIM}Use letters, numbers, dot, underscore, or dash; no whitespace or shell metacharacters.${RESET}" >&2
        return 1
    fi
}

_peer_json_array() {
    if [[ $# -eq 0 ]]; then
        printf '[]\n'
        return
    fi
    printf '%s\n' "$@" | jq -R . | jq -s 'unique'
}

_peer_lookup_manual_key() {
    local name="$1"
    _peer_init
    jq -r --arg n "$name" '
        ([to_entries[]
          | select(.key == $n or ((.value.aliases // []) | index($n)))
          | .key][0]) // empty
    ' "$PEERS_FILE" 2>/dev/null
}

_peer_manual_collision_owner() {
    local label="$1" owner="${2:-}" found
    found="$(_peer_lookup_manual_key "$label")"
    if [[ -n "$found" && "$found" != "$owner" ]]; then
        printf '%s\n' "$found"
        return 0
    fi
    return 1
}

_peer_derived_name_exists() {
    local label="$1" doc
    doc="$(_peer_derived_json)" || return 1
    jq -e --arg n "$label" '.peers[]? | select(.name == $n or ((.aliases // []) | index($n)))' <<< "$doc" >/dev/null 2>&1
}

_peer_derived_identity_exists() {
    _peer_derived_identity_conflict_exists "${1:-}" ""
}

_peer_derived_identity_conflict_exists() {
    local name="$1" doc
    local allowed_session="${2:-}"
    doc="$(_peer_derived_json)" || return 1
    jq -e --arg n "$name" --arg allowed "$allowed_session" '
        .peers[]?
        | select(.name == $n)
        | select($allowed == "" or (.session // "") != $allowed)
    ' <<< "$doc" >/dev/null 2>&1
}

_peer_live_identity_conflict_exists() {
    local peer_json="$1" allowed_session="${2:-}" name session
    name="$(jq -r '.name // empty' <<< "$peer_json")"
    session="$(jq -r '.tmux_target // .session // empty' <<< "$peer_json")"
    if [[ -n "$session" && "$session" != "$allowed_session" ]] && command -v tmux >/dev/null 2>&1 && _tmux_run_with_timeout has-session -t "$session"; then
        return 0
    fi
    if [[ -n "$name" ]] && _peer_derived_identity_conflict_exists "$name" "$allowed_session"; then
        return 0
    fi
    return 1
}

_peer_derived_json() {
    local host_label="${CCTRL_HOST_PREFIX:-local}" sessions_json
    if ! command -v tmux >/dev/null 2>&1; then
        jq -n '{skipped:true, reason:"tmux unavailable", peers:[]}'
        return
    fi

    if ! sessions_json="$(_session_list --json 2>/dev/null)"; then
        jq -n '{skipped:true, reason:"tmux session discovery failed", peers:[]}'
        return
    fi
    if ! printf '%s\n' "$sessions_json" | jq empty >/dev/null 2>&1; then
        jq -n '{skipped:true, reason:"tmux session discovery returned invalid JSON", peers:[]}'
        return
    fi

    jq -n --argjson sessions "$sessions_json" --arg host "$host_label" '
        {
          skipped: false,
          reason: null,
          peers: [
            $sessions[]
            | select(.managed == true)
            | (.peer // .name) as $peer_name
            | {
                name: $peer_name,
                aliases: (if ((.peer // "") != "" and .peer != .name) then [.name] else [] end),
                host: $host,
                dir: .dir,
                agent: .agent,
                session: .name,
                purpose: .purpose,
                display_label: .display_label,
                capabilities: ["mailbox", "tmux"],
                source: "derived",
                tmux_target: .name,
                created_at: .created_at
              }
            | with_entries(select(.value != null))
          ]
        }'
}

_peer_all_json_build() {
    _peer_init
    local manual_json derived_json
    manual_json="$(cat "$PEERS_FILE")"
    derived_json="$(_peer_derived_json)"
    jq -n --argjson manual "$manual_json" --argjson derived "$derived_json" '
        def clean: with_entries(select(.value != null));
        def with_tmux_target:
          if ((.session // "") != "") then . + {tmux_target: .session} else . end;

        ($derived.peers // []) as $derived_peers
        | ($manual | to_entries) as $manual_entries
        | ($manual_entries | (map(.key) + map((.value.aliases // [])[]))) as $manual_labels
        | ($manual_entries | map(
            .key as $k
            | .value as $v
            | ([ $derived_peers[] | select(.name == $k) ][0] // null) as $derived_name_match
            | ([ $derived_peers[] | select((.aliases // []) | index($k)) ][0] // null) as $derived_alias_match
            | ($derived_name_match // null) as $derived_merge
            | ($derived_name_match // $derived_alias_match // null) as $derived_shadow
            | (($derived_merge.aliases // []) | map(. as $alias | select(($manual_labels | index($alias)) | not))) as $derived_aliases
            | (($derived_shadow.session // $derived_shadow.name // "") // "") as $shadow
            | ({
                name: ($v.name // $k),
                aliases: ((($v.aliases // []) + $derived_aliases) | unique),
                host: ($v.host // "local"),
                dir: ($v.dir // $derived_merge.dir // null),
                agent: ($v.agent // $derived_merge.agent // null),
                session: ($derived_merge.session // $v.session // null),
                purpose: ($v.purpose // $derived_merge.purpose // null),
                display_label: ($v.display_label // $derived_merge.display_label // null),
                capabilities: ((($v.capabilities // []) + ($derived_merge.capabilities // [])) | unique),
                registered_at: ($v.registered_at // null),
                source: "manual"
              }
              | with_tmux_target
              | if $shadow != "" then . + {shadows: $shadow} else . end
              | clean)
          )) as $manual_peers
        | {
            derived_skipped: ($derived.skipped // false),
            derived_skip_reason: ($derived.reason // null),
            peers: (
              $manual_peers
              + [
                  $derived_peers[]
                  | . as $p
                  | select(($manual_labels | index($p.name)) | not)
                  | .aliases = ((.aliases // []) | map(. as $alias | select(($manual_labels | index($alias)) | not)))
                ]
            )
          }'
}

# Memoized peer+session enumeration (plan 027). A single command that touches
# the registry several times (`peer reply`, `peer send --deliver`) resolves the
# full document ONCE via _peer_all_json_cache_begin and every downstream
# _peer_resolve_json / _peer_all_json call reuses it, instead of one
# _peer_all_json -> _session_list walk per step (~1.43s each). The cache is
# process-local and only primed by commands that opt in; every other caller
# (and plain `peer send`) rebuilds fresh, byte-for-byte as before.
_peer_all_json() {
    if [[ "${_PEER_ALL_JSON_CACHED:-0}" == "1" ]]; then
        printf '%s\n' "$_PEER_ALL_JSON_CACHE"
        return 0
    fi
    _peer_all_json_build
}

_peer_fleet_peers() {
    [[ -f "$HOSTS_FILE" ]] || { echo '[]'; return; }
    local alias hostname rc raw peers_json result="[]"
    while IFS=$'\t' read -r alias hostname; do
        [[ -n "$alias" ]] || continue
        _host_is_local "$hostname" && continue
        rc=0
        raw="$(_fleet_remote_peers "$alias")" || rc=$?
        if [[ $rc -eq 0 && -n "$raw" ]] \
            && printf '%s' "$raw" | jq -e '.peers' >/dev/null 2>&1; then
            peers_json="$(jq -c --arg host "$alias" '
                [.peers[] | . + {host: $host, source: "remote"}]
            ' <<< "$raw")"
            result="$(jq -c --argjson existing "$result" '. as $new | $existing + $new' <<< "$peers_json")"
        fi
    done < <(jq -r 'to_entries[] | "\(.key)\t\(.value.hostname)"' "$HOSTS_FILE" 2>/dev/null)
    printf '%s\n' "$result"
}

_peer_all_json_cache_begin() {
    local doc
    doc="$(_peer_all_json_build)" || return 1
    _PEER_ALL_JSON_CACHE="$doc"
    _PEER_ALL_JSON_CACHED=1
}

_peer_all_json_cache_end() {
    unset _PEER_ALL_JSON_CACHE _PEER_ALL_JSON_CACHED
}

_peer_resolve_json() {
    local name="$1" doc matches count skipped reason
    doc="$(_peer_all_json)" || return 1
    matches="$(jq -c --arg n "$name" '
        [ .peers[]
          | select(.name == $n or ((.aliases // []) | index($n)))
        ]
    ' <<< "$doc")"
    count="$(jq -r 'length' <<< "$matches")"
    if [[ "$count" == "0" ]]; then
        skipped="$(jq -r '.derived_skipped' <<< "$doc")"
        reason="$(jq -r '.derived_skip_reason // empty' <<< "$doc")"
        echo -e "${RED}Unknown peer: '$name'${RESET}" >&2
        if [[ "$skipped" == "true" && -n "$reason" ]]; then
            echo -e "${YELLOW}Derived tmux peer discovery skipped: $reason.${RESET}" >&2
        fi
        echo -e "${DIM}Register it with: cctrl peer register $name --dir <path> --agent <agent>${RESET}" >&2
        return 1
    fi
    if (( count > 1 )); then
        echo -e "${RED}Ambiguous peer identity: '$name'${RESET}" >&2
        jq -r '.[] | "  - " + .name + " (" + .source + ")"' <<< "$matches" >&2
        return 1
    fi
    jq '.[0]' <<< "$matches"
}

_peer_print_human() {
    # Shared by `peer show` (message envelopes), `peer whoami`, and `peer resolve`
    # (peer identity objects). Must be generically object-safe: a nested object
    # (message `sender`, plan 023) or an array of objects (message `.history`)
    # must never crash or dump raw JSON as an unreadable line. `value` renders
    # scalars via tostring, arrays of scalars via join (unchanged for peer
    # objects' aliases/capabilities), and anything nested compactly. `sender`
    # gets a dedicated readable line.
    jq -r '
        def value:
          if type == "array" then
            (map(if type == "object" or type == "array" then tojson else tostring end) | join(", "))
          elif type == "object" then tojson
          else tostring
          end;
        to_entries[]
        | select(.value != null)
        | if .key == "sender" and (.value | type) == "object" then
            .value as $s
            | ($s.label // $s.name) as $lbl
            | ([$s.tmux_target, $s.agent] | map(select(. != null))) as $extra
            | "  sender: " + $lbl
              + (if ($extra | length) > 0 then " (" + ($extra | join(", ")) + ")" else "" end)
          else
            "  \(.key): \(.value | value)"
          end
    '
}

_peer_cmd_register() {
    local name="${1:-}"
    [[ -n "$name" ]] || { echo -e "${RED}Usage: cctrl peer register <name> [flags]${RESET}" >&2; return 1; }
    shift
    _peer_validate_label "name" "$name" || return 1

    local host="local" dir="" agent="" session="" purpose=""
    local -a aliases=() capabilities=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --alias)
                [[ $# -ge 2 ]] || { echo -e "${RED}--alias needs a value${RESET}" >&2; return 1; }
                _peer_validate_label "alias" "$2" || return 1
                aliases+=("$2"); shift 2 ;;
            --host)
                [[ $# -ge 2 ]] || { echo -e "${RED}--host needs a value${RESET}" >&2; return 1; }
                host="$2"; shift 2 ;;
            --dir)
                [[ $# -ge 2 ]] || { echo -e "${RED}--dir needs a value${RESET}" >&2; return 1; }
                dir="${2/#\~/$HOME}"; shift 2 ;;
            --agent)
                [[ $# -ge 2 ]] || { echo -e "${RED}--agent needs a value${RESET}" >&2; return 1; }
                [[ -n "$2" ]] || { echo -e "${RED}--agent cannot be empty${RESET}" >&2; return 1; }
                agent="$2"; shift 2 ;;
            --session)
                [[ $# -ge 2 ]] || { echo -e "${RED}--session needs a value${RESET}" >&2; return 1; }
                session="$2"; shift 2 ;;
            --purpose)
                [[ $# -ge 2 ]] || { echo -e "${RED}--purpose needs a value${RESET}" >&2; return 1; }
                purpose="$2"; shift 2 ;;
            --capability)
                [[ $# -ge 2 ]] || { echo -e "${RED}--capability needs a value${RESET}" >&2; return 1; }
                _peer_validate_label "capability" "$2" || return 1
                capabilities+=("$2"); shift 2 ;;
            *)
                echo -e "${RED}Unknown peer register flag: $1${RESET}" >&2
                return 1 ;;
        esac
    done

    _peer_init
    local existing owner alias
    existing="$(_peer_lookup_manual_key "$name")"
    if [[ -n "$existing" && "$existing" != "$name" ]]; then
        echo -e "${RED}Peer name '$name' collides with alias on '$existing'.${RESET}" >&2
        return 1
    fi
    if [[ ${#aliases[@]} -gt 0 ]]; then
        for alias in "${aliases[@]}"; do
            if [[ "$alias" == "$name" ]]; then
                echo -e "${RED}Alias '$alias' matches the peer name.${RESET}" >&2
                return 1
            fi
            if owner="$(_peer_manual_collision_owner "$alias" "$name")"; then
                echo -e "${RED}Peer alias '$alias' collides with '$owner'.${RESET}" >&2
                return 1
            fi
            if _peer_derived_name_exists "$alias"; then
                echo -e "${RED}Peer alias '$alias' collides with a live tmux peer.${RESET}" >&2
                return 1
            fi
        done
    fi

    local aliases_json capabilities_json now tmp
    if [[ ${#capabilities[@]} -eq 0 ]]; then
        if [[ -n "$session" ]]; then
            capabilities=("mailbox" "tmux")
        else
            capabilities=("mailbox")
        fi
    else
        local has_mailbox=false capability
        for capability in "${capabilities[@]}"; do
            [[ "$capability" == "mailbox" ]] && has_mailbox=true
        done
        $has_mailbox || capabilities=("mailbox" "${capabilities[@]}")
    fi
    if [[ ${#aliases[@]} -gt 0 ]]; then
        aliases_json="$(_peer_json_array "${aliases[@]}")"
    else
        aliases_json="[]"
    fi
    capabilities_json="$(_peer_json_array "${capabilities[@]}")"
    now="$(_peer_now_utc)"
    tmp="$(mktemp)"
    jq --arg name "$name" \
       --arg host "$host" \
       --arg dir "$dir" \
       --arg agent "$agent" \
       --arg session "$session" \
       --arg purpose "$purpose" \
       --arg now "$now" \
       --argjson aliases "$aliases_json" \
       --argjson capabilities "$capabilities_json" '
        . + {
          ($name): (
            {
              name: $name,
              aliases: $aliases,
              host: $host,
              capabilities: $capabilities,
              registered_at: (.[$name].registered_at // $now)
            }
            + (if $dir != "" then {dir: $dir} else {} end)
            + (if $agent != "" then {agent: $agent} else {} end)
            + (if $session != "" then {session: $session} else {} end)
            + (if $purpose != "" then {purpose: $purpose} else {} end)
          )
        }' "$PEERS_FILE" > "$tmp" && mv "$tmp" "$PEERS_FILE"

    echo -e "${GREEN}Registered peer: ${BOLD}$name${RESET}"
}

_peer_cmd_alias() {
    local name="${1:-}" alias="${2:-}" key owner doc derived_count tmp
    if [[ -z "$name" || -z "$alias" ]]; then
        echo -e "${RED}Usage: cctrl peer alias <name> <alias>${RESET}" >&2
        return 1
    fi
    _peer_validate_label "alias" "$alias" || return 1
    key="$(_peer_lookup_manual_key "$name")"
    if [[ -z "$key" ]]; then
        doc="$(_peer_all_json)" || return 1
        derived_count="$(jq -r --arg n "$name" '[.peers[] | select(.source == "derived" and (.name == $n or ((.aliases // []) | index($n))))] | length' <<< "$doc")"
        if (( derived_count > 0 )); then
            echo -e "${RED}Peer '$name' is derived from tmux; register this peer first before adding aliases.${RESET}" >&2
        else
            echo -e "${RED}Unknown manual peer: '$name'${RESET}" >&2
        fi
        return 1
    fi
    if [[ "$alias" == "$key" ]]; then
        echo -e "${RED}Alias '$alias' matches the peer name.${RESET}" >&2
        return 1
    fi
    if owner="$(_peer_manual_collision_owner "$alias" "$key")"; then
        echo -e "${RED}Peer alias '$alias' collides with '$owner'.${RESET}" >&2
        return 1
    fi
    if _peer_derived_name_exists "$alias"; then
        echo -e "${RED}Peer alias '$alias' collides with a live tmux peer.${RESET}" >&2
        return 1
    fi

    tmp="$(mktemp)"
    jq --arg key "$key" --arg alias "$alias" '
        .[$key].aliases = ((.[$key].aliases // []) + [$alias] | unique)
    ' "$PEERS_FILE" > "$tmp" && mv "$tmp" "$PEERS_FILE"
    echo -e "${GREEN}Added alias: ${BOLD}$alias${RESET}${GREEN} → $key${RESET}"
}

_peer_cmd_unregister() {
    local name="${1:-}" key tmp
    [[ -n "$name" ]] || { echo -e "${RED}Usage: cctrl peer unregister <name>${RESET}" >&2; return 1; }
    key="$(_peer_lookup_manual_key "$name")"
    if [[ -z "$key" ]]; then
        echo -e "${RED}No manual peer registered as '$name'.${RESET}" >&2
        return 1
    fi
    tmp="$(mktemp)"
    jq --arg key "$key" 'del(.[$key])' "$PEERS_FILE" > "$tmp" && mv "$tmp" "$PEERS_FILE"
    echo -e "${GREEN}Unregistered peer: $key${RESET}"
}

_peer_cmd_ls() {
    local json=false fleet=false a doc
    for a in "$@"; do
        case "$a" in
            --json) json=true ;;
            --fleet) fleet=true ;;
            *)
                echo -e "${RED}Unknown peer ls flag: $a${RESET}" >&2
                return 1 ;;
        esac
    done
    doc="$(_peer_all_json)" || return 1
    if $fleet; then
        local remote_peers
        remote_peers="$(_peer_fleet_peers)"
        if [[ -n "$remote_peers" && "$remote_peers" != "[]" ]]; then
            doc="$(jq -c --slurpfile remote <(echo "$remote_peers") '
                .peers = (.peers + $remote[0])
                | .fleet = true
            ' <<< "$doc")"
        fi
    fi
    if $json; then
        jq '.' <<< "$doc"
        return
    fi
    if [[ "$(jq -r '.derived_skipped' <<< "$doc")" == "true" ]]; then
        echo -e "${YELLOW}Derived tmux peer discovery skipped: $(jq -r '.derived_skip_reason' <<< "$doc").${RESET}" >&2
    fi
    if [[ "$(jq -r '.peers | length' <<< "$doc")" == "0" ]]; then
        echo -e "${DIM}No peers registered or discovered.${RESET}"
        return
    fi
    echo -e "${BOLD}Peers${RESET}"
    printf '  %b%-18s %-8s %-7s %-20s %-8s %s%b\n' \
        "$DIM" "NAME" "SOURCE" "AGENT" "SESSION" "STATUS" "DIR / PURPOSE" "$RESET"
    jq -r '
        .peers[]
        | [
            .name,
            .source,
            (.agent // "-"),
            ((.tmux_target // .session) // ""),
            (.dir // "-"),
            ((.capabilities // []) | join(",")),
            (.purpose // ""),
            (.shadows // "")
          ]
        | @tsv
    ' <<< "$doc" | while IFS=$'\t' read -r name source agent session dir capabilities purpose shadows; do
        local shadow_text="" session_text status_text
        if [[ -n "$session" ]] && _tmux_run_with_timeout has-session -t "$session" >/dev/null 2>&1; then
            session_text="$session"
            status_text="${GREEN}live${RESET}"
        elif [[ -n "$session" ]]; then
            session_text="$session"
            status_text="${DIM}offline${RESET}"
        else
            session_text="-"
            status_text="${DIM}offline${RESET}"
        fi
        [[ -n "$shadows" ]] && shadow_text=" ${DIM}shadows=$shadows${RESET}"
        printf '  %b%-18s%b %-8s %-7s %-20s %b%-8s%b %-24s %s%s\n' \
            "$GREEN" "$name" "$RESET" "$source" "$agent" "$session_text" \
            "" "$status_text" "$RESET" "$dir" "$capabilities" "$purpose$shadow_text"
    done
}

# ── Direct peer chat over tmux (plan 010) ─────────────────────────────
# Resolve a peer identity/alias to a LIVE, LOCAL tmux target for the direct-chat
# affordances (`peer session`, `peer attach`, `peer say`). Goes through the
# shared peer JSON resolver so alias/canonical handling and the
# live-derived-over-stale-manual behavior stay consistent — it never reads
# data/peers.json directly. For direct-chat affordances (say/attach/session),
# a peer whose `.host` differs from the current host label is rejected with a
# `--host` hint. For durable messaging (send --deliver, reply), cross-host
# routing is automatic via _peer_send_and_deliver_remote.
#
# Sets PEER_DIRECT_{NAME,LABEL,TARGET,HOST,LIVE,STATUS,REASON}. Returns 0 for a
# live local target; non-zero otherwise (STATUS in unknown-peer / remote-host /
# no-session / stale).
_peer_direct_resolve() {
    local identity="$1" peer_json
    PEER_DIRECT_NAME=""
    PEER_DIRECT_LABEL="$identity"
    PEER_DIRECT_TARGET=""
    PEER_DIRECT_HOST=""
    PEER_DIRECT_LIVE=false
    PEER_DIRECT_STATUS=""
    PEER_DIRECT_REASON=""

    if ! peer_json="$(_peer_resolve_json "$identity" 2>/dev/null)"; then
        PEER_DIRECT_STATUS="unknown-peer"
        PEER_DIRECT_REASON="Unknown or ambiguous peer: '$identity'"
        return 66
    fi
    PEER_DIRECT_NAME="$(jq -r '.name // empty' <<< "$peer_json")"
    PEER_DIRECT_HOST="$(jq -r '.host // "local"' <<< "$peer_json")"
    PEER_DIRECT_TARGET="$(jq -r '(.tmux_target // .session) // empty' <<< "$peer_json")"

    local host_label="${CCTRL_HOST_PREFIX:-local}"
    if [[ "$PEER_DIRECT_HOST" != "$host_label" ]]; then
        PEER_DIRECT_STATUS="remote-host"
        PEER_DIRECT_REASON="Peer '$PEER_DIRECT_NAME' lives on host '$PEER_DIRECT_HOST', not '$host_label'."
        return 65
    fi

    if [[ -z "$PEER_DIRECT_TARGET" ]]; then
        PEER_DIRECT_STATUS="no-session"
        PEER_DIRECT_REASON="Peer '$PEER_DIRECT_NAME' has no live tmux session (polling/MCP-only)."
        return 66
    fi

    if command -v tmux >/dev/null 2>&1 && _tmux_run_with_timeout has-session -t "$PEER_DIRECT_TARGET" >/dev/null 2>&1; then
        PEER_DIRECT_LIVE=true
        PEER_DIRECT_STATUS="ok"
        return 0
    fi
    PEER_DIRECT_STATUS="stale"
    PEER_DIRECT_REASON="Peer '$PEER_DIRECT_NAME' maps to tmux session '$PEER_DIRECT_TARGET', which is not live."
    return 66
}

# Print a resolution failure (human mode) with an actionable hint. For
# non-local host metadata, hint the top-level `--host` forwarding layer — the
# only sanctioned cross-host path — instead of auto-SSH.
_peer_direct_print_error() {
    local verb="$1"
    echo -e "${RED}${PEER_DIRECT_REASON}${RESET}" >&2
    if [[ "$PEER_DIRECT_STATUS" == "remote-host" ]]; then
        local suffix=""
        [[ "$verb" == "say" ]] && suffix=" -- ..."
        echo -e "${DIM}Run: cctrl --host ${PEER_DIRECT_HOST} peer ${verb} ${PEER_DIRECT_LABEL}${suffix}${RESET}" >&2
    fi
}

_peer_cmd_session() {
    local identity="" json=false a
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json=true; shift ;;
            -*) echo -e "${RED}Unknown peer session flag: $1${RESET}" >&2; return 64 ;;
            *)
                if [[ -z "$identity" ]]; then identity="$1"; shift
                else echo -e "${RED}Unexpected argument: $1${RESET}" >&2; return 64; fi ;;
        esac
    done
    if [[ -z "$identity" ]]; then
        echo -e "${RED}Usage: cctrl peer session <peer> [--json]${RESET}" >&2
        return 64
    fi
    local rc=0; _peer_direct_resolve "$identity" || rc=$?
    if $json; then
        jq -n \
            --argjson ok "$( [[ $rc -eq 0 ]] && echo true || echo false )" \
            --arg name "$PEER_DIRECT_NAME" \
            --arg label "$PEER_DIRECT_LABEL" \
            --arg session "$PEER_DIRECT_TARGET" \
            --arg host "$PEER_DIRECT_HOST" \
            --argjson live "$PEER_DIRECT_LIVE" \
            --arg status "$PEER_DIRECT_STATUS" \
            --arg reason "$PEER_DIRECT_REASON" '
            {ok:$ok, name:$name, label:$label,
             session:(if $session != "" then $session else null end),
             tmux_target:(if $session != "" then $session else null end),
             host:$host, live:$live, status:$status}
            + (if $reason != "" then {reason:$reason} else {} end)'
        return $rc
    fi
    if (( rc != 0 )); then
        _peer_direct_print_error session
        return $rc
    fi
    echo "${PEER_DIRECT_NAME} -> ${PEER_DIRECT_TARGET}"
}

_peer_cmd_attach() {
    # Interactive only — no --json mode. Resolve to the backing tmux session and
    # delegate to the existing `session attach` path.
    local identity="" a
    for a in "$@"; do
        case "$a" in
            --json) echo -e "${RED}peer attach is interactive and has no --json mode.${RESET}" >&2; return 64 ;;
            -*) echo -e "${RED}Unknown peer attach flag: $a${RESET}" >&2; return 64 ;;
            *)
                if [[ -z "$identity" ]]; then identity="$a"
                else echo -e "${RED}Unexpected argument: $a${RESET}" >&2; return 64; fi ;;
        esac
    done
    if [[ -z "$identity" ]]; then
        echo -e "${RED}Usage: cctrl peer attach <peer>${RESET}" >&2
        return 64
    fi
    local rc=0; _peer_direct_resolve "$identity" || rc=$?
    if (( rc != 0 )); then _peer_direct_print_error attach; return $rc; fi
    _session_attach "$PEER_DIRECT_TARGET"
}

_peer_cmd_say() {
    # Direct live-tmux chat to a peer. Resolves the peer/alias to a live local
    # tmux session and delegates to plan 009's `session say`, sharing all its
    # flags (--body-file, --no-submit, --json, --force-busy). Never touches the
    # mailbox: no data/messages.jsonl write, no status change, no nudge metadata.
    local identity="${1:-}" json=false
    if [[ -z "$identity" || "$identity" == -* ]]; then
        if _arg_has_json "$@"; then
            _session_say_json false "" false validation "peer name required"
        else
            echo -e "${RED}Usage: cctrl peer say <peer> [--no-submit] [--force-busy] [--body-file PATH|-] [--json] -- <message>${RESET}" >&2
        fi
        return 64
    fi
    shift
    _arg_has_json "$@" && json=true

    # peer say is direct chat with no sender identity; --as/--from belong to the
    # mailbox path (peer send). Reject them here with a clear message rather than
    # leaking session say's "Unknown session say flag" error. Stop scanning at
    # `--` so a message body that mentions --as/--from is not misread as a flag.
    local _a
    for _a in "$@"; do
        [[ "$_a" == "--" ]] && break
        case "$_a" in
            --as|--from)
                if $json; then
                    _session_say_json false "" false validation "peer say takes no $_a (direct chat has no sender identity); use 'peer send' for durable mailbox delivery"
                else
                    echo -e "${RED}peer say takes no $_a — direct chat has no sender identity.${RESET}" >&2
                    echo -e "${DIM}Use 'cctrl peer send <peer> --from <you> ...' for durable mailbox delivery.${RESET}" >&2
                fi
                return 64 ;;
        esac
    done

    local rc=0; _peer_direct_resolve "$identity" || rc=$?
    if (( rc != 0 )); then
        if $json; then
            _session_say_json false "$PEER_DIRECT_TARGET" false "$PEER_DIRECT_STATUS" "$PEER_DIRECT_REASON"
        else
            _peer_direct_print_error say
        fi
        return $rc
    fi
    _session_say "$PEER_DIRECT_TARGET" "$@"
}

_peer_cmd_resolve() {
    local target="${1:-}" json=false peer_json a
    [[ -n "$target" ]] || { echo -e "${RED}Usage: cctrl peer resolve <name-or-alias> [--json]${RESET}" >&2; return 1; }
    shift
    for a in "$@"; do
        case "$a" in
            --json) json=true ;;
            *)
                echo -e "${RED}Unknown peer resolve flag: $a${RESET}" >&2
                return 1 ;;
        esac
    done
    peer_json="$(_peer_resolve_json "$target")" || return 1
    if $json; then
        jq '.' <<< "$peer_json"
        return
    fi
    if [[ "$(jq -r '.shadows // empty' <<< "$peer_json")" != "" ]]; then
        echo -e "${YELLOW}Manual peer shadows live tmux session: $(jq -r '.shadows' <<< "$peer_json").${RESET}" >&2
    fi
    jq '.' <<< "$peer_json" | _peer_print_human
}

_peer_cmd_whoami() {
    local json=false identity="" a peer_json
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { echo -e "${RED}--as needs a peer name${RESET}" >&2; return 1; }
                identity="$2"; shift 2 ;;
            --json)
                json=true; shift ;;
            *)
                echo -e "${RED}Unknown peer whoami flag: $1${RESET}" >&2
                return 1 ;;
        esac
    done
    [[ -n "$identity" ]] || identity="${CCTRL_PEER:-}"
    if [[ -z "$identity" ]]; then
        echo -e "${RED}No peer identity provided.${RESET}" >&2
        echo -e "${DIM}Use: cctrl peer whoami --as <peer>  or set CCTRL_PEER.${RESET}" >&2
        return 1
    fi
    peer_json="$(_peer_resolve_json "$identity")" || return 1
    if $json; then
        jq '.' <<< "$peer_json"
    else
        echo -e "${BOLD}Peer Identity${RESET}"
        jq '.' <<< "$peer_json" | _peer_print_human
    fi
}

# Agent-facing operating contract (plan 011). Tells an agent WHEN to direct-chat a
# live tmux peer (`peer say`), when to queue durable async work (`peer send`), and
# how to drain the mailbox (`peer recv` / `peer ack`). A bare call prints GENERIC
# guidance and NEVER fails for a missing identity; `--as NAME` / `CCTRL_PEER`
# canonicalize the peer through the shared resolver (no lookup is reimplemented
# here) and tailor the examples. This contract is deliberately NOT auto-injected
# into `start --peer`: agents receive it only on request, via a user prompt, or
# through the MCP tool surface.
_peer_cmd_help_agent() {
    local json=false identity="" peer_json canonical=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { echo -e "${RED}--as needs a peer name${RESET}" >&2; return 1; }
                identity="$2"; shift 2 ;;
            --json) json=true; shift ;;
            *)
                echo -e "${RED}Unknown peer help-agent flag: $1${RESET}" >&2
                return 1 ;;
        esac
    done
    [[ -n "$identity" ]] || identity="${CCTRL_PEER:-}"
    if [[ -n "$identity" ]]; then
        if ! peer_json="$(_peer_resolve_json "$identity" 2>/dev/null)"; then
            if $json; then
                jq -n --arg id "$identity" '{ok:false,error:{code:"unknown-peer",message:("Unknown or ambiguous peer: " + $id)}}'
            else
                echo -e "${RED}Unknown or ambiguous peer: '$identity'${RESET}" >&2
                echo -e "${DIM}Run 'cctrl peer help-agent' (no --as) for generic guidance, or register the peer first.${RESET}" >&2
            fi
            return 1
        fi
        canonical="$(jq -r '.name' <<< "$peer_json")"
    fi
    if $json; then
        _peer_help_agent_json "$canonical"
    else
        _peer_help_agent_human "$canonical"
    fi
}

_peer_help_agent_human() {
    local peer="$1" sendfrom
    if [[ -n "$peer" ]]; then
        sendfrom="--from $peer "
        echo -e "${BOLD}Peer operating contract${RESET} — you are running as peer: ${BOLD}${peer}${RESET}"
    else
        sendfrom="--from <you> "
        echo -e "${BOLD}Peer operating contract${RESET} — no identity set (pass --as NAME or set CCTRL_PEER for tailored examples)"
    fi
    echo "  Live tmux chat (acts now, writes no mailbox message):"
    echo "    cctrl peer say <peer> -- \"<message>\""
    echo "  Durable async work (survives the peer being away/offline):"
    echo "    cctrl peer send <peer> ${sendfrom}-- \"<message>\""
    echo "  Drain your mailbox:"
    echo "    cctrl peer recv --json        # read the next queued/delivered message"
    echo "    cctrl peer ack <id> --json    # mark it handled once you have acted"
    echo -e "${DIM}Default rule: use 'peer say' for a live tmux agent you want to act now; use 'peer send' for durable/offline async work.${RESET}"
    echo -e "${DIM}No auto-injection: 'cctrl start --peer' does not inject this contract; you receive it only via 'cctrl peer help-agent', a user prompt, or MCP tool metadata.${RESET}"
}

_peer_help_agent_json() {
    local peer="$1"
    jq -n --arg peer "$peer" '
      ($peer | if . == "" then null else . end) as $p
      | {
          ok: true,
          peer: $p,
          generic: ($p == null),
          default_rule: "Use `peer say` for a live tmux agent you want to act now; use `peer send` for durable async work that must survive the recipient being away.",
          auto_injection: false,
          auto_injection_note: "cctrl start --peer does not auto-inject this contract; an agent receives it only via an explicit `cctrl peer help-agent` call, a user prompt, or MCP tool metadata.",
          commands: {
            say: {
              transport: "live-tmux",
              mailbox: false,
              when: "The peer is a live tmux session and you want it to act now.",
              example: "cctrl peer say <peer> -- \"<message>\""
            },
            send: {
              transport: "mailbox",
              mailbox: true,
              when: "Durable async work that must survive the peer being away/offline.",
              example: ("cctrl peer send <peer> --from " + ($p // "<you>") + " -- \"<message>\"")
            },
            recv: {
              transport: "mailbox",
              mailbox: true,
              when: "Read the next queued or delivered-unacked message addressed to you.",
              example: "cctrl peer recv --json"
            },
            ack: {
              transport: "mailbox",
              mailbox: true,
              when: "Mark a delivered message handled so it stops reappearing.",
              example: "cctrl peer ack <id> --json"
            }
          }
        }'
}

# Single-enumeration orientation entry point (plan 025). Answers "who am I, who
# can I reach, do I have mail?" from ONE _peer_all_json resolution. It deliberately
# does NOT call _peer_cmd_whoami / _peer_cmd_check / _mailbox_resolve_identity_for_mode
# — each of those re-enters _peer_all_json -> _session_list and walks tmux again,
# which would defeat the whole point (three enumerations for one answer). Identity
# is resolved locally against the single document; the MCP `peer_overview` tool is a
# thin passthrough to `peer overview --json`.
_peer_cmd_overview() {
    local as_identity="" json=false fleet=false identity doc matches count peer_json messages
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --json)
                json=true; shift ;;
            --fleet)
                fleet=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer overview flag: $1" || echo -e "${RED}Unknown peer overview flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    identity="$as_identity"
    [[ -n "$identity" ]] || identity="${CCTRL_PEER:-}"
    if [[ -z "$identity" ]]; then
        if $json; then _json_error "missing-identity" "Use --as <peer> or set CCTRL_PEER."; return 66; fi
        echo -e "${RED}No peer identity provided.${RESET}" >&2
        echo -e "${DIM}Use: cctrl peer overview --as <peer>  or set CCTRL_PEER.${RESET}" >&2
        return 1
    fi

    # ONE enumeration. Everything below is derived from $doc.
    doc="$(_peer_all_json)" || return 1

    if $fleet; then
        local remote_peers
        remote_peers="$(_peer_fleet_peers)"
        if [[ -n "$remote_peers" && "$remote_peers" != "[]" ]]; then
            doc="$(jq -c --slurpfile remote <(echo "$remote_peers") '
                .peers = (.peers + $remote[0])
                | .fleet = true
            ' <<< "$doc")"
        fi
    fi

    # Resolve identity against the single document (mirrors _peer_resolve_json's
    # matching without a second _peer_all_json walk).
    matches="$(jq -c --arg n "$identity" '[ .peers[] | select(.name == $n or ((.aliases // []) | index($n))) ]' <<< "$doc")"
    count="$(jq -r 'length' <<< "$matches")"
    if [[ "$count" == "0" ]]; then
        if $json; then _json_error "unknown-peer" "Unknown peer: $identity"; return 66; fi
        echo -e "${RED}Unknown peer: '$identity'${RESET}" >&2
        echo -e "${DIM}Register it with: cctrl peer register $identity --dir <path> --agent <agent>${RESET}" >&2
        return 1
    fi
    if (( count > 1 )); then
        if $json; then _json_error "ambiguous-peer" "Ambiguous peer identity: $identity"; return 66; fi
        echo -e "${RED}Ambiguous peer identity: '$identity'${RESET}" >&2
        jq -r '.[] | "  - " + .name + " (" + .source + ")"' <<< "$matches" >&2
        return 1
    fi
    peer_json="$(jq -c '.[0]' <<< "$matches")"
    identity="$(jq -r '.name' <<< "$peer_json")"

    # Mailbox summary for the canonical identity, reusing `peer check`'s shape.
    _mailbox_read_json_or_error "$json" || return $?
    messages="$MAILBOX_MESSAGES"

    local overview
    overview="$(jq -n \
        --argjson identity "$peer_json" \
        --argjson doc "$doc" \
        --argjson messages "$messages" \
        --arg who "$identity" '
        ($messages | map(select(.to == $who))) as $mine
        | {
            identity: $identity,
            peers: ($doc.peers // []),
            mailbox: {
              queued: ([$mine[] | select(.status == "queued")] | length),
              delivered_unacked: ([$mine[] | select(.status == "delivered")] | length),
              oldest_queued_age_seconds: (
                [$mine[] | select(.status == "queued") | .created_at]
                | if length == 0 then null else ((now - (min | fromdateiso8601)) | floor) end
              )
            },
            derived_skipped: ($doc.derived_skipped // false),
            derived_skip_reason: ($doc.derived_skip_reason // null),
            fleet: ($doc.fleet // false)
          }')"

    if $json; then
        printf '%s\n' "$overview"
        return
    fi

    if [[ "$(jq -r '.derived_skipped' <<< "$overview")" == "true" ]]; then
        echo -e "${YELLOW}Derived tmux peer discovery skipped: $(jq -r '.derived_skip_reason' <<< "$overview").${RESET}" >&2
    fi
    echo -e "${BOLD}Peer Overview${RESET}"
    jq -r '
        "  identity: " + .identity.name
        + "\n  peers reachable: " + (.peers | length | tostring)
        + "\n  mailbox: queued=" + (.mailbox.queued | tostring)
        + " delivered_unacked=" + (.mailbox.delivered_unacked | tostring)
        + " oldest_queued_age_seconds=" + (.mailbox.oldest_queued_age_seconds | tostring)
    ' <<< "$overview"
}

_mailbox_init() {
    mkdir -p "$(dirname "$MESSAGES_FILE")"
    [[ -f "$MESSAGES_FILE" ]] || : > "$MESSAGES_FILE"
}

_mailbox_lock_path() {
    printf '%s.lock' "$MESSAGES_FILE"
}

_pid_alive() {
    local pid="${1:-}"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    kill -0 "$pid" 2>/dev/null
}

_mailbox_lock_acquire() {
    mkdir -p "$(dirname "$MESSAGES_FILE")"
    local lock_path start now timeout pid
    lock_path="$(_mailbox_lock_path)"
    timeout="${CCTRL_MAILBOX_LOCK_TIMEOUT:-10}"
    start="$(date +%s)"

    if command -v shlock >/dev/null 2>&1 && [[ "${CCTRL_MAILBOX_LOCK_KIND:-auto}" != "dir" ]]; then
        while ! shlock -p "$$" -f "$lock_path" 2>/dev/null; do
            now="$(date +%s)"
            if (( now - start >= timeout )); then
                echo -e "${RED}Timed out waiting for mailbox lock.${RESET}" >&2
                return 1
            fi
            sleep 0.1
        done
        MAILBOX_LOCK_HELD="$lock_path"
        MAILBOX_LOCK_KIND="file"
        return 0
    fi

    while ! mkdir "$lock_path" 2>/dev/null; do
        if [[ -f "$lock_path/pid" ]]; then
            pid="$(cat "$lock_path/pid" 2>/dev/null || true)"
            if ! _pid_alive "$pid"; then
                rm -rf "$lock_path" 2>/dev/null || true
                continue
            fi
        else
            rm -rf "$lock_path" 2>/dev/null || true
            continue
        fi
        now="$(date +%s)"
        if (( now - start >= timeout )); then
            echo -e "${RED}Timed out waiting for mailbox lock held by PID ${pid:-unknown}.${RESET}" >&2
            return 1
        fi
        sleep 0.1
    done
    printf '%s\n' "$$" > "$lock_path/pid"
    date -u +"%Y-%m-%dT%H:%M:%SZ" > "$lock_path/created_at" 2>/dev/null || true
    MAILBOX_LOCK_HELD="$lock_path"
    MAILBOX_LOCK_KIND="dir"
}

_mailbox_lock_release() {
    local lock_path="${MAILBOX_LOCK_HELD:-}"
    [[ -n "$lock_path" ]] || return 0
    case "${MAILBOX_LOCK_KIND:-}" in
        file) rm -f "$lock_path" ;;
        dir) rm -rf "$lock_path" ;;
    esac
    unset MAILBOX_LOCK_HELD MAILBOX_LOCK_KIND
}

_mailbox_read_json() {
    _mailbox_init
    if [[ ! -s "$MESSAGES_FILE" ]]; then
        printf '[]\n'
        return
    fi
    jq -s '.' "$MESSAGES_FILE"
}

_mailbox_rewrite_json_locked() {
    local messages_json="$1" tmp
    tmp="$(mktemp)"
    jq -c '.[]' <<< "$messages_json" > "$tmp" && mv "$tmp" "$MESSAGES_FILE"
}

_mailbox_generate_id_locked() {
    local stamp rand id
    while true; do
        stamp="$(date -u +"%Y%m%d_%H%M%S")"
        rand="$(od -An -N3 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n')"
        [[ -n "$rand" ]] || rand="$(printf '%06x' "$((RANDOM % 16777216))")"
        id="msg_${stamp}_${rand}"
        if ! jq -e --arg id "$id" 'select(.id == $id)' "$MESSAGES_FILE" >/dev/null 2>&1; then
            printf '%s\n' "$id"
            return
        fi
    done
}

_mailbox_validate_label() {
    local kind="$1" value="${2:-}" allow_user="${3:-false}"
    if [[ "$allow_user" == "true" && "$value" == "user" ]]; then
        return 0
    fi
    _peer_validate_label "$kind" "$value"
}

_mailbox_peer_known() {
    local name="$1" allow_user="${2:-false}"
    [[ "$allow_user" == "true" && "$name" == "user" ]] && return 0
    _peer_resolve_json "$name" >/dev/null 2>&1
}

_mailbox_require_peer() {
    local role="$1" name="$2" allow_user="${3:-false}"
    _mailbox_validate_label "$role" "$name" "$allow_user" || return 1
    if ! _mailbox_peer_known "$name" "$allow_user"; then
        echo -e "${RED}Unknown $role: '$name'${RESET}" >&2
        echo -e "${DIM}Register it first, or use --allow-unknown for peer send.${RESET}" >&2
        return 1
    fi
}

_mailbox_resolve_identity() {
    local explicit="$1" env_identity="${CCTRL_PEER:-}" identity
    identity="$explicit"
    [[ -n "$identity" ]] || identity="$env_identity"
    if [[ -z "$identity" ]]; then
        echo -e "${RED}No peer identity provided.${RESET}" >&2
        echo -e "${DIM}Use --as <peer> or set CCTRL_PEER.${RESET}" >&2
        return 1
    fi
    _mailbox_require_peer "peer" "$identity" false || return 1
    _peer_resolve_json "$identity" | jq -r '.name'
}

_mailbox_status_filter_json() {
    local status_csv="${1:-}" default_csv="${2:-}" effective status
    effective="$status_csv"
    [[ -n "$effective" ]] || effective="$default_csv"
    if [[ -z "$effective" ]]; then
        printf '[]\n'
        return
    fi
    printf '%s\n' "$effective" | tr ',' '\n' | while IFS= read -r status; do
        status="${status//[[:space:]]/}"
        [[ -n "$status" ]] && printf '%s\n' "$status"
    done | jq -R . | jq -s 'unique'
}

_mailbox_print_messages_human() {
    # Fixed template (inbox/outbox). Show the human sender label when the durable
    # snapshot carries one (plan 023), falling back to the bare `from` address for
    # legacy messages that predate the `sender` field.
    jq -r '
        .[]
        | "\(.id)  \(.status)  \(.sender.label // .from) -> \(.to)  \(.subject // "")"
    '
}

_json_error() {
    local code="$1" message="$2"
    jq -n --arg code "$code" --arg message "$message" \
        '{ok:false,error:{code:$code,message:$message}}'
}

_arg_has_json() {
    local arg
    for arg in "$@"; do
        [[ "$arg" == "--json" ]] && return 0
    done
    return 1
}

_read_body_file() {
    local path="$1" body sentinel=$'\037' tmp tmperr err rc=0
    MAILBOX_BODY=""
    MAILBOX_BODY_READ_ERROR=""
    tmp="$(mktemp)" || {
        MAILBOX_BODY_READ_ERROR="Could not create temporary body file."
        return 1
    }
    tmperr="$(mktemp)" || {
        rm -f "$tmp"
        MAILBOX_BODY_READ_ERROR="Could not create temporary body error file."
        return 1
    }
    if [[ "$path" == "-" ]]; then
        if cat > "$tmp" 2>"$tmperr"; then
            :
        else
            rc=$?
            err="$(cat "$tmperr" 2>/dev/null || true)"
            MAILBOX_BODY_READ_ERROR="Failed to read body from stdin."
            [[ -n "$err" ]] && MAILBOX_BODY_READ_ERROR+=" $err"
            rm -f "$tmp" "$tmperr"
            return "$rc"
        fi
    else
        if cat "$path" > "$tmp" 2>"$tmperr"; then
            :
        else
            rc=$?
            err="$(cat "$tmperr" 2>/dev/null || true)"
            MAILBOX_BODY_READ_ERROR="Failed to read body file: $path"
            [[ -n "$err" ]] && MAILBOX_BODY_READ_ERROR+=" $err"
            rm -f "$tmp" "$tmperr"
            return "$rc"
        fi
    fi
    body="$(cat "$tmp"; printf '%s' "$sentinel")"
    rm -f "$tmp" "$tmperr"
    MAILBOX_BODY="${body%$sentinel}"
}

_mailbox_read_json_or_error() {
    local json="${1:-false}" messages
    if messages="$(_mailbox_read_json 2>/dev/null)"; then
        MAILBOX_MESSAGES="$messages"
        return 0
    fi
    if [[ "$json" == "true" ]]; then
        _json_error "mailbox-corrupt" "Mailbox data is not valid JSONL."
    else
        echo -e "${RED}Mailbox data is not valid JSONL: $MESSAGES_FILE${RESET}" >&2
    fi
    return 65
}

_mailbox_resolve_identity_for_mode() {
    local explicit="$1" json="${2:-false}" identity
    identity="$explicit"
    [[ -n "$identity" ]] || identity="${CCTRL_PEER:-}"
    if [[ -z "$identity" ]]; then
        if [[ "$json" == "true" ]]; then
            _json_error "missing-identity" "Use --as <peer> or set CCTRL_PEER."
            return 66
        fi
        echo -e "${RED}No peer identity provided.${RESET}" >&2
        echo -e "${DIM}Use --as <peer> or set CCTRL_PEER.${RESET}" >&2
        return 1
    fi
    if [[ ! "$identity" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$identity" == "user" ]]; then
        if [[ "$json" == "true" ]]; then
            _json_error "validation" "Invalid peer identity: $identity"
            return 64
        fi
        _mailbox_validate_label "peer" "$identity" false
        return 1
    fi
    local peer_json
    if ! peer_json="$(_peer_resolve_json "$identity" 2>/dev/null)"; then
        if [[ "$json" == "true" ]]; then
            _json_error "unknown-peer" "Unknown peer: $identity"
            return 66
        fi
        _mailbox_require_peer "peer" "$identity" false
        return 1
    fi
    MAILBOX_RESOLVED_IDENTITY="$(jq -r '.name' <<< "$peer_json")"
    # Stash the current occupant's created_at so read paths (recv, inbox) can
    # apply the addressee guard without re-resolving. Empty when the peer carries
    # no stamp (manual peer) — the guard treats that as absence and delivers.
    MAILBOX_RESOLVED_PEER_CREATED="$(jq -r '.created_at // ""' <<< "$peer_json")"
}

_peer_cmd_send() {
    local to="${1:-}"
    [[ -n "$to" ]] || { echo -e "${RED}Usage: cctrl peer send <to> [--from NAME] [--subject TEXT] [--body-file PATH|-] [--allow-unknown] [--deliver] [--json] -- <body>${RESET}" >&2; return 64; }
    shift

    local from="" as_identity="" subject="" body="" body_file="" json=false allow_unknown=false saw_body=false deliver=false sender_host_override=""
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--from needs a value" || echo -e "${RED}--from needs a value${RESET}" >&2; return 64; }
                from="$2"; shift 2 ;;
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --subject)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--subject needs a value" || echo -e "${RED}--subject needs a value${RESET}" >&2; return 64; }
                subject="$2"; shift 2 ;;
            --body-file)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--body-file needs a value" || echo -e "${RED}--body-file needs a value${RESET}" >&2; return 64; }
                body_file="$2"; shift 2 ;;
            --sender-host)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--sender-host needs a value" || echo -e "${RED}--sender-host needs a value${RESET}" >&2; return 64; }
                sender_host_override="$2"; shift 2 ;;
            --allow-unknown)
                allow_unknown=true; shift ;;
            --deliver)
                deliver=true; shift ;;
            --json)
                json=true; shift ;;
            --)
                shift
                body="$*"
                saw_body=true
                break ;;
            *)
                $json && _json_error "validation" "Unknown peer send flag: $1" || echo -e "${RED}Unknown peer send flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    if [[ -n "$body_file" ]]; then
        if $saw_body; then
            $json && _json_error "validation" "Use either --body-file or -- <body>, not both." || echo -e "${RED}Use either --body-file or -- <body>, not both.${RESET}" >&2
            return 64
        fi
        if [[ "$body_file" == "-" ]]; then
            if ! _read_body_file -; then
                $json && _json_error "validation" "${MAILBOX_BODY_READ_ERROR:-Failed to read body from stdin.}" || echo -e "${RED}${MAILBOX_BODY_READ_ERROR:-Failed to read body from stdin.}${RESET}" >&2
                unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
                return 64
            fi
            body="$MAILBOX_BODY"
        elif [[ -f "$body_file" ]]; then
            if ! _read_body_file "$body_file"; then
                $json && _json_error "validation" "${MAILBOX_BODY_READ_ERROR:-Failed to read body file: $body_file}" || echo -e "${RED}${MAILBOX_BODY_READ_ERROR:-Failed to read body file: $body_file}${RESET}" >&2
                unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
                return 64
            fi
            body="$MAILBOX_BODY"
        else
            $json && _json_error "validation" "Body file not found: $body_file" || echo -e "${RED}Body file not found: $body_file${RESET}" >&2
            return 64
        fi
        unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
        saw_body=true
    fi
    if ! $saw_body; then
        $json && _json_error "validation" "peer send needs --body-file or a body after --." || echo -e "${RED}peer send needs --body-file or a body after --.${RESET}" >&2
        return 64
    fi

    # `--deliver` (plan 027): send, then attempt delivery, then classify the
    # outcome — routed through the same shared helper as `peer reply` so the
    # send/deliver failure semantics live in exactly one place. The plain path
    # below is left byte-for-byte untouched.
    if $deliver; then
        if $allow_unknown; then
            $json && _json_error "validation" "--allow-unknown cannot be combined with --deliver: an unresolvable recipient cannot be delivered to." || echo -e "${RED}--allow-unknown cannot be combined with --deliver: an unresolvable recipient cannot be delivered to.${RESET}" >&2
            return 64
        fi
        local -a send_flags=()
        [[ -n "$from" ]] && send_flags+=(--from "$from")
        [[ -n "$as_identity" ]] && send_flags+=(--as "$as_identity")
        [[ -n "$subject" ]] && send_flags+=(--subject "$subject")
        [[ -n "$sender_host_override" ]] && send_flags+=(--sender-host "$sender_host_override")
        _peer_all_json_cache_begin >/dev/null 2>&1 || true
        _peer_send_and_deliver "$to" "$body" ${send_flags[@]+"${send_flags[@]}"} || true
        local _sd_rc=$PEER_SD_RC
        _peer_send_deliver_emit "$json" "${PEER_SD_TO:-$to}" send
        _peer_all_json_cache_end
        return "$_sd_rc"
    fi

    if [[ -z "$from" ]]; then
        if [[ -n "$as_identity" || -n "${CCTRL_PEER:-}" ]]; then
            _mailbox_resolve_identity_for_mode "$as_identity" "$json" || return $?
            from="$MAILBOX_RESOLVED_IDENTITY"
        elif $json; then
            _json_error "missing-identity" "Use --from NAME, --as NAME, CCTRL_PEER, or --allow-unknown."
            return 66
        elif [[ -t 0 && -t 1 ]]; then
            from="user"
        else
            echo -e "${RED}No sender identity provided.${RESET}" >&2
            echo -e "${DIM}Use --from NAME, --as NAME, or CCTRL_PEER.${RESET}" >&2
            return 1
        fi
    fi

    local unknown_peer=false to_peer_json="" from_peer_json=""
    if ! _mailbox_validate_label "recipient" "$to" false >/dev/null 2>&1; then
        $json && _json_error "validation" "Invalid recipient: $to" || _mailbox_validate_label "recipient" "$to" false
        return 64
    fi
    if ! _mailbox_validate_label "sender" "$from" true >/dev/null 2>&1; then
        $json && _json_error "validation" "Invalid sender: $from" || _mailbox_validate_label "sender" "$from" true
        return 64
    fi
    if ! $allow_unknown; then
        if ! to_peer_json="$(_peer_resolve_json "$to" 2>/dev/null)"; then
            $json && _json_error "unknown-peer" "Unknown recipient: $to" || _mailbox_require_peer "recipient" "$to" false
            return 66
        fi
        to="$(jq -r '.name' <<< "$to_peer_json")"
        if [[ "$from" == "user" ]]; then
            :
        elif ! from_peer_json="$(_peer_resolve_json "$from" 2>/dev/null)"; then
            $json && _json_error "unknown-peer" "Unknown sender: $from" || _mailbox_require_peer "sender" "$from" true
            return 66
        else
            from="$(jq -r '.name' <<< "$from_peer_json")"
        fi
    else
        to_peer_json="$(_peer_resolve_json "$to" 2>/dev/null || true)"
        if [[ "$from" == "user" ]]; then
            from_peer_json=""
        else
            from_peer_json="$(_peer_resolve_json "$from" 2>/dev/null || true)"
        fi
        if [[ -z "$to_peer_json" || ( "$from" != "user" && -z "$from_peer_json" ) ]]; then
            unknown_peer=true
        fi
        [[ -n "$to_peer_json" ]] && to="$(jq -r '.name' <<< "$to_peer_json")"
        if [[ "$from" != "user" && -n "$from_peer_json" ]]; then
            from="$(jq -r '.name' <<< "$from_peer_json")"
        fi
    fi

    # Durable sender snapshot (plan 023): capture who sent this at send time so a
    # receiver keeps unambiguous identity even after the sender's ephemeral tmux
    # session closes. Purely additive — `from` above is untouched. Field presence
    # is per sender class: a fully resolved peer carries the full object; `user`
    # carries only name+label; an unresolved --allow-unknown sender carries name.
    local sender_json
    if [[ "$from" == "user" ]]; then
        sender_json="$(jq -cn --arg name "$from" '{name: $name, label: $name}')"
    elif [[ -n "$from_peer_json" ]]; then
        # Prefer the host recorded in the sender's session metadata (the host the
        # session was created on) over the peer object's `host`, which is stamped
        # from the ambient CCTRL_HOST_PREFIX of whoever runs this command.
        local sender_session meta_host=""
        sender_session="$(jq -r '.session // .tmux_target // empty' <<< "$from_peer_json")"
        [[ -n "$sender_session" ]] && meta_host="$(_session_metadata_field "$sender_session" host 2>/dev/null)"
        sender_json="$(jq -cn --argjson peer "$from_peer_json" --arg name "$from" --arg meta_host "$meta_host" '
            {
              name: $name,
              label: (($peer.display_label | select(. != null and . != ""))
                      // ($peer.purpose | select(. != null and . != ""))
                      // $name),
              tmux_target: $peer.tmux_target,
              agent: $peer.agent,
              host: (($meta_host | select(. != "")) // $peer.host)
            }
            | with_entries(select(.value != null))')"
    else
        sender_json="$(jq -cn --arg name "$from" '{name: $name}')"
    fi
    if [[ -n "$sender_host_override" ]]; then
        sender_json="$(jq -c --arg h "$sender_host_override" '. + {host: $h}' <<< "$sender_json")"
    fi

    _mailbox_lock_acquire || return 1
    local now id message rc=0
    if ! {
        _mailbox_init
        now="$(_peer_now_utc)"
        id="$(_mailbox_generate_id_locked)"
        message="$(jq -cn \
            --arg id "$id" \
            --arg from "$from" \
            --arg to "$to" \
            --arg subject "$subject" \
            --arg body "$body" \
            --arg now "$now" \
            --argjson unknown "$unknown_peer" \
            --argjson sender "$sender_json" \
            '{
              id: $id,
              from: $from,
              to: $to,
              status: "queued",
              subject: $subject,
              body: $body,
              sender: $sender,
              created_at: $now,
              updated_at: $now,
              delivered_at: null,
              acked_at: null,
              nudge_count: 0,
              last_nudge_at: null,
              last_nudge_error: null,
              history: [{at: $now, status: "queued", by: $from}]
            } + (if $unknown then {unknown_peer: true} else {} end)')"
        printf '%s\n' "$message" >> "$MESSAGES_FILE"
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 0 ]] || return $rc

    if $json; then
        jq '.' <<< "$message"
    else
        echo -e "${GREEN}Queued message: ${BOLD}$id${RESET}"
    fi
}

_peer_cmd_inbox() {
    local as_identity="" status_csv="" json=false a identity messages statuses
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
