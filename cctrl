_hooks_run() {
    local name="${1:-}"
    if [[ -z "$name" || "$name" == "-h" || "$name" == "--help" ]]; then
        echo "Usage: cctrl hooks run <name>"
        echo ""
        echo "  pre-tool-use   Block disallowed tool calls (stdin passthrough)"
        echo "  stop           Post-turn logging and notifications"
        echo "  notify         Push notification on agent events"
        echo "  codex-observe  Observe bounded Codex lifecycle payloads (fail-open registry write)"
        return 0
    fi

    case "$name" in
        pre-tool-use)
            exec python3 "$SCRIPT_DIR/hooks/block-git-commit.py"
            ;;
        stop)
            "$SCRIPT_DIR/hooks/notify.sh" stop
            python3 "$SCRIPT_DIR/hooks/session-log.py"
            ;;
        notify)
            exec "$SCRIPT_DIR/hooks/notify.sh" notification
            ;;
        codex-observe)
            CCTRL_BIN="$SCRIPT_DIR/cctrl" exec python3 "$SCRIPT_DIR/hooks/codex-session-observer.py"
            ;;
        *)
            echo -e "${RED}Unknown hook: $name${RESET}" >&2
            echo -e "${DIM}Available: pre-tool-use, stop, notify, codex-observe${RESET}" >&2
            return 1
            ;;
    esac
}

_hooks_install() {
    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        echo "Usage: cctrl hooks install"
        echo ""
        echo "  Write portable hook configs for Claude Code and Codex."
        echo "  Uses 'cctrl hooks run <name>' so hooks survive cctrl moves."
        echo "  Idempotent — safe to run repeatedly."
        return 0
    fi

    local cctrl_bin
    cctrl_bin="$(command -v cctrl 2>/dev/null || true)"
    if [[ -z "$cctrl_bin" ]]; then
        echo -e "${YELLOW}Warning: cctrl is not on \$PATH.${RESET}"
        echo -e "${DIM}Hooks will use the full path ($SCRIPT_DIR/cctrl) as fallback.${RESET}"
        echo -e "${DIM}Add cctrl to \$PATH for truly portable hooks.${RESET}"
        echo ""
    fi

    local errors=0

    # --- Claude Code ---
    local claude_dir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    local claude_settings="$claude_dir/settings.json"
    if [[ -d "$claude_dir" ]]; then
        if python3 -c "
import json, sys, os

