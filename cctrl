    fi
    if ! peer_json="$(_peer_resolve_json "$identity" 2>/dev/null)"; then
        echo "cctrl peer mcp could not resolve peer identity: $identity" >&2
        return 66
    fi
    identity="$(jq -r '.name' <<< "$peer_json")"
    exec python3 "$SCRIPT_DIR/lib/peer_mcp.py" --as "$identity" --cctrl "$SCRIPT_DIR/cctrl"
}

