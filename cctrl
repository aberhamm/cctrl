Path(result_path).write_text(json.dumps(document,sort_keys=True,separators=(",",":"))+"\n",encoding="utf-8")
with open(events_path,"w",encoding="utf-8") as handle:
    for row in event_rows: handle.write(json.dumps(row,sort_keys=True,separators=(",",":"))+"\n")
PY
    then
        rm -rf "$scratch"
        echo "Could not construct reconciliation evidence snapshot" >&2
        return 65
    fi

    # Materialize and validate every event before the first registry write.
    if ! python3 - "$events_file" "$scratch" > "$scratch/event-manifest.tsv" <<'PY'
import json,sys
from pathlib import Path
source, root=sys.argv[1],Path(sys.argv[2])
for index,line in enumerate(open(source,encoding="utf-8")):
    row=json.loads(line)
    if not isinstance(row,dict) or not isinstance(row.get("record_key"),str) or not isinstance(row.get("event"),dict):
        raise SystemExit(1)
    path=root/f"event-{index}.json"
    path.write_text(json.dumps(row["event"],sort_keys=True,separators=(",",":"))+"\n",encoding="utf-8")
    print(f"{row['record_key']}\t{path}")
PY
    then
        rm -rf "$scratch"
        echo "Could not materialize reconciliation registry events" >&2
        return 65
    fi

    if ! $dry_run; then
        while IFS=$'\t' read -r record_key event_path; do
            if result="$(_task_registry_apply_event "$record_key" "$event_path")"; then
                status="$(jq -r '.status // empty' <<< "$result")"
                case "$status" in
                    applied|duplicate) ;;
                    stale) echo "reconcile-codex: stale digest rejected for $record_key" >&2; apply_rc=75 ;;
                    *) echo "reconcile-codex: unexpected registry status for $record_key: $status" >&2; apply_rc=75 ;;
                esac
            else
                echo "reconcile-codex: registry apply failed for $record_key" >&2
                apply_rc=75
            fi
        done < "$scratch/event-manifest.tsv"
    fi

    if $json; then
        cat "$result_file"
    else
        python3 - "$result_file" <<'PY'
import json,sys
d=json.load(open(sys.argv[1],encoding="utf-8"))
print(f"Codex ownership reconciliation {d['pass_id']} ({len(d['records'])} task(s))")
for item in d["records"]:
    outcome=item["chosen_outcome"]
    print(f"  {item['provider_task_id']}: {outcome['control_owner']}/{outcome['execution_runtime']} — {item['reason']}")
PY
    fi
    rm -rf "$scratch"
    return "$apply_rc"
}

