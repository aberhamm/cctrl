cmd_hooks() {
    local action="${1:-help}"; shift 2>/dev/null || true

    case "$action" in
        run) _hooks_run "$@" ;;
        install) _hooks_install "$@" ;;
        doctor) _hooks_doctor "$@" ;;
        -h|--help|help)
            echo "Usage: cctrl hooks <run|install|doctor>"
            echo ""
            echo "  run <name>    Execute a named hook (pre-tool-use, stop, notify, codex-observe)"
            echo "  install       Write portable hook configs for Claude Code and Codex"
            echo "  doctor        Validate hook configs point to working commands"
            return 0
