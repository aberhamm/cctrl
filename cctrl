                return 64 ;;
        esac
    done

    identity="$as_identity"
    [[ -n "$identity" ]] || identity="${CCTRL_PEER:-}"
    if [[ -z "$identity" ]]; then
        echo "cctrl peer mcp needs --as <peer> or CCTRL_PEER" >&2
