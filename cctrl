_peer_cmd_ack() {
    local id="${1:-}" as_identity="" json=false identity messages result updated now rc=0 updated_message=""
    [[ -n "$id" ]] || { echo -e "${RED}Usage: cctrl peer ack <message-id> [--as NAME] [--json]${RESET}" >&2; return 64; }
    shift
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --json)
                json=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer ack flag: $1" || echo -e "${RED}Unknown peer ack flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    _mailbox_resolve_identity_for_mode "$as_identity" "$json" || return $?
    identity="$MAILBOX_RESOLVED_IDENTITY"

    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_init
        _mailbox_read_json_or_error "$json" || rc=$?
        if [[ $rc -ne 0 ]]; then
            :
        else
        messages="$MAILBOX_MESSAGES"
        result="$(jq -r --arg id "$id" --arg who "$identity" '
            ([.[] | select(.id == $id)][0]) as $m
            | if $m == null then "missing"
              elif $m.to != $who then "forbidden"
              elif $m.status == "acked" then "noop"
              elif $m.status == "queued" then "queued"
              elif $m.status == "delivered" then "ack"
              else "invalid:" + ($m.status // "unknown")
              end
        ' <<< "$messages")"
        case "$result" in
            missing)
                $json && _json_error "validation" "Unknown message: $id" || echo -e "${RED}Unknown message: '$id'${RESET}" >&2
                rc=64 ;;
            forbidden)
                $json && _json_error "validation" "Message '$id' is not addressed to '$identity'." || echo -e "${RED}Message '$id' is not addressed to '$identity'.${RESET}" >&2
                rc=64 ;;
            queued)
                $json && _json_error "validation" "Message '$id' is still queued; receive it first (cctrl peer recv)." || echo -e "${RED}Message '$id' is still queued; receive it first (cctrl peer recv).${RESET}" >&2
                rc=64 ;;
            invalid:*)
                $json && _json_error "validation" "Message '$id' cannot be acked from status '${result#invalid:}'." || echo -e "${RED}Message '$id' cannot be acked from status '${result#invalid:}'.${RESET}" >&2
                rc=64 ;;
            noop)
                updated_message="$(jq --arg id "$id" '[.[] | select(.id == $id)][0]' <<< "$messages")"
                rc=0 ;;
            ack)
                now="$(_peer_now_utc)"
                updated="$(jq --arg id "$id" --arg who "$identity" --arg now "$now" '
                    map(
                      if .id == $id then
                        .status = "acked"
                        | .updated_at = $now
                        | .acked_at = $now
                        | .history = ((.history // []) + [{at: $now, status: "acked", by: $who}])
                      else . end
                    )
                ' <<< "$messages")"
                _mailbox_rewrite_json_locked "$updated"
                updated_message="$(jq --arg id "$id" '[.[] | select(.id == $id)][0]' <<< "$updated")"
                rc=0 ;;
        esac
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 0 ]] || return $rc
    if $json; then
        jq -n --argjson message "$updated_message" '{message:$message,status:$message.status}'
    else
        echo -e "${GREEN}Acked message: $id${RESET}"
    fi
}

_peer_cmd_check() {
    local as_identity="" json=false exit_on_empty=false identity messages queued delivered oldest_age
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --json)
                json=true; shift ;;
            --exit-on-empty)
                exit_on_empty=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer check flag: $1" || echo -e "${RED}Unknown peer check flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    _mailbox_resolve_identity_for_mode "$as_identity" "$json" || return $?
    identity="$MAILBOX_RESOLVED_IDENTITY"
    _mailbox_read_json_or_error "$json" || return $?
    messages="$MAILBOX_MESSAGES"
    queued="$(jq -r --arg who "$identity" '[.[] | select(.to == $who and .status == "queued")] | length' <<< "$messages")"
    delivered="$(jq -r --arg who "$identity" '[.[] | select(.to == $who and .status == "delivered")] | length' <<< "$messages")"
    oldest_age="$(jq -r --arg who "$identity" '
        [ .[] | select(.to == $who and .status == "queued") | .created_at ]
        | if length == 0 then null
          else ((now - (min | fromdateiso8601)) | floor)
          end
    ' <<< "$messages")"
    if $json; then
        jq -n --arg peer "$identity" --argjson queued "$queued" --argjson delivered "$delivered" --argjson age "$oldest_age" \
            '{peer:$peer,queued:$queued,delivered_unacked:$delivered,oldest_queued_age_seconds:$age}'
    else
        printf 'Peer: %s\nQueued: %s\nDelivered unacked: %s\nOldest queued age seconds: %s\n' "$identity" "$queued" "$delivered" "$oldest_age"
    fi
    if $exit_on_empty && (( queued == 0 && delivered == 0 )); then
        return 2
    fi
}

_peer_cmd_recv() {
    local as_identity="" status_csv="" json=false exit_on_empty=false identity statuses messages selected_id selected updated rc=0
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --status)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--status needs a value" || echo -e "${RED}--status needs a value${RESET}" >&2; return 64; }
                status_csv="$2"; shift 2 ;;
            --json)
                json=true; shift ;;
            --exit-on-empty)
                exit_on_empty=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer recv flag: $1" || echo -e "${RED}Unknown peer recv flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    _mailbox_resolve_identity_for_mode "$as_identity" "$json" || return $?
    identity="$MAILBOX_RESOLVED_IDENTITY"
    local peer_created="$MAILBOX_RESOLVED_PEER_CREATED" guard
    guard="$(_peer_guard_defs)"
    statuses="$(_mailbox_status_filter_json "$status_csv" "queued,delivered")"

    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_read_json_or_error "$json" || rc=$?
        if [[ $rc -eq 0 ]]; then
            messages="$MAILBOX_MESSAGES"
            # Addressee guard: never read out a message whose current occupant
            # post-dates it (a recycled name). recv is the primary body-handover
            # path, so this is the load-bearing disclosure gate.
            selected_id="$(jq -r --arg who "$identity" --arg peer "$peer_created" --argjson statuses "$statuses" "$guard"'
                def allowed($s): ($statuses | index($s)) != null;
                ([.[] | select(.to == $who and .status == "queued" and allowed("queued") and deliverable($peer))][0].id)
                // ([.[] | select(.to == $who and .status == "delivered" and allowed("delivered") and deliverable($peer))][0].id)
                // empty
            ' <<< "$messages")"
            if [[ -z "$selected_id" ]]; then
                selected="null"
            else
                local current_status now
                current_status="$(jq -r --arg id "$selected_id" '[.[] | select(.id == $id)][0].status' <<< "$messages")"
                if [[ "$current_status" == "queued" ]]; then
                    now="$(_peer_now_utc)"
                    updated="$(jq --arg id "$selected_id" --arg who "$identity" --arg now "$now" '
                        map(
                          if .id == $id then
                            .status = "delivered"
                            | .updated_at = $now
                            | .delivered_at = $now
                            | .history = ((.history // []) + [{at: $now, status: "delivered", by: $who}])
                          else . end
                        )
                    ' <<< "$messages")"
                    _mailbox_rewrite_json_locked "$updated"
                    selected="$(jq --arg id "$selected_id" '[.[] | select(.id == $id)][0]' <<< "$updated")"
                else
                    selected="$(jq --arg id "$selected_id" '[.[] | select(.id == $id)][0]' <<< "$messages")"
                fi
            fi
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 0 ]] || return $rc

    if [[ "$selected" == "null" ]]; then
        if $json; then
            jq -n '{message:null,empty:true}'
        else
            echo "No messages."
        fi
        $exit_on_empty && return 2
        return 0
    fi
    if $json; then
        jq -n --argjson message "$selected" '{message:$message,empty:false}'
    else
        jq '.' <<< "$selected" | _peer_print_human
    fi
}

_peer_nudge_line() {
    local peer="$1" count="$2"
    printf '[cctrl] %s new peer message(s) for %s. Run: cctrl peer recv --as %s --json' "$count" "$peer" "$peer"
}

# Sender envelope prepended to inline peer delivery (plan 024). Renders a compact
# header from the message's sender snapshot (plan 023) so the receiving model can
# see WHO sent the message, reply, and acknowledge — none of which it can do from
# a bare body pasted into its input. Arguments: the message JSON object, the
# delivering peer's canonical name (`recipient`), and a reachability verdict
# (`reach` ∈ live | mailbox-only | unreachable | user) already resolved against
# the SENDER at delivery time. Every command carries `--as <recipient>` because a
# non-interactive agent shell may not export CCTRL_PEER, and a bare command then
# fails identity resolution. The reply line is the atomic `cctrl peer reply`
# (plan 027), which sends AND delivers — never a bare `cctrl peer send`, which
# only queues and silently never reaches the sender. The caller appends the body
# verbatim after the trailing `---` line.
_peer_inline_envelope() {
    local msg_json="$1" recipient="$2" reach="$3"
    local id label name subject
    id="$(jq -r '.id // ""' <<< "$msg_json")"
    subject="$(jq -r '.subject // ""' <<< "$msg_json")"
    # jq `//` treats "" as present, so fall through empty strings explicitly to
    # avoid a blank label when a legacy message carries sender:{label:""}.
    label="$(jq -r '(.sender.label // "") as $l | (.from // "") as $f | if $l != "" then $l else $f end' <<< "$msg_json")"
    name="$(jq -r '(.sender.name // "") as $n | (.from // "") as $f | if $n != "" then $n else $f end' <<< "$msg_json")"

    printf '[cctrl peer message] from: %s (%s) · id: %s\n' "$label" "$name" "$id"
    [[ -n "$subject" ]] && printf 'Subject: %s\n' "$subject"
    case "$reach" in
        user)
            # from == "user": the human operator sent this, not a peer. A
            # `cctrl peer send/reply user` command fails recipient resolution, so
            # direct the reply into the conversation instead.
            printf 'Sender is the human operator — reply in this conversation, not via cctrl.\n' ;;
        unreachable)
            printf 'SENDER IS NO LONGER LIVE — do not reply to this peer.\n' ;;
        *)
            # live or mailbox-only: both are reachable (mailbox-only peers collect
            # their own mail); emit the atomic send-and-deliver reply line.
            printf 'Reply:  cctrl peer reply %s --as %s --json -- "<your reply>"\n' "$id" "$recipient" ;;
    esac
    printf 'Ack:    cctrl peer ack %s --as %s --json\n' "$id" "$recipient"
    printf -- '---\n'
}

_peer_has_capability() {
    local peer_json="$1" capability="$2"
    jq -e --arg c "$capability" '(.capabilities // []) | index($c)' <<< "$peer_json" >/dev/null 2>&1
}

_tmux_run_with_timeout() {
    local timeout="${CCTRL_TMUX_TIMEOUT_SECONDS:-5}" pid start now rc tmpout tmperr
    tmpout="$(mktemp)"
    tmperr="$(mktemp)"
    tmux "$@" >"$tmpout" 2>"$tmperr" &
    pid=$!
    start="$(date +%s)"
    while kill -0 "$pid" 2>/dev/null; do
        now="$(date +%s)"
        if (( now - start >= timeout )); then
            kill "$pid" 2>/dev/null || true
            sleep 0.05
            kill -9 "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            TMUX_RUN_OUTPUT="$(cat "$tmpout" 2>/dev/null || true)"
            TMUX_RUN_ERROR="tmux command timed out after ${timeout}s: tmux $*"
            rm -f "$tmpout" "$tmperr"
            return 124
        fi
        sleep 0.05
    done
    wait "$pid"; rc=$?
    TMUX_RUN_OUTPUT="$(cat "$tmpout" 2>/dev/null || true)"
    TMUX_RUN_ERROR="$(cat "$tmperr" 2>/dev/null || true)"
    rm -f "$tmpout" "$tmperr"
    return $rc
}

_tmux_run_stdin_with_timeout() {
    local input="$1" timeout="${CCTRL_TMUX_TIMEOUT_SECONDS:-5}" pid start now rc tmpin tmpout tmperr
    shift
    tmpin="$(mktemp)"
    tmpout="$(mktemp)"
    tmperr="$(mktemp)"
    printf '%s' "$input" > "$tmpin"
    tmux "$@" <"$tmpin" >"$tmpout" 2>"$tmperr" &
    pid=$!
    start="$(date +%s)"
    while kill -0 "$pid" 2>/dev/null; do
        now="$(date +%s)"
        if (( now - start >= timeout )); then
            kill "$pid" 2>/dev/null || true
            sleep 0.05
            kill -9 "$pid" 2>/dev/null || true
            wait "$pid" 2>/dev/null || true
            TMUX_RUN_OUTPUT="$(cat "$tmpout" 2>/dev/null || true)"
            TMUX_RUN_ERROR="tmux command timed out after ${timeout}s: tmux $*"
            rm -f "$tmpin" "$tmpout" "$tmperr"
            return 124
        fi
        sleep 0.05
    done
    wait "$pid"; rc=$?
    TMUX_RUN_OUTPUT="$(cat "$tmpout" 2>/dev/null || true)"
    TMUX_RUN_ERROR="$(cat "$tmperr" 2>/dev/null || true)"
    rm -f "$tmpin" "$tmpout" "$tmperr"
    return $rc
}

# Pure reachability classifier (plan 027). Maps a peer JSON object to one of
# three reachability classes, printed on stdout:
#   live         — has tmux capability, a target, and a live tmux session
#   mailbox-only — no tmux capability; collects its own mail (polling / MCP)
#   unreachable  — has tmux capability but no target / no tmux / dead session
# "Pure" means it writes NONE of the PEER_DELIVER_* globals: plan 024 consumes
# this for its envelope and must not inherit delivery-side effects. It may run
# tmux `has-session` to distinguish a live pane from a dead one.
_peer_reachability_class() {
    local peer_json="$1" target
    if ! _peer_has_capability "$peer_json" "tmux"; then
        printf 'mailbox-only\n'
        return 0
    fi
    target="$(jq -r '.tmux_target // .session // empty' <<< "$peer_json")"
    if [[ -z "$target" ]]; then
        printf 'unreachable\n'
        return 0
    fi
    if ! command -v tmux >/dev/null 2>&1; then
        printf 'unreachable\n'
        return 0
    fi
    if ! _tmux_run_with_timeout has-session -t "$target"; then
        printf 'unreachable\n'
        return 0
    fi
    printf 'live\n'
}

# ── Claude Code socket delivery adapter ─────────────────────────────
# Resolve a peer's tmux session name to a Claude Code messaging socket.
# Reads ~/.claude/sessions/*.json, matches the tmux_target against the
# parenthesized session name, and returns the socket path. Returns 1
# if no matching live socket is found.
_peer_claude_socket_for() {
    local tmux_target="$1" sessions_dir="$HOME/.claude/sessions" f name sock
    [[ -d "$sessions_dir" ]] || return 1
    for f in "$sessions_dir"/*.json; do
        [[ -f "$f" ]] || continue
        name="$(jq -r '.name // ""' "$f" 2>/dev/null)"
        [[ "$name" == *"($tmux_target)"* ]] || continue
        sock="$(jq -r '.messagingSocketPath // ""' "$f" 2>/dev/null)"
        [[ -n "$sock" && -S "$sock" ]] || continue
        printf '%s' "$sock"
        return 0
    done
    return 1
}

_peer_socket_deliver() {
    local socket_path="$1" payload="$2"
    if command -v socat >/dev/null 2>&1; then
        printf '{"type":"user","message":{"role":"user","content":%s}}\n' \
            "$(jq -Rs '.' <<< "$payload")" \
            | socat -t2 - UNIX-CONNECT:"$socket_path" >/dev/null 2>&1
        return $?
    fi
    if command -v node >/dev/null 2>&1; then
        local escaped
        escaped="$(jq -Rs '.' <<< "$payload")"
        node -e "
const net=require('net');
const c=net.createConnection('$socket_path',()=>{
  c.write(JSON.stringify({type:'user',message:{role:'user',content:$escaped}})+'\n');
  c.end();
});
c.on('error',()=>process.exit(1));
c.on('end',()=>process.exit(0));
" >/dev/null 2>&1
        return $?
    fi
    return 1
}

_peer_tmux_target_for_delivery() {
    local peer_json="$1" peer target class
    peer="$(jq -r '.name' <<< "$peer_json")"
    class="$(_peer_reachability_class "$peer_json")"
    case "$class" in
        mailbox-only)
            PEER_DELIVER_STATUS="skipped"
            PEER_DELIVER_REASON="no-tmux-capability"
            return 1
            ;;
        unreachable)
            target="$(jq -r '.tmux_target // .session // empty' <<< "$peer_json")"
            PEER_DELIVER_STATUS="failed"
            if [[ -z "$target" ]]; then
                PEER_DELIVER_REASON="missing tmux session for $peer"
            elif ! command -v tmux >/dev/null 2>&1; then
                PEER_DELIVER_REASON="tmux unavailable"
            else
                PEER_DELIVER_REASON="${TMUX_RUN_ERROR:-tmux session not found: $target}"
                [[ -n "$PEER_DELIVER_REASON" ]] || PEER_DELIVER_REASON="tmux session not found: $target"
            fi
            return 1
            ;;
        live)
            target="$(jq -r '.tmux_target // .session // empty' <<< "$peer_json")"
            PEER_DELIVER_STATUS="ok"
            PEER_DELIVER_REASON=""
            PEER_DELIVER_TARGET="$target"
            return 0
            ;;
    esac
}

_peer_pane_ready_for_delivery() {
    # Returns 0 = ready, 1 = modal visible, 2 = capture failed.
    # Sets PEER_DELIVER_READY_REASON on non-zero return.
    # Uses the shared pattern table from lib/health-check-patterns.sh.
    local target="$1" agent="${2:-}" force_busy="${3:-false}" capture
    if ! _tmux_run_with_timeout capture-pane -p -S -15 -t "$target"; then
        PEER_DELIVER_READY_REASON="${TMUX_RUN_ERROR:-capture-pane failed}"
        [[ -n "$PEER_DELIVER_READY_REASON" ]] || PEER_DELIVER_READY_REASON="capture-pane failed"
        return 2
    fi
    capture="$TMUX_RUN_OUTPUT"
    # Source pattern table if not already loaded
    if [[ -z "${_HC_PATTERNS_LOADED:-}" ]]; then
        if [[ -f "$SCRIPT_DIR/lib/health-check-patterns.sh" ]]; then
            _HC_SCRIPT_DIR="$SCRIPT_DIR/lib"
            source "$SCRIPT_DIR/lib/health-check-patterns.sh"
        else
            # Fallback: inline patterns for environments without the lib dir
            case "$agent" in
                claude)
                    if printf '%s\n' "$capture" | grep -E '❯ 1\.' >/dev/null 2>&1; then
                        PEER_DELIVER_READY_REASON="modal prompt visible"; return 1; fi ;;
                codex)
                    if printf '%s\n' "$capture" | grep -E 'Allow Codex to |approve network access|tell Codex what to do differently|Hooks need review|PreToolUse hooks|Press t to trust|Trust all and continue' >/dev/null 2>&1; then
                        PEER_DELIVER_READY_REASON="modal prompt visible"; return 1; fi ;;
                *)
                    if [[ "$force_busy" != "true" ]]; then
                        PEER_DELIVER_READY_REASON="unknown agent readiness"; return 1; fi ;;
            esac
            PEER_DELIVER_READY_REASON=""
            return 0
        fi
    fi
    case "$agent" in
        claude)
            local i
            for (( i = 0; i < ${#CLAUDE_HC_PATTERN[@]}; i++ )); do
                if printf '%s\n' "$capture" | grep -E "${CLAUDE_HC_PATTERN[$i]}" >/dev/null 2>&1; then
                    PEER_DELIVER_READY_REASON="modal prompt visible"
                    return 1
                fi
            done
            ;;
        codex)
            local i
            for (( i = 0; i < ${#CODEX_HC_PATTERN[@]}; i++ )); do
                if printf '%s\n' "$capture" | grep -E "${CODEX_HC_PATTERN[$i]}" >/dev/null 2>&1; then
                    PEER_DELIVER_READY_REASON="modal prompt visible"
                    return 1
                fi
            done
            ;;
        *)
            if [[ "$force_busy" != "true" ]]; then
                PEER_DELIVER_READY_REASON="unknown agent readiness"
                return 1
            fi
            ;;
    esac
    PEER_DELIVER_READY_REASON=""
    return 0
}

_peer_tmux_paste() {
    local target="$1" buffer="$2" payload="$3" submit="${4:-true}"
    if ! _tmux_run_stdin_with_timeout "$payload" load-buffer -b "$buffer" -; then
        PEER_DELIVER_REASON="${TMUX_RUN_ERROR:-tmux load-buffer failed}"
        [[ -n "$PEER_DELIVER_REASON" ]] || PEER_DELIVER_REASON="tmux load-buffer failed"
        return 1
    fi
    if ! _tmux_run_with_timeout paste-buffer -b "$buffer" -t "$target"; then
        PEER_DELIVER_REASON="${TMUX_RUN_ERROR:-tmux paste-buffer failed}"
        [[ -n "$PEER_DELIVER_REASON" ]] || PEER_DELIVER_REASON="tmux paste-buffer failed"
        _tmux_run_with_timeout delete-buffer -b "$buffer" >/dev/null 2>&1 || true
        return 1
    fi
    if [[ "$submit" == "true" ]]; then
        if ! _tmux_run_with_timeout send-keys -t "$target" Enter; then
            PEER_DELIVER_REASON="${TMUX_RUN_ERROR:-tmux send-keys failed}"
            [[ -n "$PEER_DELIVER_REASON" ]] || PEER_DELIVER_REASON="tmux send-keys failed"
            _tmux_run_with_timeout delete-buffer -b "$buffer" >/dev/null 2>&1 || true
            return 1
        fi
    fi
    _tmux_run_with_timeout delete-buffer -b "$buffer" >/dev/null 2>&1 || true
    PEER_DELIVER_REASON=""
    return 0
}

_peer_record_nudge_json() {
    local messages="$1" peer="$2" ok="$3" error="$4" now="$5" count_it="${6:-true}" adapter="${7:-tmux}"
    jq --arg peer "$peer" --arg now "$now" --arg error "$error" --argjson ok "$ok" --argjson countit "$count_it" --arg adapter "$adapter" '
        map(
          if .to == $peer and .status == "queued" then
            (if $countit then .nudge_count = ((.nudge_count // 0) + 1) else . end)
            | .updated_at = $now
            | (if $countit then .last_nudge_at = $now else . end)
            | .last_nudge_error = (if $error == "" then null else $error end)
            | .history = ((.history // []) + [
                ({at: $now, event: "nudge", ok: $ok, by: "cctrl", adapter: $adapter}
                 + (if $error == "" then {} else {error: $error} end))
              ])
          else . end
        )
    ' <<< "$messages"
}

_peer_record_inline_json() {
    local messages="$1" id="$2" ok="$3" error="$4" now="$5"
    # On a SUCCESSFUL paste of a still-`queued` message, transition it to
    # `delivered` the way `_peer_cmd_recv` does — set delivered_at (which
    # `_peer_delivered_stale_json` reads to age the delivered-but-unacked sweep)
    # and append a `delivered` history entry — so `cctrl peer ack` (which rejects
    # queued messages) can now complete the lifecycle (plan 024). Only touch a
    # queued message: an already-`delivered`/`acked` message keeps its status and
    # its original delivered_at when re-delivered inline. Failure branches pass
    # ok=false and never transition.
    jq --arg id "$id" --arg now "$now" --arg error "$error" --argjson ok "$ok" '
        map(
          if .id == $id then
            .updated_at = $now
            | .last_nudge_error = (if $error == "" then null else $error end)
            | .history = ((.history // []) + [
                ({at: $now, event: "inline", ok: $ok, by: "cctrl", adapter: "tmux"}
                 + (if $error == "" then {} else {error: $error} end))
              ])
            | (if ($ok and .status == "queued") then
                 .status = "delivered"
                 | .delivered_at = $now
                 | .history = (.history + [{at: $now, status: "delivered", by: "cctrl"}])
               else . end)
          else . end
        )
    ' <<< "$messages"
}

_peer_message_body_from_json() {
    local messages="$1" id="$2" body sentinel=$'\037'
    body="$(jq -j --arg id "$id" '[.[] | select(.id == $id)][0].body // ""' <<< "$messages"; printf '%s' "$sentinel")"
    PEER_MESSAGE_BODY="${body%$sentinel}"
}

_peer_delivery_result_json() {
    jq -n \
      --arg peer "$PEER_DELIVER_PEER" \
      --arg status "$PEER_DELIVER_STATUS" \
      --arg reason "${PEER_DELIVER_REASON:-}" \
      --arg target "${PEER_DELIVER_TARGET:-}" \
      --arg nudge "${PEER_DELIVER_NUDGE:-}" \
      --arg message_id "${PEER_DELIVER_MESSAGE_ID:-}" \
      --argjson queued "${PEER_DELIVER_QUEUED:-0}" \
      --argjson submitted "${PEER_DELIVER_SUBMITTED:-false}" \
      --argjson dry_run "${PEER_DELIVER_DRY_RUN:-false}" \
      --argjson inline "${PEER_DELIVER_INLINE:-false}" \
      '{
        peer: $peer,
        status: $status,
        queued: $queued,
        submitted: $submitted,
        dry_run: $dry_run,
        inline: $inline
      }
      + (if $reason != "" then {reason: $reason} else {} end)
      + (if $target != "" then {target: $target} else {} end)
      + (if $nudge != "" then {nudge: $nudge} else {} end)
      + (if $message_id != "" then {message_id: $message_id} else {} end)'
}

_peer_print_delivery_human() {
    local result="$1" peer status queued reason
    peer="$(jq -r '.peer' <<< "$result")"
    status="$(jq -r '.status' <<< "$result")"
    queued="$(jq -r '.queued' <<< "$result")"
    reason="$(jq -r '.reason // empty' <<< "$result")"
    case "$status" in
        nudged) echo -e "${GREEN}Nudged $peer${RESET} (${queued} queued)" ;;
        dry-run)
            echo "$(jq -r '.nudge' <<< "$result")"
            ;;
        deferred) echo -e "${YELLOW}Deferred $peer${RESET}: $reason" ;;
        skipped) echo -e "${DIM}Skipped $peer: $reason${RESET}" ;;
        no_messages) echo -e "${DIM}No queued messages for $peer.${RESET}" ;;
        inline) echo -e "${GREEN}Pasted inline message for $peer${RESET}" ;;
        failed) echo -e "${RED}Failed $peer:${RESET} $reason" ;;
        *) echo "$status $peer $reason" ;;
    esac
}

_peer_deliver_one_locked() {
    local peer_json="$1" messages="$2" dry_run="$3" json="$4" no_submit="$5" force_busy="$6" inline_id="$7"
    local peer agent target queued now nudge buffer submit payload result message_body message_to updated recent
    local peer_created guard blocked_now msg_status
    local inline_msg_json inline_from inline_sender inline_sender_json inline_reach inline_envelope
    peer="$(jq -r '.name' <<< "$peer_json")"
    agent="$(jq -r '.agent // empty' <<< "$peer_json")"
    peer_created="$(jq -r '.created_at // ""' <<< "$peer_json")"
    PEER_DELIVER_PEER="$peer"
    PEER_DELIVER_TARGET=""
    PEER_DELIVER_REASON=""
    PEER_DELIVER_NUDGE=""
    PEER_DELIVER_MESSAGE_ID="$inline_id"
    PEER_DELIVER_DRY_RUN="$dry_run"
    PEER_DELIVER_INLINE=false
    PEER_DELIVER_SUBMITTED=false

    # Addressee guard (plan 032): before nudging or counting, terminally block
    # any queued message whose CURRENT occupant of this name post-dates it — a
    # recycled tmux name now held by a different session. Marking blocked (not
    # deleting) leaves an audit trail the sender sees in `outbox`, and drops the
    # message from the queued count so no nudge fires. Runs inside the caller's
    # mailbox lock, like the failure-record rewrite below.
    guard="$(_peer_guard_defs)"
    blocked_now="$(jq --arg who "$peer" --arg peer "$peer_created" --arg now "$(_peer_now_utc)" "$guard"'
        map(
          if (.to == $who and .status == "queued" and (deliverable($peer) | not)) then
            .status = "blocked"
            | .updated_at = $now
            | .blocked_reason = block_reason($peer)
            | .history = ((.history // []) + [{at: $now, status: "blocked", reason: block_reason($peer), by: "cctrl"}])
          else . end
        )
    ' <<< "$messages")"
    if [[ "$blocked_now" != "$messages" ]]; then
        _mailbox_rewrite_json_locked "$blocked_now"
        messages="$blocked_now"
    fi

    if [[ -n "$inline_id" ]]; then
        PEER_DELIVER_INLINE=true
        message_to="$(jq -r --arg id "$inline_id" '[.[] | select(.id == $id)][0].to // empty' <<< "$messages")"
        if [[ -z "$message_to" ]]; then
            PEER_DELIVER_STATUS="failed"
            PEER_DELIVER_REASON="unknown message: $inline_id"
            PEER_DELIVER_QUEUED=0
            _peer_delivery_result_json
            return 1
        fi
        if [[ "$message_to" != "$peer" ]]; then
            PEER_DELIVER_STATUS="failed"
            PEER_DELIVER_REASON="message $inline_id is addressed to $message_to"
            PEER_DELIVER_QUEUED=0
            _peer_delivery_result_json
            return 1
        fi
        # Addressee guard: if the transition above blocked this specific message,
        # do not hand its body to the current (wrong) occupant.
        msg_status="$(jq -r --arg id "$inline_id" '[.[] | select(.id == $id)][0].status // empty' <<< "$messages")"
        if [[ "$msg_status" == "blocked" ]]; then
            PEER_DELIVER_STATUS="failed"
            PEER_DELIVER_REASON="$(jq -r --arg id "$inline_id" '[.[] | select(.id == $id)][0].blocked_reason // "addressee-replaced"' <<< "$messages")"
            PEER_DELIVER_QUEUED=0
            _peer_delivery_result_json
            return 1
        fi
        _peer_message_body_from_json "$messages" "$inline_id"
        message_body="$PEER_MESSAGE_BODY"
        unset PEER_MESSAGE_BODY
        queued="$(jq -r --arg peer "$peer" '[.[] | select(.to == $peer and .status == "queued")] | length' <<< "$messages")"
        PEER_DELIVER_QUEUED="$queued"
        # Prepend a sender envelope (plan 024). Resolve the SENDER's reachability
        # NOW, at delivery time — the sender snapshot (plan 023) records who they
        # WERE; by the time the model reads the pane they may be gone. Consume the
        # PURE classifier (plan 027); do NOT call _peer_tmux_target_for_delivery,
        # which writes PEER_DELIVER_STATUS/TARGET and would clobber this in-flight
        # RECIPIENT delivery. A sender that no longer resolves at all is
        # unreachable. Prepend to PEER_MESSAGE_BODY so the body's trailing-newline
        # -safe extraction is preserved verbatim after the `---`.
        inline_msg_json="$(jq -c --arg id "$inline_id" '[.[] | select(.id == $id)][0]' <<< "$messages")"
        inline_from="$(jq -r '.from // ""' <<< "$inline_msg_json")"
        inline_sender="$(jq -r '(.sender.name // "") as $n | (.from // "") as $f | if $n != "" then $n else $f end' <<< "$inline_msg_json")"
        if [[ "$inline_from" == "user" ]]; then
            inline_reach="user"
        elif inline_sender_json="$(_peer_resolve_json "$inline_sender" 2>/dev/null)"; then
            inline_reach="$(_peer_reachability_class "$inline_sender_json")"
        else
            inline_reach="unreachable"
        fi
        inline_envelope="$(_peer_inline_envelope "$inline_msg_json" "$peer" "$inline_reach")"
        payload="${inline_envelope}"$'\n'"${message_body}"
        submit=false
    else
        queued="$(jq -r --arg peer "$peer" '[.[] | select(.to == $peer and .status == "queued")] | length' <<< "$messages")"
        PEER_DELIVER_QUEUED="$queued"
        if (( queued == 0 )); then
            PEER_DELIVER_STATUS="no_messages"
            _peer_delivery_result_json
            return 0
        fi
        nudge="$(_peer_nudge_line "$peer" "$queued")"
        PEER_DELIVER_NUDGE="$nudge"
        payload="$nudge"
        submit=true
        [[ "$no_submit" == "true" ]] && submit=false
    fi

    if [[ "$dry_run" == "true" ]]; then
        PEER_DELIVER_STATUS="dry-run"
        PEER_DELIVER_SUBMITTED="$submit"
        _peer_delivery_result_json
        return 0
    fi

    # Socket adapter: try Claude Code native socket before tmux paste.
    # Faster, no tmux dependency, no pane-readiness check needed.
    local _sock_target _sock_path
    _sock_target="$(jq -r '.tmux_target // .session // empty' <<< "$peer_json")"
    if [[ -n "$_sock_target" ]] && _sock_path="$(_peer_claude_socket_for "$_sock_target")"; then
        if _peer_socket_deliver "$_sock_path" "$payload"; then
            now="$(_peer_now_utc)"
            if [[ -n "$inline_id" ]]; then
                PEER_DELIVER_STATUS="socket"
                updated="$(_peer_record_inline_json "$messages" "$inline_id" true "" "$now")"
            else
                PEER_DELIVER_STATUS="nudged"
                updated="$(_peer_record_nudge_json "$messages" "$peer" true "" "$now" true "socket")"
                PEER_DELIVER_SUBMITTED="$submit"
            fi
            PEER_DELIVER_TARGET="$_sock_path"
            _mailbox_rewrite_json_locked "$updated"
            _peer_delivery_result_json
            return 0
        fi
        # Socket delivery failed — fall through to tmux paste
    fi

    if ! _peer_tmux_target_for_delivery "$peer_json"; then
        if [[ "$PEER_DELIVER_STATUS" == "failed" ]]; then
            now="$(_peer_now_utc)"
            if [[ -n "$inline_id" ]]; then
                updated="$(_peer_record_inline_json "$messages" "$inline_id" false "$PEER_DELIVER_REASON" "$now")"
            else
                updated="$(_peer_record_nudge_json "$messages" "$peer" false "$PEER_DELIVER_REASON" "$now" false)"
            fi
            _mailbox_rewrite_json_locked "$updated"
            PEER_DELIVER_QUEUED="$queued"
        fi
        _peer_delivery_result_json
        [[ "$PEER_DELIVER_STATUS" == "skipped" ]] && return 0
        return 1
    fi
    target="$PEER_DELIVER_TARGET"

    _peer_pane_ready_for_delivery "$target" "$agent" "$force_busy"
    case "$?" in
        1)
            PEER_DELIVER_STATUS="deferred"
            PEER_DELIVER_REASON="$PEER_DELIVER_READY_REASON"
            _peer_delivery_result_json
            return 0 ;;
        2)
            PEER_DELIVER_STATUS="failed"
            PEER_DELIVER_REASON="$PEER_DELIVER_READY_REASON"
            now="$(_peer_now_utc)"
            if [[ -n "$inline_id" ]]; then
                updated="$(_peer_record_inline_json "$messages" "$inline_id" false "$PEER_DELIVER_REASON" "$now")"
            else
                updated="$(_peer_record_nudge_json "$messages" "$peer" false "$PEER_DELIVER_REASON" "$now" false)"
            fi
            _mailbox_rewrite_json_locked "$updated"
            _peer_delivery_result_json
            return 1 ;;
    esac

    if [[ -z "$inline_id" ]]; then
        recent="$(jq -r --arg peer "$peer" --arg now "$(_peer_now_utc)" '
            [ .[] | select(.to == $peer and .status == "queued") ] as $queued
            | if ($queued | length) == 0 then 0
              elif all($queued[]; (.last_nudge_at // "") == $now) then 1
              else 0
              end
        ' <<< "$messages")"
        if (( recent > 0 )); then
            PEER_DELIVER_STATUS="skipped"
            PEER_DELIVER_REASON="recently nudged"
            _peer_delivery_result_json
            return 0
        fi
    fi

    if [[ -n "$inline_id" ]]; then
        buffer="cctrl-inline-${peer}-$(date +%s)"
    else
        buffer="cctrl-nudge-${peer}-$(date +%s)"
    fi
    if ! _peer_tmux_paste "$target" "$buffer" "$payload" "$submit"; then
        PEER_DELIVER_STATUS="failed"
        now="$(_peer_now_utc)"
        if [[ -n "$inline_id" ]]; then
            updated="$(_peer_record_inline_json "$messages" "$inline_id" false "$PEER_DELIVER_REASON" "$now")"
        else
            updated="$(_peer_record_nudge_json "$messages" "$peer" false "$PEER_DELIVER_REASON" "$now" true)"
        fi
        _mailbox_rewrite_json_locked "$updated"
        _peer_delivery_result_json
        return 1
    fi

    now="$(_peer_now_utc)"
    if [[ -n "$inline_id" ]]; then
        PEER_DELIVER_STATUS="inline"
        updated="$(_peer_record_inline_json "$messages" "$inline_id" true "" "$now")"
    else
        PEER_DELIVER_STATUS="nudged"
        updated="$(_peer_record_nudge_json "$messages" "$peer" true "" "$now" true)"
        PEER_DELIVER_SUBMITTED="$submit"
    fi
    _mailbox_rewrite_json_locked "$updated"
    _peer_delivery_result_json
}

_peer_cmd_deliver() {
    local target="" all=false dry_run=false json=false no_submit=false force_busy=false inline_id="" a
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --all)
                all=true; shift ;;
            --dry-run)
                dry_run=true; shift ;;
            --json)
                json=true; shift ;;
            --no-submit)
                no_submit=true; shift ;;
            --force-busy)
                force_busy=true; shift ;;
            --inline)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--inline needs a message id" || echo -e "${RED}--inline needs a message id${RESET}" >&2; return 64; }
                inline_id="$2"; shift 2 ;;
            -*)
                $json && _json_error "validation" "Unknown peer deliver flag: $1" || echo -e "${RED}Unknown peer deliver flag: $1${RESET}" >&2
                return 64 ;;
            *)
                if [[ -n "$target" ]]; then
                    $json && _json_error "validation" "Only one peer target is allowed" || echo -e "${RED}Only one peer target is allowed.${RESET}" >&2
                    return 64
                fi
                target="$1"; shift ;;
        esac
    done
    if $all && [[ -n "$target" ]]; then
        $json && _json_error "validation" "Use either --all or a peer target, not both." || echo -e "${RED}Use either --all or a peer target, not both.${RESET}" >&2
        return 64
    fi
    if $all && [[ -n "$inline_id" ]]; then
        $json && _json_error "validation" "--inline cannot be combined with --all" || echo -e "${RED}--inline cannot be combined with --all.${RESET}" >&2
        return 64
    fi
    if [[ -z "$target" && "$all" != "true" && -z "$inline_id" ]]; then
        $json && _json_error "validation" "Usage: cctrl peer deliver <peer|--all> [--dry-run] [--json] [--no-submit] [--inline ID] [--force-busy]" || echo -e "${RED}Usage: cctrl peer deliver <peer|--all> [--dry-run] [--json] [--no-submit] [--inline ID] [--force-busy]${RESET}" >&2
        return 64
    fi

    local messages peer_json results="[]" result rc=0 lock_rc=0 recipients inline_to json_ok=true
    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_read_json_or_error "$json" || lock_rc=$?
        if [[ $lock_rc -eq 0 ]]; then
            messages="$MAILBOX_MESSAGES"
            if [[ -n "$inline_id" && -z "$target" ]]; then
                inline_to="$(jq -r --arg id "$inline_id" '[.[] | select(.id == $id)][0].to // empty' <<< "$messages")"
                if [[ -z "$inline_to" ]]; then
                    PEER_DELIVER_PEER=""
                    PEER_DELIVER_STATUS="failed"
                    PEER_DELIVER_REASON="unknown message: $inline_id"
                    PEER_DELIVER_TARGET=""
                    PEER_DELIVER_NUDGE=""
                    PEER_DELIVER_MESSAGE_ID="$inline_id"
                    PEER_DELIVER_QUEUED=0
                    PEER_DELIVER_SUBMITTED=false
                    PEER_DELIVER_DRY_RUN="$dry_run"
                    PEER_DELIVER_INLINE=true
                    result="$(_peer_delivery_result_json)"
                    results="$(jq --argjson r "$result" '. + [$r]' <<< "$results")"
                    rc=1
                else
                    target="$inline_to"
                fi
            fi
            if [[ $rc -eq 0 ]]; then
                if $all; then
                    recipients="$(jq -r '[.[] | select(.status == "queued") | .to] | unique[]' <<< "$messages")"
                    if [[ -z "$recipients" ]]; then
                        results="[]"
                    else
                        while IFS= read -r target; do
                            [[ -n "$target" ]] || continue
                            if ! peer_json="$(_peer_resolve_json "$target" 2>/dev/null)"; then
                                PEER_DELIVER_PEER="$target"
                                PEER_DELIVER_STATUS="skipped"
                                PEER_DELIVER_REASON="unknown-peer"
                                PEER_DELIVER_TARGET=""
                                PEER_DELIVER_NUDGE=""
                                PEER_DELIVER_MESSAGE_ID=""
                                PEER_DELIVER_QUEUED="$(jq -r --arg peer "$target" '[.[] | select(.to == $peer and .status == "queued")] | length' <<< "$messages")"
                                PEER_DELIVER_SUBMITTED=false
                                PEER_DELIVER_DRY_RUN="$dry_run"
                                PEER_DELIVER_INLINE=false
                                result="$(_peer_delivery_result_json)"
                            else
                                result="$(_peer_deliver_one_locked "$peer_json" "$messages" "$dry_run" "$json" "$no_submit" "$force_busy" "")" || rc=1
                                messages="$(_mailbox_read_json)"
                            fi
                            results="$(jq --argjson r "$result" '. + [$r]' <<< "$results")"
                        done <<< "$recipients"
                    fi
                elif [[ $rc -eq 0 ]]; then
                    if ! peer_json="$(_peer_resolve_json "$target" 2>/dev/null)"; then
                        $json && _json_error "unknown-peer" "Unknown peer: $target" || _mailbox_require_peer "peer" "$target" false
                        rc=66
                    else
                        result="$(_peer_deliver_one_locked "$peer_json" "$messages" "$dry_run" "$json" "$no_submit" "$force_busy" "$inline_id")" || rc=1
                        results="$(jq --argjson r "$result" '. + [$r]' <<< "$results")"
                    fi
                fi
            fi
        else
            rc=$lock_rc
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 66 ]] && return 66
    [[ $rc -eq 65 ]] && return 65
    [[ $rc -ne 0 ]] && json_ok=false
    if $json; then
        jq -n --argjson ok "$json_ok" --argjson results "$results" '{ok:$ok,results:$results}'
    else
        jq -c '.[]' <<< "$results" | while IFS= read -r result; do
            _peer_print_delivery_human "$result"
        done
    fi
    return $rc
}

# Cross-machine send+deliver: forward the operation to a remote host via SSH.
# The message is written to the REMOTE mailbox and delivered by REMOTE adapters,
# so `peer recv` on that machine finds it. Sets PEER_SD_* globals like the local
# path, with PEER_SD_REMOTE_HOST populated for the emitter.
_peer_send_and_deliver_remote() {
    local to="$1" body="$2" remote_host="$3"; shift 3
    local -a extra_flags=("$@")
    local lookup hostname user ssh_target sender_as="" sender_host result rc=0

    lookup="$(_host_lookup "$remote_host")"
    if [[ -z "$lookup" ]]; then
        PEER_SD_OUTCOME="send-failed"
        PEER_SD_RC=1
        PEER_SD_SEND_JSON="$(jq -cn --arg h "$remote_host" '{ok:false,error:{code:"unknown-host",message:("No SSH target for host \"\($h)\". Register it: cctrl host add \($h) <hostname> [--user <user>]")}}')"
        return 1
    fi
    hostname="${lookup%% *}"
    user="${lookup#* }"
    [[ -n "$user" ]] && ssh_target="${user}@${hostname}" || ssh_target="$hostname"

    local i=0
    while (( i < ${#extra_flags[@]} )); do
        case "${extra_flags[$i]}" in
            --as|--from) sender_as="${extra_flags[$((i+1))]}"; break ;;
        esac
        ((i++))
    done
    [[ -z "$sender_as" ]] && sender_as="${CCTRL_PEER:-user}"
    sender_host="${CCTRL_HOST_PREFIX:-local}"

    local quoted_args=""
    quoted_args+=" $(printf '%q' "$to")"
    quoted_args+=" --as $(printf '%q' "$sender_as")"
    quoted_args+=" --sender-host $(printf '%q' "$sender_host")"
    quoted_args+=" --deliver --json --body-file -"
    local j=0
    while (( j < ${#extra_flags[@]} )); do
        case "${extra_flags[$j]}" in
            --subject) quoted_args+=" --subject $(printf '%q' "${extra_flags[$((j+1))]}")"; ((j+=2)); continue ;;
        esac
        ((j++))
    done

    result="$(printf '%s' "$body" | ssh -o BatchMode=yes -o ConnectTimeout=8 "$ssh_target" \
        "source ~/.zprofile 2>/dev/null; CCTRL_HOST_PREFIX=$(printf '%q' "$remote_host") cctrl peer send${quoted_args}" 2>/dev/null)" || rc=$?

    if [[ $rc -ne 0 && -z "$result" ]]; then
        PEER_SD_OUTCOME="send-failed"
        PEER_SD_RC=1
        PEER_SD_SEND_JSON="$(jq -cn --arg h "$remote_host" --arg t "$ssh_target" --arg rc "$rc" \
            '{ok:false,error:{code:"ssh-failed",message:"SSH to \($h) (\($t)) failed (exit \($rc))"}}')"
        return 1
    fi

    PEER_SD_SEND_JSON="$result"
    PEER_SD_MESSAGE_ID="$(jq -r '.message_id // .id // ""' <<< "$result" 2>/dev/null)"
    PEER_SD_TO="$(jq -r '.to // ""' <<< "$result" 2>/dev/null)"
    [[ -z "$PEER_SD_TO" ]] && PEER_SD_TO="$to"
    PEER_SD_OUTCOME="$(jq -r '.outcome // "sent-remote"' <<< "$result" 2>/dev/null)"
    PEER_SD_DELIVER_REASON="$(jq -r '.delivery_reason // ""' <<< "$result" 2>/dev/null)"
    PEER_SD_DELIVER_JSON="$(jq -c '.delivery // {}' <<< "$result" 2>/dev/null)"
    PEER_SD_REMOTE_HOST="$remote_host"

    case "$PEER_SD_OUTCOME" in
        sent-and-nudged|sent-and-queued) PEER_SD_RC=0 ;;
        send-failed) PEER_SD_RC=1 ;;
        *) PEER_SD_RC=1 ;;
    esac
    return "$PEER_SD_RC"
}

# Shared send-then-deliver core for `peer reply` and `peer send --deliver`
# (plan 027). Sends via the UNCHANGED `peer send`, then nudges the recipient and
# classifies the result into one of five named outcomes:
#
#   send-failed          nothing queued                        exit != 0
#   sent-but-undelivered queued, paste failed, retryable       exit != 0
#   sent-but-deferred    queued, pane busy/modal, not pasted   exit != 0
#   sent-and-nudged      queued, nudge pasted into a live pane exit 0
#   sent-and-queued      queued, peer is mailbox-only          exit 0
#
# On any non-zero outcome except send-failed the message is durably queued: the
# send is NEVER rolled back, and the caller must retry DELIVERY ONLY (never the
# reply/send, which would duplicate the message). Results are returned via
# PEER_SD_* globals so the caller renders them; this function prints nothing.
#   $1 = recipient (name or alias)
#   $2 = body
#   remaining args = extra `peer send` flags (--from NAME / --as NAME / --subject)
_peer_send_and_deliver() {
    local to="$1" body="$2"; shift 2
    local -a send_flags=("$@")
    local send_out="" send_rc=0 deliver_out="" status canon_to id to_peer_json class

    PEER_SD_OUTCOME=""
    PEER_SD_MESSAGE_ID=""
    PEER_SD_RC=0
    PEER_SD_TO="$to"
    PEER_SD_SEND_JSON=""
    PEER_SD_DELIVER_JSON=""
    PEER_SD_DELIVER_REASON=""
    PEER_SD_REMOTE_HOST=""

    # Cross-machine routing: if the target peer is known locally with a remote
    # host, or if it's unknown locally but exists on a remote host, forward the
    # entire send+deliver there via SSH. The message is written to the REMOTE
    # mailbox so `peer recv` on that machine finds it.
    local _route_peer_json _route_host _route_local
    _route_local="${CCTRL_HOST_PREFIX:-local}"
    if _route_peer_json="$(_peer_resolve_json "$to" 2>/dev/null)"; then
        _route_host="$(jq -r '.host // "local"' <<< "$_route_peer_json")"
        if [[ "$_route_host" != "$_route_local" && "$_route_host" != "local" ]]; then
            _peer_send_and_deliver_remote "$to" "$body" "$_route_host" ${send_flags[@]+"${send_flags[@]}"}
            return $?
        fi
    elif [[ -f "$HOSTS_FILE" ]]; then
        local _fleet_peers _fleet_match _fleet_host
        _fleet_peers="$(_peer_fleet_peers 2>/dev/null)"
        if [[ -n "$_fleet_peers" && "$_fleet_peers" != "[]" ]]; then
            _fleet_match="$(jq -c --arg n "$to" '[.[] | select(.name == $n or ((.aliases // []) | index($n)))] | first // empty' <<< "$_fleet_peers" 2>/dev/null)"
            if [[ -n "$_fleet_match" ]]; then
                _fleet_host="$(jq -r '.host' <<< "$_fleet_match")"
                _peer_send_and_deliver_remote "$to" "$body" "$_fleet_host" ${send_flags[@]+"${send_flags[@]}"}
                return $?
            fi
        fi
    fi

    # Step 1: send. The inner `peer send` is plain (no --deliver), so this reuses
    # all of send's resolution/validation/sender-snapshot with zero duplication.
    # Body flows via --body-file - so an arbitrary body (leading dashes, newlines)
    # can never be mis-parsed as a flag.
    send_out="$(printf '%s' "$body" | _peer_cmd_send "$to" ${send_flags[@]+"${send_flags[@]}"} --body-file - --json)" || send_rc=$?
    PEER_SD_SEND_JSON="$send_out"
    if [[ $send_rc -ne 0 ]]; then
        PEER_SD_OUTCOME="send-failed"
        PEER_SD_RC=$send_rc
        return "$send_rc"
    fi

    id="$(jq -r '.id // ""' <<< "$send_out")"
    canon_to="$(jq -r '.to // ""' <<< "$send_out")"
    [[ -n "$canon_to" ]] && PEER_SD_TO="$canon_to"
    PEER_SD_MESSAGE_ID="$id"

    # Step 2: deliver (nudge) the recipient peer.
    deliver_out="$(_peer_cmd_deliver "$PEER_SD_TO" --json)" || true
    PEER_SD_DELIVER_JSON="$deliver_out"
    status="$(jq -r '.results[0].status // "unknown"' <<< "$deliver_out")"
    PEER_SD_DELIVER_REASON="$(jq -r '.results[0].reason // ""' <<< "$deliver_out")"

    # Step 3: classify. `nudged` is the only state that pasted into a live pane;
    # `deferred` is a busy pane (nothing pasted, nothing retries). Anything else
    # is disambiguated by the PURE reachability classifier: a mailbox-only peer's
    # skip is a normal success (sent-and-queued), not a delivery failure.
    case "$status" in
        nudged)
            PEER_SD_OUTCOME="sent-and-nudged"
            PEER_SD_RC=0
            ;;
        deferred)
            PEER_SD_OUTCOME="sent-but-deferred"
            PEER_SD_RC=1
            ;;
        *)
            to_peer_json="$(_peer_resolve_json "$PEER_SD_TO" 2>/dev/null || printf '{}')"
            class="$(_peer_reachability_class "$to_peer_json")"
            if [[ "$class" == "mailbox-only" ]]; then
                PEER_SD_OUTCOME="sent-and-queued"
                PEER_SD_RC=0
            elif [[ "$status" == "skipped" ]]; then
                # Live pane already nudged this instant — treat as nudged.
                PEER_SD_OUTCOME="sent-and-nudged"
                PEER_SD_RC=0
            else
                PEER_SD_OUTCOME="sent-but-undelivered"
                PEER_SD_RC=1
            fi
            ;;
    esac
    return "$PEER_SD_RC"
}

# Render a PEER_SD_* outcome for `peer reply` / `peer send --deliver`.
#   $1 = json (bool)   $2 = recipient   $3 = context ("reply" | "send")
# For context=reply the caller sets PEER_SD_ACK_STATE (acked|skipped|failed) and
# PEER_SD_ACK_ERROR. JSON always goes to stdout (so MCP/CLI callers can parse it
# even on a non-zero exit); human errors go to stderr.
_peer_send_deliver_emit() {
    local json="$1" to="$2" ctx="${3:-send}"

    if [[ "$PEER_SD_OUTCOME" == "send-failed" ]]; then
        if [[ "$json" == "true" ]]; then
            local err_json="$PEER_SD_SEND_JSON"
            printf '%s\n' "$err_json" | jq -e . >/dev/null 2>&1 || err_json='{"ok":false,"error":{"code":"send-failed","message":"peer send failed"}}'
            jq -n --argjson base "$err_json" '$base + {outcome:"send-failed"}'
        else
            local m
            m="$(printf '%s\n' "$PEER_SD_SEND_JSON" | jq -r '.error.message // empty' 2>/dev/null)"
            [[ -n "$m" ]] || m="peer send failed"
            echo -e "${RED}Send failed:${RESET} $m" >&2
        fi
        return 0
    fi

    local ok=false delivered=false hint=""
    [[ "$PEER_SD_RC" -eq 0 ]] && ok=true
    [[ "$PEER_SD_OUTCOME" == "sent-and-nudged" ]] && delivered=true
    case "$PEER_SD_OUTCOME" in
        sent-but-undelivered)
            hint="Message $PEER_SD_MESSAGE_ID is queued but delivery failed (${PEER_SD_DELIVER_REASON:-unknown}). Retry DELIVERY ONLY: cctrl peer deliver $to (re-running this command would duplicate the message)." ;;
        sent-but-deferred)
            hint="Message $PEER_SD_MESSAGE_ID is queued; $to's pane is busy so nothing was pasted. Retry DELIVERY ONLY once it clears: cctrl peer deliver $to (re-running this command would duplicate the message)." ;;
    esac

    local remote_host="${PEER_SD_REMOTE_HOST:-}"

    if [[ "$json" == "true" ]]; then
        jq -n \
          --argjson base "$PEER_SD_SEND_JSON" \
          --argjson ok "$ok" \
          --arg outcome "$PEER_SD_OUTCOME" \
          --argjson delivered "$delivered" \
          --arg to "$to" \
          --arg reason "$PEER_SD_DELIVER_REASON" \
          --arg hint "$hint" \
          --arg ctx "$ctx" \
          --arg ackstate "${PEER_SD_ACK_STATE:-}" \
          --arg ackerror "${PEER_SD_ACK_ERROR:-}" \
          --arg remote "$remote_host" \
          '$base
           + {ok:$ok, outcome:$outcome, delivered:$delivered, to:$to, message_id:($base.id // null)}
           + (if $remote != "" then {remote_host:$remote} else {} end)
           + (if $reason != "" then {delivery_reason:$reason} else {} end)
           + (if $hint != "" then {hint:$hint} else {} end)
           + (if $ctx == "reply" and $ackstate != "" then
               {ack: ({state:$ackstate} + (if $ackerror != "" then {error:$ackerror} else {} end))}
             else {} end)
           + (if $ctx == "reply" then
               {note:"reply-by-message-id still fails once the sender'"'"'s session is gone; addresses are tmux-session-derived until plans 028/029."}
             else {} end)'
    else
        local via=""
        [[ -n "$remote_host" ]] && via=" via $remote_host"
        case "$PEER_SD_OUTCOME" in
            sent-and-nudged)   echo -e "${GREEN}Sent and nudged $to${via}${RESET} (message $PEER_SD_MESSAGE_ID)" ;;
            sent-and-queued)   echo -e "${GREEN}Sent and queued for $to${via}${RESET} (message $PEER_SD_MESSAGE_ID; $to collects its own mail)" ;;
            sent-but-deferred) echo -e "${YELLOW}Sent but deferred${via}${RESET} (message $PEER_SD_MESSAGE_ID). $hint" >&2 ;;
            sent-but-undelivered) echo -e "${YELLOW}Sent but not delivered${via}${RESET} (message $PEER_SD_MESSAGE_ID). $hint" >&2 ;;
        esac
        if [[ "$ctx" == "reply" ]]; then
            case "${PEER_SD_ACK_STATE:-}" in
                failed) echo -e "${YELLOW}Note:${RESET} could not ack the original message: ${PEER_SD_ACK_ERROR:-unknown} (the reply was still sent)." >&2 ;;
            esac
        fi
    fi
    return 0
}

# `peer reply <message-id>` (plan 027): send a reply addressed to the referenced
# message's sender (by id, not address) and deliver it in one command. The
# recipient is inferred from the message's `sender.name` snapshot (plan 023),
# falling back to its bare `from` for messages that predate the snapshot.
_peer_cmd_reply() {
    local id="${1:-}"
    if [[ -z "$id" || "$id" == -* ]]; then
        echo -e "${RED}Usage: cctrl peer reply <message-id> [--as NAME] [--subject TEXT] [--body-file PATH|-] [--no-ack] [--json] -- <body>${RESET}" >&2
        return 64
    fi
    shift

    local as_identity="" subject="" body="" body_file="" json=false no_ack=false saw_body=false
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --as)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--as needs a peer name" || echo -e "${RED}--as needs a peer name${RESET}" >&2; return 64; }
                as_identity="$2"; shift 2 ;;
            --subject)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--subject needs a value" || echo -e "${RED}--subject needs a value${RESET}" >&2; return 64; }
                subject="$2"; shift 2 ;;
            --body-file)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--body-file needs a value" || echo -e "${RED}--body-file needs a value${RESET}" >&2; return 64; }
                body_file="$2"; shift 2 ;;
            --no-ack)
                no_ack=true; shift ;;
            --json)
                json=true; shift ;;
            --)
                shift
                body="$*"
                saw_body=true
                break ;;
            *)
                $json && _json_error "validation" "Unknown peer reply flag: $1" || echo -e "${RED}Unknown peer reply flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done

    if [[ -n "$body_file" ]]; then
        if $saw_body; then
            $json && _json_error "validation" "Use either --body-file or -- <body>, not both." || echo -e "${RED}Use either --body-file or -- <body>, not both.${RESET}" >&2
            return 64
        fi
        if [[ "$body_file" == "-" ]]; then
            if ! _read_body_file -; then
                $json && _json_error "validation" "${MAILBOX_BODY_READ_ERROR:-Failed to read body from stdin.}" || echo -e "${RED}${MAILBOX_BODY_READ_ERROR:-Failed to read body from stdin.}${RESET}" >&2
                unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
                return 64
            fi
            body="$MAILBOX_BODY"
        elif [[ -f "$body_file" ]]; then
            if ! _read_body_file "$body_file"; then
                $json && _json_error "validation" "${MAILBOX_BODY_READ_ERROR:-Failed to read body file: $body_file}" || echo -e "${RED}${MAILBOX_BODY_READ_ERROR:-Failed to read body file: $body_file}${RESET}" >&2
                unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
                return 64
            fi
            body="$MAILBOX_BODY"
        else
            $json && _json_error "validation" "Body file not found: $body_file" || echo -e "${RED}Body file not found: $body_file${RESET}" >&2
            return 64
        fi
        unset MAILBOX_BODY MAILBOX_BODY_READ_ERROR
        saw_body=true
    fi
    if ! $saw_body; then
        $json && _json_error "validation" "peer reply needs --body-file or a body after --." || echo -e "${RED}peer reply needs --body-file or a body after --.${RESET}" >&2
        return 64
    fi

    # One peer+session enumeration for read + send + deliver + ack.
    _peer_all_json_cache_begin >/dev/null 2>&1 || true

    local rc=0
    _mailbox_resolve_identity_for_mode "$as_identity" "$json" || { rc=$?; _peer_all_json_cache_end; return "$rc"; }
    local identity="$MAILBOX_RESOLVED_IDENTITY"

    _mailbox_read_json_or_error "$json" || { rc=$?; _peer_all_json_cache_end; return "$rc"; }
    local messages="$MAILBOX_MESSAGES" ref
    ref="$(jq -c --arg id "$id" '[.[] | select(.id == $id)][0] // empty' <<< "$messages")"
    if [[ -z "$ref" ]]; then
        $json && _json_error "validation" "Unknown message: $id" || echo -e "${RED}Unknown message: '$id'${RESET}" >&2
        _peer_all_json_cache_end
        return 64
    fi

    local msg_to msg_status recipient
    msg_to="$(jq -r '.to // ""' <<< "$ref")"
    if [[ "$msg_to" != "$identity" ]]; then
        $json && _json_error "validation" "Message '$id' is not addressed to '$identity'." || echo -e "${RED}Message '$id' is not addressed to '$identity'.${RESET}" >&2
        _peer_all_json_cache_end
        return 64
    fi

    msg_status="$(jq -r '.status // ""' <<< "$ref")"
    if [[ "$msg_status" == "queued" ]]; then
        $json && _json_error "validation" "Message '$id' is still queued; receive it first (cctrl peer recv --as $identity)." || echo -e "${RED}Message '$id' is still queued; receive it first (cctrl peer recv --as $identity).${RESET}" >&2
        _peer_all_json_cache_end
        return 64
    fi

    recipient="$(jq -r '.sender.name // .from // ""' <<< "$ref")"
    if [[ -z "$recipient" ]]; then
        $json && _json_error "validation" "Message '$id' has no resolvable sender to reply to." || echo -e "${RED}Message '$id' has no resolvable sender to reply to.${RESET}" >&2
        _peer_all_json_cache_end
        return 64
    fi
    if [[ "$recipient" == "user" ]]; then
        if $json; then
            _json_error "validation" "Message '$id' was sent by 'user' (the human operator), which is not an addressable peer; reply out of band."
        else
            echo -e "${RED}Message '$id' was sent by 'user' (the human operator), which is not an addressable peer.${RESET}" >&2
            echo -e "${DIM}'user' has no mailbox; reply out of band.${RESET}" >&2
        fi
        _peer_all_json_cache_end
        return 64
    fi
    if ! _peer_resolve_json "$recipient" >/dev/null 2>&1; then
        if $json; then
            _json_error "unknown-peer" "Original sender '$recipient' no longer resolves; message '$id' cannot be replied to."
        else
            echo -e "${RED}Original sender '$recipient' no longer resolves; message '$id' cannot be replied to.${RESET}" >&2
            echo -e "${DIM}Addresses are tmux-session-derived until plans 028/029; reply fails once the sender's session is gone.${RESET}" >&2
        fi
        _peer_all_json_cache_end
        return 66
    fi

    local -a extra=(--from "$identity")
    [[ -n "$subject" ]] && extra+=(--subject "$subject")
    _peer_send_and_deliver "$recipient" "$body" ${extra[@]+"${extra[@]}"} || true
    local sd_rc=$PEER_SD_RC

    # Ack the original after a successful send. An ack failure is reported but
    # never fails the reply (the reply already went out; re-running would
    # duplicate it), so exit status stays driven by the send/deliver outcome.
    PEER_SD_ACK_STATE=""
    PEER_SD_ACK_ERROR=""
    if [[ "$PEER_SD_OUTCOME" != "send-failed" ]]; then
        if $no_ack; then
            PEER_SD_ACK_STATE="skipped"
        else
            local ack_out ack_rc=0
            ack_out="$(_peer_cmd_ack "$id" --as "$identity" --json 2>/dev/null)" || ack_rc=$?
            if [[ $ack_rc -eq 0 ]]; then
                PEER_SD_ACK_STATE="acked"
            else
                PEER_SD_ACK_STATE="failed"
                PEER_SD_ACK_ERROR="$(printf '%s\n' "$ack_out" | jq -r '.error.message // empty' 2>/dev/null)"
                [[ -n "$PEER_SD_ACK_ERROR" ]] || PEER_SD_ACK_ERROR="ack failed"
            fi
        fi
    fi

    _peer_send_deliver_emit "$json" "${PEER_SD_TO:-$recipient}" reply
    _peer_all_json_cache_end
    return "$sd_rc"
}

_duration_to_seconds() {
    local value="$1" number unit
    if [[ "$value" =~ ^([0-9]+)([smhd]?)$ ]]; then
        number="${BASH_REMATCH[1]}"
        unit="${BASH_REMATCH[2]:-s}"
        case "$unit" in
            s|"") DURATION_SECONDS="$number" ;;
            m) DURATION_SECONDS=$((number * 60)) ;;
            h) DURATION_SECONDS=$((number * 60 * 60)) ;;
            d) DURATION_SECONDS=$((number * 24 * 60 * 60)) ;;
            *) return 1 ;;
        esac
        return 0
    fi
    return 1
}

_peer_now_epoch() {
    jq -nr --arg ts "$(_peer_now_utc)" '$ts | fromdateiso8601 | floor'
}

_peer_json_bool() {
    [[ "${1:-false}" == "true" ]] && printf 'true' || printf 'false'
}

_peer_backoff_state_json() {
    local messages="$1" peer="$2" fail_threshold="$3" backoff_seconds="$4" now_epoch="$5"
    jq -n \
      --argjson messages "$messages" \
      --arg peer "$peer" \
      --argjson threshold "$fail_threshold" \
      --argjson backoff "$backoff_seconds" \
      --argjson now "$now_epoch" '
        def epoch($ts): if $ts == null or $ts == "" then null else try ($ts | fromdateiso8601 | floor) catch null end;
        ([ $messages[]
          | select(.to == $peer and .status == "queued")
          | (.history // [])[]?
          | select(.event == "nudge")
          | {at, ok}
        ] | sort_by(.at) | reverse) as $events
        | ($events | reduce .[] as $event (
            {count: 0, last_failed_at: null, stopped: false};
            if .stopped then .
            elif $event.ok == false then
              .count = (.count + 1)
              | .last_failed_at = (.last_failed_at // $event.at)
            elif $event.ok == true then
              .stopped = true
            else .
            end
          )) as $state
        | (epoch($state.last_failed_at)) as $last_failed_epoch
        | {
            consecutive_failed_nudges: $state.count,
            last_failed_nudge_at: $state.last_failed_at,
            backoff_active: (
              $state.count >= $threshold
              and $last_failed_epoch != null
              and (($now - $last_failed_epoch) < $backoff)
            )
          }'
}

_peer_status_summary_json() {
    local peers_doc="$1" messages="$2" fail_threshold="$3" backoff_seconds="$4" now_epoch="$5"
    jq -n \
      --argjson doc "$peers_doc" \
      --argjson messages "$messages" \
      --argjson threshold "$fail_threshold" \
      --argjson backoff "$backoff_seconds" \
      --argjson now "$now_epoch" \
      --arg mailbox "$MESSAGES_FILE" '
        def epoch($ts): if $ts == null or $ts == "" then null else try ($ts | fromdateiso8601 | floor) catch null end;
        def transports($peer):
          ([ if (($peer.capabilities // []) | index("tmux")) then "tmux" else empty end,
             if (($peer.capabilities // []) | index("polling")) then "polling" else empty end,
             "mcp"
          ] | unique);
        def fail_state($name):
          ([ $messages[]
            | select(.to == $name and .status == "queued")
            | (.history // [])[]?
            | select(.event == "nudge")
            | {at, ok}
          ] | sort_by(.at) | reverse) as $events
          | ($events | reduce .[] as $event (
              {count: 0, last_failed_at: null, stopped: false};
              if .stopped then .
              elif $event.ok == false then
                .count = (.count + 1)
                | .last_failed_at = (.last_failed_at // $event.at)
              elif $event.ok == true then
                .stopped = true
              else .
              end
            )) as $state
          | (epoch($state.last_failed_at)) as $last_failed_epoch
          | {
              consecutive_failed_nudges: $state.count,
              last_failed_nudge_at: $state.last_failed_at,
              backoff_active: (
                $state.count >= $threshold
                and $last_failed_epoch != null
                and (($now - $last_failed_epoch) < $backoff)
              )
            };
        def peer_summary($peer):
          ($peer.name) as $name
          | ([ $messages[] | select(.to == $name and .status == "queued") ]) as $queued
          | ([ $messages[] | select(.to == $name and .status == "delivered") ]) as $delivered
          | (fail_state($name)) as $fail
          | {
              name: $name,
              source: ($peer.source // null),
              agent: ($peer.agent // null),
              host: ($peer.host // null),
              dir: ($peer.dir // null),
              session: ($peer.session // null),
              tmux_target: ($peer.tmux_target // null),
              capabilities: ($peer.capabilities // []),
              transports: transports($peer),
              queued: ($queued | length),
              delivered_unacked: ($delivered | length),
              oldest_queued_age_seconds: (
                [ $queued[] | epoch(.created_at) | select(. != null) ]
                | if length == 0 then null else ($now - min) end
              ),
              last_nudge_at: ([ $queued[] | .last_nudge_at // empty ] | max // null),
              last_nudge_error: ([ $queued[] | .last_nudge_error // empty ] | last // null),
              consecutive_failed_nudges: $fail.consecutive_failed_nudges,
              last_failed_nudge_at: $fail.last_failed_nudge_at,
              nudge_failing: $fail.backoff_active
            };
        ([ ($doc.peers // [])[] | peer_summary(.) ]) as $peers
        | {
            checked_at: (now | todateiso8601),
            mailbox: $mailbox,
            totals: {
              queued: ([ $messages[] | select(.status == "queued") ] | length),
              delivered_unacked: ([ $messages[] | select(.status == "delivered") ] | length)
            },
            transports: {
              tmux: ([ $peers[] | select((.transports | index("tmux")) != null) ] | length),
              polling: ([ $peers[] | select((.transports | index("polling")) != null) ] | length),
              mcp: ($peers | length)
            },
            nudge_failing: [ $peers[] | select(.nudge_failing) | .name ],
            peers: $peers
          }'
}

_peer_cmd_status() {
    local json=false fail_threshold=3 backoff_seconds=600 backoff_arg="10m" peers_doc messages now_epoch summary
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                json=true; shift ;;
            --fail-threshold)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--fail-threshold needs a value" || echo -e "${RED}--fail-threshold needs a value${RESET}" >&2; return 64; }
                fail_threshold="$2"; shift 2 ;;
            --backoff)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--backoff needs a duration" || echo -e "${RED}--backoff needs a duration${RESET}" >&2; return 64; }
                backoff_arg="$2"; shift 2 ;;
            *)
                $json && _json_error "validation" "Unknown peer status flag: $1" || echo -e "${RED}Unknown peer status flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    [[ "$fail_threshold" =~ ^[0-9]+$ ]] || { $json && _json_error "validation" "fail threshold must be a number" || echo -e "${RED}fail threshold must be a number${RESET}" >&2; return 64; }
    _duration_to_seconds "$backoff_arg" || { $json && _json_error "validation" "Invalid duration: $backoff_arg" || echo -e "${RED}Invalid duration: $backoff_arg${RESET}" >&2; return 64; }
    backoff_seconds="$DURATION_SECONDS"
    unset DURATION_SECONDS
    peers_doc="$(_peer_all_json)" || return 1
    _mailbox_read_json_or_error "$json" || return $?
    messages="$MAILBOX_MESSAGES"
    now_epoch="$(_peer_now_epoch)"
    summary="$(_peer_status_summary_json "$peers_doc" "$messages" "$fail_threshold" "$backoff_seconds" "$now_epoch")"
    if $json; then
        jq '.' <<< "$summary"
    else
        jq -r '
          "Queued: \(.totals.queued)",
          "Delivered unacked: \(.totals.delivered_unacked)",
          "Transports: tmux=\(.transports.tmux) polling=\(.transports.polling) mcp=\(.transports.mcp)",
          "Nudge failing: \((.nudge_failing | join(", ")) // "")",
          "",
          (.peers[] | "\(.name): queued=\(.queued) delivered=\(.delivered_unacked) transports=\(.transports | join(","))")
        ' <<< "$summary"
    fi
}

_peer_stale_recipients_json() {
    local messages="$1" older_seconds="$2" now_epoch="$3"
    jq -c --argjson older "$older_seconds" --argjson now "$now_epoch" '
        [ .[]
          | select(.status == "queued")
          | select(
              (.last_nudge_at // "") == ""
              or ((try ((.last_nudge_at | fromdateiso8601 | floor)) catch 0) as $last | ($now - $last) >= $older)
            )
          | .to
        ] | unique
    ' <<< "$messages"
}

_peer_delivered_stale_json() {
    local messages="$1" older_seconds="$2" now_epoch="$3"
    jq -c --argjson older "$older_seconds" --argjson now "$now_epoch" '
        [ .[]
          | select(.status == "delivered")
          | ((.delivered_at // .updated_at // .created_at // "") | try fromdateiso8601 catch null) as $seen
          | select($seen != null and (($now - ($seen | floor)) >= $older))
        ]
    ' <<< "$messages"
}

_peer_manual_result_json() {
    jq -n \
      --arg peer "${PEER_DELIVER_PEER:-}" \
      --arg status "${PEER_DELIVER_STATUS:-skipped}" \
      --arg reason "${PEER_DELIVER_REASON:-}" \
      --argjson queued "${PEER_DELIVER_QUEUED:-0}" \
      --argjson dry_run "${PEER_DELIVER_DRY_RUN:-false}" \
      '{peer:$peer,status:$status,queued:$queued,dry_run:$dry_run}
       + (if $reason != "" then {reason:$reason} else {} end)'
}

_peer_orchestrate_recipients_locked() {
    local messages="$1" recipients_json="$2" dry_run="$3" no_submit="$4" force_busy="$5" respect_backoff="$6" fail_threshold="$7" backoff_seconds="$8" polling_skip="$9"
    local results="[]" result target peer_json state now_epoch queued rc=0
    now_epoch="$(_peer_now_epoch)"
    while IFS= read -r target; do
        [[ -n "$target" ]] || continue
        if ! peer_json="$(_peer_resolve_json "$target" 2>/dev/null)"; then
            PEER_DELIVER_PEER="$target"
            PEER_DELIVER_STATUS="skipped"
            PEER_DELIVER_REASON="unknown-peer"
            PEER_DELIVER_QUEUED="$(jq -r --arg peer "$target" '[.[] | select(.to == $peer and .status == "queued")] | length' <<< "$messages")"
            PEER_DELIVER_DRY_RUN="$dry_run"
            result="$(_peer_manual_result_json)"
        else
            target="$(jq -r '.name' <<< "$peer_json")"
            queued="$(jq -r --arg peer "$target" '[.[] | select(.to == $peer and .status == "queued")] | length' <<< "$messages")"
            if [[ "$polling_skip" == "true" ]] && ! _peer_has_capability "$peer_json" "tmux"; then
                PEER_DELIVER_PEER="$target"
                PEER_DELIVER_STATUS="polling"
                PEER_DELIVER_REASON="no-tmux-capability"
                PEER_DELIVER_QUEUED="$queued"
                PEER_DELIVER_DRY_RUN="$dry_run"
                result="$(_peer_manual_result_json)"
            elif [[ "$respect_backoff" == "true" ]]; then
                state="$(_peer_backoff_state_json "$messages" "$target" "$fail_threshold" "$backoff_seconds" "$now_epoch")"
                if [[ "$(jq -r '.backoff_active' <<< "$state")" == "true" ]]; then
                    PEER_DELIVER_PEER="$target"
                    PEER_DELIVER_STATUS="backoff"
                    PEER_DELIVER_REASON="consecutive nudge failures: $(jq -r '.consecutive_failed_nudges' <<< "$state")"
                    PEER_DELIVER_QUEUED="$queued"
                    PEER_DELIVER_DRY_RUN="$dry_run"
                    result="$(_peer_manual_result_json)"
                else
                    result="$(_peer_deliver_one_locked "$peer_json" "$messages" "$dry_run" true "$no_submit" "$force_busy" "")" || rc=1
                    messages="$(_mailbox_read_json)"
                fi
            else
                result="$(_peer_deliver_one_locked "$peer_json" "$messages" "$dry_run" true "$no_submit" "$force_busy" "")" || rc=1
                messages="$(_mailbox_read_json)"
            fi
        fi
        results="$(jq --argjson r "$result" '. + [$r]' <<< "$results")"
    done < <(jq -r '.[]' <<< "$recipients_json")
    PEER_ORCH_RESULTS="$results"
    PEER_ORCH_MESSAGES="$messages"
    PEER_ORCH_RC="$rc"
}

_peer_cmd_nudge() {
    local target="" stale=false older_arg="15m" older_seconds=900 dry_run=false json=false no_submit=false force_busy=false target_peer_json=""
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --stale)
                stale=true; shift ;;
            --older-than)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--older-than needs a duration" || echo -e "${RED}--older-than needs a duration${RESET}" >&2; return 64; }
                older_arg="$2"; shift 2 ;;
            --dry-run)
                dry_run=true; shift ;;
            --json)
                json=true; shift ;;
            --no-submit)
                no_submit=true; shift ;;
            --force-busy)
                force_busy=true; shift ;;
            -*)
                $json && _json_error "validation" "Unknown peer nudge flag: $1" || echo -e "${RED}Unknown peer nudge flag: $1${RESET}" >&2
                return 64 ;;
            *)
                if [[ -n "$target" ]]; then
                    $json && _json_error "validation" "Only one peer target is allowed" || echo -e "${RED}Only one peer target is allowed.${RESET}" >&2
                    return 64
                fi
                target="$1"; shift ;;
        esac
    done
    if [[ -z "$target" && "$stale" != "true" ]]; then
        $json && _json_error "validation" "Usage: cctrl peer nudge <peer>|--stale [--older-than 15m]" || echo -e "${RED}Usage: cctrl peer nudge <peer>|--stale [--older-than 15m]${RESET}" >&2
        return 64
    fi
    _duration_to_seconds "$older_arg" || { $json && _json_error "validation" "Invalid duration: $older_arg" || echo -e "${RED}Invalid duration: $older_arg${RESET}" >&2; return 64; }
    older_seconds="$DURATION_SECONDS"
    unset DURATION_SECONDS
    if [[ -n "$target" ]]; then
        if ! target_peer_json="$(_peer_resolve_json "$target" 2>/dev/null)"; then
            $json && _json_error "unknown-peer" "Unknown peer: $target" || _mailbox_require_peer "peer" "$target" false
            return 66
        fi
        target="$(jq -r '.name' <<< "$target_peer_json")"
    fi

    local messages recipients delivered results rc=0 lock_rc=0 now_epoch json_ok=true
    now_epoch="$(_peer_now_epoch)"
    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_read_json_or_error "$json" || lock_rc=$?
        if [[ $lock_rc -eq 0 ]]; then
            messages="$MAILBOX_MESSAGES"
            if [[ "$stale" == "true" ]]; then
                recipients="$(_peer_stale_recipients_json "$messages" "$older_seconds" "$now_epoch")"
                if [[ -n "$target" ]]; then
                    recipients="$(jq -c --arg t "$target" '[ .[] | select(. == $t) ]' <<< "$recipients")"
                fi
            else
                recipients="$(jq -cn --arg t "$target" '[$t]')"
            fi
            delivered="$(_peer_delivered_stale_json "$messages" "$older_seconds" "$now_epoch")"
            _peer_orchestrate_recipients_locked "$messages" "$recipients" "$dry_run" "$no_submit" "$force_busy" false 3 600 false
            results="$PEER_ORCH_RESULTS"
            messages="$PEER_ORCH_MESSAGES"
            rc="$PEER_ORCH_RC"
            unset PEER_ORCH_RESULTS PEER_ORCH_MESSAGES PEER_ORCH_RC
        else
            rc=$lock_rc
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 66 ]] && return 66
    [[ $rc -eq 65 ]] && return 65
    [[ $rc -ne 0 ]] && json_ok=false
    if $json; then
        jq -n --argjson ok "$json_ok" --argjson results "${results:-[]}" --argjson delivered "${delivered:-[]}" --argjson older "$older_seconds" \
            '{ok:$ok,older_than_seconds:$older,results:$results,delivered_unacked_stale:$delivered}'
    else
        jq -c '.[]' <<< "${results:-[]}" | while IFS= read -r result; do
            _peer_print_delivery_human "$result"
        done
        if [[ "$(jq -r 'length' <<< "${delivered:-[]}")" != "0" ]]; then
            echo -e "${YELLOW}Delivered but unacked messages past threshold:${RESET}"
            jq '.' <<< "$delivered" | _mailbox_print_messages_human
        fi
    fi
    return $rc
}

_watch_lock_path() {
    printf '%s/watch.lock.d' "$PEER_DATA_DIR"
}

_watch_lock_acquire() {
    mkdir -p "$PEER_DATA_DIR"
    local lock_path pid
    lock_path="$(_watch_lock_path)"
    if mkdir "$lock_path" 2>/dev/null; then
        printf '%s\n' "$$" > "$lock_path/pid"
        date -u +"%Y-%m-%dT%H:%M:%SZ" > "$lock_path/created_at" 2>/dev/null || true
        WATCH_LOCK_HELD="$lock_path"
        return 0
    fi
    if [[ -f "$lock_path/pid" ]]; then
        pid="$(cat "$lock_path/pid" 2>/dev/null || true)"
        if _pid_alive "$pid"; then
            WATCH_LOCK_PID="$pid"
            return 2
        fi
    fi
    rm -rf "$lock_path" 2>/dev/null || true
    if mkdir "$lock_path" 2>/dev/null; then
        printf '%s\n' "$$" > "$lock_path/pid"
        date -u +"%Y-%m-%dT%H:%M:%SZ" > "$lock_path/created_at" 2>/dev/null || true
        WATCH_LOCK_HELD="$lock_path"
        return 0
    fi
    WATCH_LOCK_PID="unknown"
    return 2
}

_watch_lock_release() {
    [[ -n "${WATCH_LOCK_HELD:-}" ]] || return 0
    rm -rf "$WATCH_LOCK_HELD" 2>/dev/null || true
    unset WATCH_LOCK_HELD
}

_peer_watch_pass() {
    local pass="$1" renudge_seconds="$2" backoff_seconds="$3" fail_threshold="$4" dry_run="$5" force_busy="$6"
    local messages recipients delivered results rc=0 lock_rc=0 now_epoch summary
    now_epoch="$(_peer_now_epoch)"
    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_read_json_or_error true || lock_rc=$?
        if [[ $lock_rc -eq 0 ]]; then
            messages="$MAILBOX_MESSAGES"
            recipients="$(_peer_stale_recipients_json "$messages" "$renudge_seconds" "$now_epoch")"
            delivered="$(_peer_delivered_stale_json "$messages" "$renudge_seconds" "$now_epoch")"
            _peer_orchestrate_recipients_locked "$messages" "$recipients" "$dry_run" false "$force_busy" true "$fail_threshold" "$backoff_seconds" true
            results="$PEER_ORCH_RESULTS"
            messages="$PEER_ORCH_MESSAGES"
            rc="$PEER_ORCH_RC"
            unset PEER_ORCH_RESULTS PEER_ORCH_MESSAGES PEER_ORCH_RC
        else
            rc=$lock_rc
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -ne 0 ]] && PEER_WATCH_OK=false || PEER_WATCH_OK=true
    summary="$(jq -n \
        --argjson pass "$pass" \
        --arg checked_at "$(_peer_now_utc)" \
        --argjson ok "$(_peer_json_bool "$PEER_WATCH_OK")" \
        --argjson dry_run "$(_peer_json_bool "$dry_run")" \
        --argjson results "${results:-[]}" \
        --argjson delivered "${delivered:-[]}" \
        '{ok:$ok,pass:$pass,checked_at:$checked_at,dry_run:$dry_run,results:$results,delivered_unacked_stale:$delivered}')"
    PEER_WATCH_PASS="$summary"
    return $rc
}

_peer_cmd_watch() {
    local once=false force=false interval="" max_passes="" renudge_arg="15m" backoff_arg="10m" dry_run=false json=false force_busy=false fail_threshold=3
    local renudge_seconds=900 backoff_seconds=600 pass=0 lock_rc rc=0 summary
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --once)
                once=true; shift ;;
            --force)
                force=true; shift ;;
            --interval)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--interval needs seconds" || echo -e "${RED}--interval needs seconds${RESET}" >&2; return 64; }
                interval="$2"; shift 2 ;;
            --max-passes)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--max-passes needs a number" || echo -e "${RED}--max-passes needs a number${RESET}" >&2; return 64; }
                max_passes="$2"; shift 2 ;;
            --renudge-after)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--renudge-after needs a duration" || echo -e "${RED}--renudge-after needs a duration${RESET}" >&2; return 64; }
                renudge_arg="$2"; shift 2 ;;
            --backoff)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--backoff needs a duration" || echo -e "${RED}--backoff needs a duration${RESET}" >&2; return 64; }
                backoff_arg="$2"; shift 2 ;;
            --fail-threshold)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--fail-threshold needs a number" || echo -e "${RED}--fail-threshold needs a number${RESET}" >&2; return 64; }
                fail_threshold="$2"; shift 2 ;;
            --dry-run)
                dry_run=true; shift ;;
            --json)
                json=true; shift ;;
            --force-busy)
                force_busy=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer watch flag: $1" || echo -e "${RED}Unknown peer watch flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    [[ -z "$interval" || "$interval" =~ ^[0-9]+$ ]] || { $json && _json_error "validation" "interval must be seconds" || echo -e "${RED}interval must be seconds${RESET}" >&2; return 64; }
    [[ -z "$interval" || "$interval" -gt 0 ]] || { $json && _json_error "validation" "interval must be positive" || echo -e "${RED}interval must be positive${RESET}" >&2; return 64; }
    [[ -z "$max_passes" || "$max_passes" =~ ^[0-9]+$ ]] || { $json && _json_error "validation" "max-passes must be a number" || echo -e "${RED}max-passes must be a number${RESET}" >&2; return 64; }
    [[ "$fail_threshold" =~ ^[0-9]+$ ]] || { $json && _json_error "validation" "fail threshold must be a number" || echo -e "${RED}fail threshold must be a number${RESET}" >&2; return 64; }
    _duration_to_seconds "$renudge_arg" || { $json && _json_error "validation" "Invalid duration: $renudge_arg" || echo -e "${RED}Invalid duration: $renudge_arg${RESET}" >&2; return 64; }
    renudge_seconds="$DURATION_SECONDS"
    _duration_to_seconds "$backoff_arg" || { $json && _json_error "validation" "Invalid duration: $backoff_arg" || echo -e "${RED}Invalid duration: $backoff_arg${RESET}" >&2; return 64; }
    backoff_seconds="$DURATION_SECONDS"
    unset DURATION_SECONDS
    if [[ "$once" != "true" && -z "$interval" ]]; then
        once=true
    fi
    if [[ "$force" == "true" && "$once" != "true" ]]; then
        $json && _json_error "validation" "--force is only valid with --once" || echo -e "${RED}--force is only valid with --once${RESET}" >&2
        return 64
    fi
    if [[ ! ( "$force" == "true" && "$once" == "true" ) ]]; then
        if _watch_lock_acquire; then
            lock_rc=0
        else
            lock_rc=$?
        fi
        if [[ $lock_rc -eq 2 ]]; then
            echo "already running (pid ${WATCH_LOCK_PID:-unknown})" >&2
            return 1
        elif [[ $lock_rc -ne 0 ]]; then
            echo "could not acquire watch lock" >&2
            return 1
        fi
        trap '_watch_lock_release' INT TERM EXIT
    fi
    while true; do
        pass=$((pass + 1))
        _peer_watch_pass "$pass" "$renudge_seconds" "$backoff_seconds" "$fail_threshold" "$dry_run" "$force_busy" || rc=1
        summary="$PEER_WATCH_PASS"
        unset PEER_WATCH_PASS
        if $json; then
            if $once; then jq '.' <<< "$summary"; else jq -c '.' <<< "$summary"; fi
        else
            jq -c '.results[]?' <<< "$summary" | while IFS= read -r result; do
                _peer_print_delivery_human "$result"
            done
        fi
        if $once; then
            break
        fi
        if [[ -n "$max_passes" && "$pass" -ge "$max_passes" ]]; then
            break
        fi
        sleep "$interval"
    done
    _watch_lock_release
    trap - INT TERM EXIT
    return $rc
}

_peer_cmd_gc() {
    local older_arg="" older_seconds=0 status_csv="acked" dry_run=false json=false archive_file="$PEER_DATA_DIR/messages-archive.jsonl"
    _arg_has_json "$@" && json=true
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --older-than)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--older-than needs a duration" || echo -e "${RED}--older-than needs a duration${RESET}" >&2; return 64; }
                older_arg="$2"; shift 2 ;;
            --status)
                [[ $# -ge 2 ]] || { $json && _json_error "validation" "--status needs a value" || echo -e "${RED}--status needs a value${RESET}" >&2; return 64; }
                status_csv="$2"; shift 2 ;;
            --dry-run)
                dry_run=true; shift ;;
            --json)
                json=true; shift ;;
            *)
                $json && _json_error "validation" "Unknown peer gc flag: $1" || echo -e "${RED}Unknown peer gc flag: $1${RESET}" >&2
                return 64 ;;
        esac
    done
    [[ -n "$older_arg" ]] || { $json && _json_error "validation" "--older-than is required" || echo -e "${RED}--older-than is required${RESET}" >&2; return 64; }
    _duration_to_seconds "$older_arg" || { $json && _json_error "validation" "Invalid duration: $older_arg" || echo -e "${RED}Invalid duration: $older_arg${RESET}" >&2; return 64; }
    older_seconds="$DURATION_SECONDS"
    unset DURATION_SECONDS
    local statuses messages eligible remaining now_epoch count rc=0 lock_rc=0 error=""
    statuses="$(_mailbox_status_filter_json "$status_csv" "")"
    now_epoch="$(_peer_now_epoch)"
    _mailbox_lock_acquire || return 1
    if ! {
        _mailbox_read_json_or_error "$json" || lock_rc=$?
        if [[ $lock_rc -eq 0 ]]; then
            messages="$MAILBOX_MESSAGES"
            eligible="$(jq -c --argjson statuses "$statuses" --argjson now "$now_epoch" --argjson older "$older_seconds" '
                [ .[]
                  | .status as $status
                  | ((.acked_at // .delivered_at // .updated_at // .created_at // "") | try fromdateiso8601 catch null) as $seen
                  | select(($statuses | index($status)) and $seen != null and (($now - ($seen | floor)) >= $older))
                ]
            ' <<< "$messages")"
            count="$(jq -r 'length' <<< "$eligible")"
            if [[ "$dry_run" != "true" && "$count" -gt 0 ]]; then
                mkdir -p "$(dirname "$archive_file")"
                if ! { jq -c '.[]' <<< "$eligible" >> "$archive_file"; } 2>/dev/null; then
                    error="failed to append archive: $archive_file"
                    rc=1
                else
                    remaining="$(jq -c --argjson statuses "$statuses" --argjson now "$now_epoch" --argjson older "$older_seconds" '
                        [ .[]
                          | .status as $status
                          | ((.acked_at // .delivered_at // .updated_at // .created_at // "") | try fromdateiso8601 catch null) as $seen
                          | select((($statuses | index($status)) and $seen != null and (($now - ($seen | floor)) >= $older)) | not)
                        ]
                    ' <<< "$messages")"
                    if ! _mailbox_rewrite_json_locked "$remaining"; then
                        error="failed to rewrite mailbox: $MESSAGES_FILE"
                        rc=1
                    fi
                fi
            fi
        else
            rc=$lock_rc
        fi
    }; then
        rc=1
    fi
    _mailbox_lock_release
    [[ $rc -eq 65 ]] && return 65
    if $json; then
        jq -n --argjson ok "$(_peer_json_bool "$([[ $rc -eq 0 ]] && echo true || echo false)")" --arg error "$error" --argjson dry_run "$(_peer_json_bool "$dry_run")" --argjson older "$older_seconds" --argjson statuses "$statuses" --arg archive "$archive_file" --argjson eligible "${eligible:-[]}" \
            '{ok:$ok,dry_run:$dry_run,older_than_seconds:$older,statuses:$statuses,archive:$archive,eligible_count:($eligible|length),eligible:$eligible}
             + (if $ok then {} else {error:$error} end)'
    else
        if [[ $rc -ne 0 ]]; then
            echo -e "${RED}${error:-peer gc failed}${RESET}" >&2
        else
            echo "Eligible messages: ${count:-0}"
        fi
        if [[ "$dry_run" != "true" && $rc -eq 0 ]]; then
            echo "Archive: $archive_file"
        fi
    fi
    return $rc
}

_peer_doctor_mcp_check() {
    local peer="$1" out
    out="$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{}}' | "$SCRIPT_DIR/cctrl" peer mcp --as "$peer" 2>/dev/null || true)"
    if jq -e 'select(.id == 1 and .result.capabilities.tools != null)' <<< "$out" >/dev/null 2>&1; then
        printf 'true'
