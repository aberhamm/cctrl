try:
    with open(path) as f:
        cfg = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    cfg = {}

hooks = cfg.setdefault('hooks', {})

# PreToolUse: replace any cctrl-sourced entry, preserve others
new_ptu = []
for entry in hooks.get('PreToolUse', []):
    cmds = [h.get('command', '') for h in entry.get('hooks', [])]
    if any('block-git-commit' in c or 'cctrl hooks run pre-tool-use' in c for c in cmds):
        continue
    new_ptu.append(entry)
new_ptu.append({
    'matcher': 'Bash',
    'hooks': [{'type': 'command', 'command': 'cctrl hooks run pre-tool-use'}]
})
hooks['PreToolUse'] = new_ptu

# Stop: replace cctrl-sourced entry, preserve others (e.g. gstack)
new_stop = []
for entry in hooks.get('Stop', []):
    cmds = [h.get('command', '') for h in entry.get('hooks', [])]
    if any('notify.sh' in c or 'session-log' in c or 'cctrl hooks run stop' in c for c in cmds):
        if not entry.get('_gstack_source'):
            continue
    new_stop.append(entry)
new_stop.insert(0, {
    'hooks': [{'type': 'command', 'command': 'cctrl hooks run stop'}]
})
hooks['Stop'] = new_stop

# Notification: replace cctrl-sourced entry, preserve others
new_notif = []
for entry in hooks.get('Notification', []):
    cmds = [h.get('command', '') for h in entry.get('hooks', [])]
    if any('notify.sh' in c or 'cctrl hooks run notify' in c for c in cmds):
        continue
    new_notif.append(entry)
new_notif.append({
    'hooks': [{'type': 'command', 'command': 'cctrl hooks run notify'}]
})
hooks['Notification'] = new_notif

with open(path, 'w') as f:
    json.dump(cfg, f, indent=2)
    f.write('\n')
" 2>&1; then
            echo -e "${GREEN}✓${RESET} Claude Code hooks installed → $claude_settings"
        else
            echo -e "${RED}✗${RESET} Failed to update Claude Code hooks" >&2
            errors=1
        fi
    else
        echo -e "${DIM}Skipping Claude Code — ~/.claude/ not found${RESET}"
    fi

    # --- Codex ---
    local codex_dir="${CODEX_HOME:-$HOME/.codex}"
    local codex_hooks="$codex_dir/hooks.json"
    if [[ -d "$codex_dir" ]]; then
        local codex_result codex_backup
        if codex_result="$(python3 "$SCRIPT_DIR/hooks/codex-hook-config.py" "$codex_hooks" 2>&1)"; then
            echo -e "${GREEN}✓${RESET} Codex hooks installed → $codex_hooks"
            codex_backup="${codex_result#*$'\t'}"
            if [[ "$codex_result" == changed$'\t'* && "$codex_backup" != "-" ]]; then
                echo -e "${DIM}  Exact pre-replace backup: $codex_backup${RESET}"
            fi
        else
            echo -e "${RED}✗${RESET} Failed to update Codex hooks" >&2
            echo -e "${DIM}$codex_result${RESET}" >&2
            echo -e "${DIM}Repair the reported file or restore its same-directory cctrl backup, then retry.${RESET}" >&2
            errors=1
        fi
    else
        echo -e "${DIM}Skipping Codex — ~/.codex/ not found${RESET}"
    fi

    if [[ $errors -eq 0 ]]; then
        echo ""
        echo -e "${GREEN}Done.${RESET} Verify with: ${DIM}cctrl hooks doctor${RESET}"
    fi
    return $errors
}

_codex_hooks_trust_report() {
    local hooks_path="$1"
    python3 - "$SCRIPT_DIR/lib/codex_app_server.py" "$hooks_path" "${CCTRL_CODEX_HOOKS_LIST_JSON:-}" <<'PY'
import importlib.util
import json
import os
import sys

adapter_path, hooks_path, fixture_path = sys.argv[1:4]
commands = [
    "cctrl hooks run pre-tool-use",
    "cctrl hooks run stop",
    "cctrl hooks run notify",
    "cctrl hooks run codex-observe",
]

try:
    if fixture_path:
        with open(fixture_path, encoding="utf-8") as stream:
            response = json.load(stream)
    else:
        spec = importlib.util.spec_from_file_location("cctrl_codex_app_server", adapter_path)
        module = importlib.util.module_from_spec(spec)
        sys.modules[spec.name] = module
        spec.loader.exec_module(module)
        timeouts = module.Timeouts(connect=2.0, handshake=2.0, request=2.0, inactivity=2.0, terminate=0.25)
        runtime = module.discover_runtime(os.environ.get("CCTRL_CODEX_BIN"), validation_timeout=2.0)
        with module.AppServerClient(
            runtime,
            socket_path=os.environ.get("CCTRL_CODEX_APP_SERVER_SOCKET") or None,
            timeouts=timeouts,
        ) as client:
            client.initialize()
            response = client.request("hooks/list", {"cwds": [os.getcwd()]})
except Exception:
    response = {}

statuses = {command: [] for command in commands}
expected_path = os.path.realpath(hooks_path)
for entry in response.get("data", []) if isinstance(response, dict) else []:
    for hook in entry.get("hooks", []) if isinstance(entry, dict) else []:
        if not isinstance(hook, dict):
            continue
        command = hook.get("command")
        source_path = hook.get("sourcePath")
        if command not in statuses or not isinstance(source_path, str):
            continue
        if os.path.realpath(source_path) != expected_path:
            continue
        statuses[command].append(hook.get("trustStatus"))

for command in commands:
    values = statuses[command]
    if values and all(value in ("trusted", "managed") for value in values):
        state = "trusted"
    elif any(value in ("untrusted", "modified") for value in values):
        state = "untrusted"
    else:
        state = "unknown"
    print(f"{command}\t{state}")
PY
}

